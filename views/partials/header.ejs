


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Document</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  
<style>
  .header {
    background: rgb(232, 235, 240);
    font-size: large !important;
  }

  .product-search-bar input {
    width: 150px;
  }

  @media (min-width: 576px) {
    .product-search-bar input {
      width: 250px;
    }
  }

  @media (max-width: 768px) {
    .product-search-bar {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.5rem;
    }

    .product-search-bar input,
    .product-search-bar button {
      width: 100%;
      margin-bottom: 0.5rem;
    }

    .product-search-bar button:last-child {
      margin-bottom: 0;
    }
  }
</style>

<nav class="navbar header navbar-expand-lg navbar-light">
  <div class="container-fluid">
    <h2 class="navbar-brand text-dark fw-bold"><%= title %></h2>

    <!-- Toggler -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible content -->
    <div class="collapse navbar-collapse" id="navbarContent">

      <!-- Search bar -->
      <div class="product-search-bar bg-white d-flex align-items-center ms-lg-5 my-2 my-lg-0 p-1 rounded">
        <input type="text" id="searchInput" class="form-control" placeholder="Search" value="<%= typeof query !== 'undefined' ? query : '' %>">

        <button class="searchbtn btn btn-white mx-1" id="searchbtn" onclick="searchProducts()">🔍</button>
        <button class="clearbtn btn btn-white" id="clearbtn" onclick="clearSearch()">✖</button>
      </div>

      <!-- Logout Button -->
      <div class="ms-lg-auto mt-2 mt-lg-0">
        <button id="logoutBtn" type="button" class="btn btn-danger">Logout</button>
      </div>
    </div>
  </div>
</nav>


  <script src="/js/management.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
  
   function clearSearch(){
    document.getElementById('searchInput').value=''
    searchProducts()
   }
    async function searchProducts() {
    const query = document.getElementById('searchInput').value;
    console.log('query is '+query);
    const currentPage =window.location.pathname.split('/').pop()
    console.log('current page is '+currentPage);
    
    let searchType='products'
    if(currentPage.includes('users')){
      searchType='users'
    }
    if(currentPage.includes('category')){
      searchType='category'
    }
   if(searchType=='products'){
    window.location.href=`/product/products?query=${query}`
   }else if(searchType=='category'){
    window.location.href=`/admin/category?query=${query}`
   }else if(searchType=='users') {
    window.location.href=`/admin/users?query=${query}`
   }else{
    Swal.fire('Invalid search types')
   }
   }

    const logoutBtn=document.getElementById('logoutBtn')
    logoutBtn.addEventListener("click",function(){
      console.log('admin logout button clicked');
      
      fetch('/admin/logout',{method:"POST",
    
      })
      .then(res=>res.json())
      .then(data=>{
        if(data.success){
          Swal.fire(data.message).then(()=>{
            window.location.href='/admin/login'
          })
        }
      }).catch(error=>{
        console.log('error ',error);
        
        Swal.fire("Something went wrong")
      })
    })
  
  </script>

  
</body>
</html>

  