<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Orders | Aura Threads</title>
    <link rel="stylesheet" href="/css/userOrders.css">
    
</head>
<body>
    <div class="site-wrap">
        <%- include('../partials/userHeader') %>

        <div class="container">
            <h2  class="order-title">My Orders</h2>
            
            <!-- <div class="search-filter">
                <div class="search-bar">
                    <input type="text" placeholder="Search orders...">
                    <button>Search</button>
                </div>
                <select class="filter-dropdown">
                    <option value="all">All Orders</option>
                    <option value="processing">Processing</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="shipped">Shipped</option>
                    <option value="delivered">Delivered</option>
                    <option value="cancelled">Cancelled</option>
                </select>
            </div> -->
            
            <table class="orders-table">
                <thead>
                    <tr style="background-color: #cbb6ac;">
                        <th>Order No.</th>
                        <th>Order ID</th>
                        <th>Order Date</th>
                        <th>Delivery date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach((order,index )=> { %>
                        <tr>
                            <td style="color: black;" class="order-No"><%= index+1 %></td>
                            <td style="color: black;" class="order-id">ORD<%= order._id.toString().slice(-6).toUpperCase() %></td>
                            
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 4px; color: green;">
                                   
                                   
                                    <div> <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></div>
                                    <% if (order.estimatedDelivery) { %>
                                        <div><strong>Est. Delivery:</strong> <%= new Date(order.estimatedDelivery).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></div>
                                    <% } %>
                                </div>
                            </td>
            
                            <td><%= new Date(order.deliveryDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></td>
                            
                            <td style="color: red;"> ₹ <%= order.finalAmount.toFixed(2) %></td>
                            
                            <td>
                                <span class="status-badge status-<%= order.status.toLowerCase() %>">
                                    <%= order.status %>
                                </span>
                            </td>
                            
                            <td>
                                <div class="action-btns" style="display: flex; flex-direction: row; gap: 6px; flex-wrap: wrap;">
                                  <button onclick="displayOrderDetails('<%= order._id %>?source=all')" class="btn btn-sm bg-success text-white btn-details">Details</button>
                              
                                  <% if (order.status === 'cancelled') { %>
                                    <button class="btn btn-sm btn-secondary" disabled>Cancelled</button>
                                  <% }else if (order.status === 'returned') { %>
                                    <button  class="btn btn-sm text-danger btn-cancel" disabled>Returned</button>
                                  <% } else if (order.status === 'Processing') { %>
                                    <button onclick="cancelOrder('<%= order._id %>', this)" class="btn btn-sm bg-danger text-white btn-cancel">Cancel</button>
                                  <% } else if (order.status === 'Shipped' || order.status === 'Delivered') { %>
                                    <!-- <button class="btn btn-sm btn-track">Track</button> -->
                                    <button class="btn btn-sm btn-cancel btn-disabled" disabled>Delivered</button>
                                  <% } else { %>
                                    <button onclick="cancelOrder('<%= order._id %>', this)" class="btn btn-sm bg-danger text-white btn-cancel">Cancel</button>
                                  <% } %>
                                </div>
                              </td>
                              
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            
            
            
            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center">
                  <!-- Previous Button -->
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
                    </li>
                    <% } else { %>
                      <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1">Previous</a>
                      </li>
                      <% } %>
            
                        <!-- Page Numbers -->
                        <% for (let i=1; i <=totalPages; i++) { %>
                          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= i %>&limit=5">
                              <%= i %>
                            </a>
                          </li>
                          <% } %>
            
                            <!-- Next Button -->
                            <% if (currentPage < totalPages) { %>
                              <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
                              </li>
                              <% } else { %>
                                <li class="page-item disabled">
                                  <a class="page-link" href="#">Next</a>
                                </li>
                                <% } %>
                </ul>
              </nav>
            <!-- Empty state (hidden by default, show when no orders) -->
            <div class="empty-state" style="display: none;">
                <h3>No Orders Found</h3>
                <p>You haven't placed any orders yet. Start shopping to see your orders here.</p>
            </div>
        </div>
        <%- include('../partials/userFooter') %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
       
        function displayOrderDetails(orderIdWithQuery){
            console.log('from user display order details scrit');
            window.location.href=`/user/order-details/${orderIdWithQuery}`
        }
        function cancelOrder(orderId, btn) {
    console.log(' Function called: cancelOrder');
    console.log(' Order ID:', orderId);
    console.log(' Button element:', btn);

    Swal.fire({
        title: "Are you sure to cancel this order?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, cancel it!"
    }).then((result) => {
        console.log(' Swal result:', result);
        if (result.isConfirmed) {
            console.log(' Confirmed. Sending DELETE request...');

            fetch(`/user/cancel-order/${orderId}`, {
                method: "DELETE",
               
            })
            .then(res => {
                return res.json();
            })
            .then(data => {
                if (data && data.success) {
                    console.log(' Cancellation successful');
                    
                  Swal.fire({
                icon: "success",
                title: "Order Cancelled",
                showConfirmButton: false,
                timer: 1000
              })

                    if (btn) {
                        btn.disabled = true;
                        btn.innerText = "Cancelled";
                        btn.classList.remove('bg-danger', 'text-white');
                        btn.classList.add('btn-secondary');
                        console.log(' Button disabled and updated');
                    } else {
                        console.warn(' Button element is undefined or not passed');
                    }
                } else {
                    console.error(' Cancellation failed:', data.message);
                    Swal.fire(data.message || "Failed to cancel order.");
                }
            })
            .catch(err => {
                console.error(' Fetch error:', err);
                Swal.fire("Something went wrong.");
            });
        } 
    });
}
