<!DOCTYPE html>
<html lang="en">

<head>
  <title>Aura Threads &mdash; User Cart</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Mukta:300,400,700">
  <link rel="stylesheet" href="/fonts/icomoon/style.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/magnific-popup.css">
  <link rel="stylesheet" href="/css/jquery-ui.css">
  <link rel="stylesheet" href="/css/owl.carousel.min.css">
  <link rel="stylesheet" href="/css/owl.theme.default.min.css">


  <link rel="stylesheet" href="/css/aos.css">

  <link rel="stylesheet" href="/css/style.css">

</head>

<body>

  <div class="site-wrap">
    <%- include('../partials/userHeader') %>

      <div class="bg-light py-3">
        <div class="container">
          <div class="row">
            <div class="col-md-12 mb-0">
              <a href="/user/home">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Cart</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="site-section">
        <div class="container">
          <h4 class="text text-center text-success mt-4">
            <%= title %>
          </h4>
          <div class="row mb-5">

            <form class="col-md-12" method="post" action="/cart/update">
              <div class="site-blocks-table">
                <table class="table mt-4 table-bordered">
                  <thead>
                    <tr>
                      <th class="product-thumbnail">Image</th>
                      <th class="product-name">Product</th>
                      <th class="product-price">Price</th>
                      <th class="product-discount">Offer per quantity</th>
                      <th>Final Price</th>
                      <th class="product-quantity">Quantity</th>
                      <th class="product-total">Total</th>
                      <th class="product-remove">Remove</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (cart.items.length> 0) { %>
                      <% cart.items.forEach(item=> { %>
                        <tr id="row-<%= item.productId._id %>">
                          <td class="product-thumbnail">
                            <a href="/user/products/<%= item.productId._id %>"><img  src="<%= item.productId.images[0] %>" alt="Image" class="img-fluid"></a>
                          </td>
                          <td class="product-name">
                            <h2 class="h5 text-black">
                              <%= item.productId.productName %>
                            </h2>
                          </td>
                          <td style="font-weight: bold;">₹ <%= item.productId.price.toFixed(2) %>
                          </td>
                          <td>
                            <% if(item.discountAmount) { %>
                              <span style="font-weight: bold;color: green;">
                                <%= item.discountType==='amount' ? `₹${item.discountAmount.toFixed(2)} off` :
                                  `${(item.discountAmount * 100 / item.productId.price).toFixed(0)}% off` %>
                              </span>
                              <% } else { %>
                                <span style="font-weight: bold;color: red;">No Offer</span>
                                <% } %>
                          </td>
                          <td style="font-weight: bold;color: green;">₹ <%= (item.productId.price-item.discountAmount) %></td>
                          <td>
                            <div class="input-group mb-3" style="max-width: 120px;">
                              <div class="input-group-prepend">
                                <div class="input-group-append">
                                  <div class="input-group-append">
                                    <button class="btn btn-outline-primary js-btn-minus"
                                      data-productId="<%= item.productId._id %>"   data-finalPrice="<%= (item.productId.price-item.discountAmount) %>" data-id="<%= item.quantity %>"
                                      type="button">&minus;</button>
                                  </div>
                                  <input type="text" id="quantity" class="form-control text-center"
                                    value="<%= item.quantity %>" name="quantity-<%= item.id %>">
                                  <div class="input-group-append">
                                    <button class="btn btn-outline-primary js-btn-plus"
                                      data-productId="<%= item.productId._id %>" data-finalPrice="<%= (item.productId.price-item.discountAmount) %>" data-max="<%= item.productId.stock %>"
                                      data-id="<%= item.quantity %>" type="button">&plus;</button>
                                  </div>
                                </div>
                          </td>
                          <td  style="font-weight: bold;">₹ <span id="col-<%= item.productId._id %>"><%= (item.discountPrice * item.quantity).toFixed(2) %></span>
                          </td>
                          <td>
                            <button data-id="<%= item.productId._id %>"
                              class="btn text-white btn-danger js-remove-item">X Remove</button>

                            
                          </td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="6" class="text-center">Your cart is empty.</td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </form>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="row mb-5">
               
                <div class="col-md-6">
                  <a href="/user/productList" class="btn bg-success text-white fw-bold  btn-block">Continue Shopping</a>
                </div>
              </div>


            </div>
            <div class="col-md-6 pl-5">
              <div class="row justify-content-end">
                <div style="background-color: antiquewhite;" class="col-md-7">
                  <div class="row">
                    <div style="background-color: rgb(139, 137, 134);" class="col-md-12 text-right border-bottom mb-5">
                      <h3 class="text-black h4 ">Cart Totals</h3>
                    </div>
                  </div>
                  <div class="row mb-3">
                    <div class="col-md-6">
                      <span class="text-black">Subtotal</span>
                    </div>
                    <div id="subtotal" class="col-md-6 text-right">
                      <strong class="text-black">₹ <span id="subTotal"><%= cart.items.reduce((sum, item)=> sum + (item.productId.price *
                          item.quantity), 0).toFixed(2) %></span></strong>
                    </div>
                  </div>

                  <div class="row mb-3">
                    <div class="col-md-6">
                      <span class="text-black">Dcount via Offer</span>
                    </div>
                    <div id="offerdis" class="col-md-6 text-right">
                      <strong class="text-black">₹ <span id="offer"><%= cart.items.reduce((sum, item)=> sum +
                          ((item.productId.price-item.discountPrice) *
                          item.quantity), 0).toFixed(2) %></span>
                        </strong>
                    </div>
                  </div>
                  <div class="row mb-3">
                    <div class="col-md-6">
                      <span class="text-black">Net Total</span>
                    </div>
                    <div class="col-md-6 text-right">
                      <strong class="text-black">
                        ₹
                        <span id="updatedCartTotal">
                          <%= ( cart.items.reduce((sum, item)=> sum + item.productId.price * item.quantity, 0) -
                            cart.items.reduce((sum, item) => sum + (item.productId.price - item.discountPrice) *
                            item.quantity, 0)
                            ).toFixed(2) %>
                        </span>
                      </strong>

                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-12">
                      <button style="height: 40px;"
                        class="btn btn-success text-white d-flex align-items-center justify-content-center text-center py-3 btn-block"
                        onclick="window.location='/user/checkout'">Proceed To Checkout</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%- include('../partials/userFooter') %>
  </div>

  <script src="/js/jquery-3.3.1.min.js"></script>
  <script src="/js/jquery-ui.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/aos.js"></script>

  <script src="/js/main.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


</body>

</html>