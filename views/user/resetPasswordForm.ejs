<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Set Your Password</title>
  <link rel="stylesheet" href="/css/setpassword.css"> <!-- Optional CSS -->
  
</head>
<body>
  <div class="container">
    <h2>Set Password</h2>
   

    <!--forgot password reset form-->
    <form id="googleSetPwd" action="/user/set-password" method="POST">
      
      <input id="pwd" type="password" name="password" placeholder="Enter new password" required autocomplete="new-password">
      
      <input id="con-pwd" type="password" name="confirmPassword" placeholder="Confirm password" required autocomplete="new-password">
      <input type="hidden" id="token" name="token" value="<%= token %>" />
      <button type="submit">Set Password</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
   
     const pwdForm=document.getElementById('googleSetPwd')
        pwdForm.addEventListener('submit',function(e){
        e.preventDefault()
       console.log(' setpwdfor submitted');

       const pwd=document.getElementById('pwd').value
       const confirmPwd=document.getElementById('con-pwd').value
       const token=document.getElementById('token').value
       console.log('pwd is',pwd);
       console.log('confirmPwd is ',confirmPwd);
      
    
    if(pwd==='' || confirmPwd===''){
        Swal.fire("Both fields are required")
    }else if(pwd!==confirmPwd){
     console.log('passwords are not matching');
     
        Swal.fire('Passwords are not matching')
    }else {
        fetch('/user/reset-password',{
        method:"POST",
        headers:{ "Content-Type": "application/json",
       
        },
        body:JSON.stringify({password: pwd,token, confirmPassword: confirmPwd,})
       }).then(res => res.json())
       .then(data=>{
        if(data.success){
             Swal.fire({
                icon: "success",
                title: data.message || "Coupon removed successfully!",
                showConfirmButton: false,
                timer: 1000
              }).then(()=>{
                 window.location.href='/user/login'
              })
            window.location.href='/user/login'
        }else{
            Swal.fire(data.message)
          window.location.href='/user/login'
        }
       }).catch(error=>{
        console.log('error is ',error);
        Swal.fire('Some thing went wrong')
       })
    }
       
    })
    
    
  </script>
</body>
</html>