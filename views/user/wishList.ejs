<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>My Wishlist | Aura Threads</title>
  <link rel="stylesheet" href="/css/wishList.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

  <%- include('../partials/userHeader') %>


    <div class="container">
      <h1 class="page-title">My Wishlist (<span id="count">
          <%= variants.length ||0 %>
        </span>)</h1>

      <% if (variants.length===0) { %>
        <!-- Empty wishlist state -->
        <div class="wishlist-empty">
          <img src="/api/placeholder/100/100" alt="Empty wishlist">
          <h2>Your wishlist is empty</h2>
          <p>Find some beautiful dresses to add to your wishlist</p>
          <a href="/user/productList" class="btn btn-primary">Start Shopping</a>
        </div>
        <% } else { %>
          <!-- Wishlist items grid -->
          <div class="wishlist-grid text-center">

            <% variants.forEach(variant=> { %>

              <div id="div-<%= variant._id %>" class="wishlist-item position-relative">

                <% if (variant.productId.discountPrice && variant.productId.discountPrice < variant.productId.price) { %>
                  <div style="width: 20%;height: 1.5em;"
                    class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 fs-6 px-2 py-1 rounded">
                    <% if (variant.productId.discountType==='percentage' ) { %>
                      <%= variant.productId.finalDiscount %>% OFF
                        <% } else { %>
                          ₹<%= variant.productId.finalDiscount %> OFF
                            <% } %>
                  </div>
                  <% } %>

                   <a href="/user/products/<%= variant._id %>"> <img src="<%= variant.images[0] || 'variant.productId.productName' %>" alt="<%= variant.productId.productName %>"
                      class="item-image"></a>

                    <div class="item-info">
                      <h3 class="item-name">
                        <%= variant.productId.productName %>
                      </h3>

                      <div class="item-price">
                        <% if (variant.productId.discountPrice && variant.productId.discountPrice < variant.productId.price) { %>
                          <span class="fw-bold text-success">₹<%= variant.productId.discountPrice %></span>
                          <span class="text-muted text-decoration-line-through ms-2">₹<%= variant.productId.price %></span>
                          <% } else { %>
                            ₹<%= variant.productId.price %>
                              <% } %>
                      </div>

                      <div class="item-meta">
                        <span>Size: <%= variant.size  %></span>
                        <div class="item-rating">
                          <%= '★' .repeat(Math.floor(variant.productId.rating || 4)) + '☆' .repeat(5 - Math.floor(variant.productId.rating
                            || 4)) %>
                            <span>(<%= variant.productId.reviewCount || 0 %>)</span>
                        </div>
                      </div>

                      <div class="item-actions text-center">
                        <button onclick="addToCart('<%= variant._id %>')"
                          class="btn addToCart <%= variant.stock === 0 ? 'btn-secondary' : 'bg-success text-white' %>"
                          <%=variant.productId.stock===0 ? 'disabled="disabled"' : '' %>>
                          <%= variant.stock===0 ? 'Out of Stock' : 'Add to Cart' %>
                        </button>

                        <button class="btn bg-danger btnRemove text-white"
                          onclick="remove('<%= variant._id %>')">Remove</button>
                      </div>
                    </div>
              </div>


              <% }) %>
          </div>
          <% } %>
    </div>


    <%- include('../partials/userFooter') %>

      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <script>
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        // Example JavaScript to handle remove button functionality
        document.addEventListener('DOMContentLoaded', function () {
          const removeButtons = document.querySelectorAll('.btn-remove');
          const wishlistItems = document.querySelectorAll('.wishlist-item');
          const wishlistGrid = document.querySelector('.wishlist-grid');
          const wishlistEmpty = document.querySelector('.wishlist-empty');
          const pageTitle = document.querySelector('.page-title');

          removeButtons.forEach((button, index) => {
            button.addEventListener('click', function () {
              // Remove the item with animation
              wishlistItems[index].style.opacity = '0';
              setTimeout(() => {
                wishlistItems[index].remove();

                // Check if wishlist is empty
                if (wishlistGrid.children.length === 0) {
                  wishlistGrid.style.display = 'none';
                  wishlistEmpty.style.display = 'block';
                  pageTitle.textContent = 'My Wishlist (0)';
                } else {
                  // Update count in title
                  pageTitle.textContent = `My Wishlist (${wishlistGrid.children.length})`;
                }

                // Update badge count
                document.querySelector('.icon .badge').textContent = wishlistGrid.children.length;
              }, 300);
              wishlistItems[index].style.transition = 'opacity 0.3s ease';
              wishlistItems[index].style.opacity = '0';
            });
          });
        });
        function addToCart(variantId) {
          console.log('add to cart btn cliked', variantId);
          fetch('/user/cart/add', {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              'CSRF-Token': csrfToken
            },
            body: JSON.stringify({ variantId })
          }).then(res => res.json())
            .then(data => {
              if (data && data.success) {

                Swal.fire({

                  icon: "success",
                  title: data.message,
                  showConfirmButton: false,
                  timer: 1000
                })
                
                const count = document.getElementById('count').innerHTML
                console.log(count);
                document.getElementById('count').innerHTML = parseInt(count - 1)


                const div = document.getElementById(`div-${variantId}`)
                if (div) {
                  div.remove()
                }
              } else {
                Swal.fire(data.message)
              }
            }).catch(error => {
              Swal.fire('Server error')
            })
        }

        function remove(variantId) {
          console.log('from delete wishlist script');
          console.log('productId ', variantId);

          fetch(`/user/wishList/delete/${variantId}`, {
            method: "DELETE",
            headers: { 'CSRF-Token': csrfToken }
          }).then(res => res.json())
            .then(data => {
              if (data && data.success) {
                Swal.fire({

                  icon: "success",
                  title: data.message,
                  showConfirmButton: false,
                  timer: 1000
                })
                const count = document.getElementById('count').innerHTML
                console.log(count);
                document.getElementById('count').innerHTML = parseInt(count - 1)

                const div = document.getElementById(`div-${variantId}`)
                if (div) {
                  div.remove()
                }
              } else {
                Swal.fire(data.message)
              }
            }).catch(error => {
              Swal.fire('Server Error')
            })
        }

      </script>
</body>

</html>