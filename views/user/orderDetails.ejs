<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <title>Order Details</title>
    <link rel="stylesheet" href="/css/orderDetails.css">
</head>

<body>
    <%- include('../partials/userHeader') %>
        <div class="order-container">

            <h2>Order Details - ORD<%= order._id.toString().slice(-6) %>
            </h2>

            <div class="section mb-4">
                <h3>Status</h3>
                <span class="badge <%= order.status.toLowerCase() %>">
                    <%= order.status %>
                </span>
            </div>

            <!-- Two-Column Split -->
            <div style="display: flex;" class="row">
                <!-- Left: Order Info & Address -->
                <div style="width: 50%;" class="col-md-6 section" id="div-left">
                    <h3>Order Info</h3>
                    <p><strong>Order Date:</strong>
                        <%= new Date(order.createdAt).toLocaleDateString() %>
                    </p>
                    <% if (order.deliveryDate) { %>
                        <p><strong>Delivery Date:</strong>
                            <%= new Date(order.deliveryDate).toLocaleDateString() %>
                        </p>
                        <% } %>
                            <p><strong>Payment Method:</strong>
                                <%= order.paymentMethod %>
                            </p>

                            <h3 class="mt-4">Shipping Address</h3>
                            <p>
                                <%= order.address.name %><br>
                                    <%= order.address.street %>, <%= order.address.city %>, <%= order.address.state %> -
                                                <%= order.address.pincode %><br>
                                                    Phone: <%= order.address.phone %>
                            </p>
                </div>

                <!-- Right: Price Breakdown -->
                <div style="width: 50%;" class="col-md-6 section" id="div-right"
                    style="background-color: #f9f9f9; border-left: 1px solid #ccc;">
                    <h3>Cost Summary</h3>
                    <p><strong>Total Amount:</strong> ₹ <%= order.totalAmount.toFixed(2) %>
                    </p>
                    <p><strong>Discount Through Coupon:</strong> ₹ <%= order.coupenDiscountAmount.toFixed(2) %>
                    </p>
                    <p><strong>Discount Through Offer:</strong> ₹ <%= order.offerDiscountAmount.toFixed(2) %>
                    </p>
                    <p><strong>Shipping Charge:</strong> ₹ <%= order.shippingCharge || 50.00 %>
                    </p>
                    <hr>
                    <p><strong>Net Total:</strong> <span style="font-size: 1.1rem; font-weight: bold;">₹ <%=
                                (order.finalAmount + order.shippingCharge||0).toFixed(2) %></span></p>
                </div>
            </div>

            <!-- Items Table -->
            <div class="section mt-4">
                <h3>Items</h3>
                <div class="table-responsive">
                    <table class="table items-table">
                        <thead>
                            <tr style="color: white;">
                                <th style="color: white;">Product</th>
                                <th style="color: white;">Image</th>
                                <th style="color: white;">Qty</th>
                                <th style="color: white;">Price</th>
                                <th style="color: white;">Subtotal</th>
                                <th style="color: white;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item=> { %>
                                <tr>
                                    <td>
                                        <%= item.productId.productName %>
                                    </td>
                                    <td><img src="<%= item.variantId.images[0] %>"
                                            alt="<%= item.productId.productName %>" style="width: 60px;"></td>
                                    <td>
                                        <%= item.quantity %>
                                    </td>
                                    <td>₹ <%= item.productId.price.toFixed(2) %>
                                    </td>
                                    <td>₹ <%= (item.quantity * item.productId.price).toFixed(2) %>
                                    </td>
                                    <td>
                                        <% if (item.status==='cancelled' ) { %>
                                            <button class="" style="background-color: grey; color: white;"
                                                disabled>Cancelled</button>
                                            <% } else if (item.status==='returned' ) { %>
                                                <button class="" style="background-color: grey; color: white;"
                                                    disabled>Returned</button>
                                                <% } else if(order.status.toLowerCase()=='delivered' ) { %>

                                                    <button data-variant-id="<%= item.variantId._id %>"
                                                        data-orderid="<%= order._id %>"
                                                        class="returnProduct">Return</button>
                                                    <% }else { %>
                                                        <button id="cancelBtn-<%= item.variantId._id %>"
                                                            onclick="cancelSingleProduct('<%= item.variantId._id %>','<%= order._id %>')"
                                                            class="orderCancel">Cancel</button>
                                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <button class="btn-back mt-3" id="btn-back">← Back to Orders</button>

        </div>


        <!--return product Modal -->
        <div id="returnModal" class="modal">
            <div class="modal-content text" style="width: 34% !important;">
                <span class="close">&times;</span>
                <h2>Reason for Return</h2>
                <textarea class="text" id="returnReason" placeholder="Enter your reason..." rows="4"
                    style="width: 100%;"></textarea>
                <br><br>
                <button class="btn bg-success text-white" id="submitReason">Submit</button>
            </div>
        </div>

        <%- include('../partials/userFooter') %>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
