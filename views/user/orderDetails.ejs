            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const returnBtns = document.querySelectorAll('.returnProduct');
                    const returnModal = document.getElementById('returnModal');
                    const closeBtn = document.querySelector('.close');
                    const submitBtn = document.getElementById('submitReason');

                    let variantId = null;
                    let orderId = null;
                    let clickedBtn = null;

                    returnBtns.forEach(btn => {
                        btn.addEventListener('click', function () {
                            clickedBtn = this;
                            variantId = this.getAttribute('data-variant-id');
                            orderId = this.getAttribute('data-orderid');
                            returnModal.style.display = 'block';
                        });
                    });

                    closeBtn.onclick = function () {
                        returnModal.style.display = 'none';
                    };

                    window.onclick = function (event) {
                        if (event.target === returnModal) {
                            returnModal.style.display = 'none';
                        }
                    };

                    submitBtn.onclick = async function () {
                        const reason = document.getElementById('returnReason').value.trim();
                        if (reason === '') {
                            Swal.fire("Please enter a reason.");
                            return;
                        }
                        try {
                            const response = await fetch('/user/return-product', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({ variantId, orderId, reason })
                            });

                            const result = await response.json();
                            if (result.success) {
                                Swal.fire({

                                    icon: "success",
                                    title: result.message,
                                    showConfirmButton: false,
                                    timer: 1000
                                })
                                returnModal.style.display = 'none';
                                clickedBtn.textContent = 'Return Requested';
                                clickedBtn.disabled = true;
                            } else {
                                Swal.fire(result.message);
                            }
                        } catch (err) {
                            Swal.fire('Something went wrong.');
                        }
                    };
                });
                const backBtn=document.getElementById('btn-back')
                backBtn.onclick=()=>{
                    window.location.href='/user/orders'
                }
                 function cancelSingleProduct(variantId, orderId) {
                    console.log('cancelSingleProduct btn clicked');
                    console.log('variant id ,orderid ', variantId, orderId);
                    Swal.fire({
                        title: "Do you want to cancel this product?",
                        text: "You won't be able to revert this!",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#3085d6",
                        cancelButtonColor: "#d33",
                        confirmButtonText: "Yes, Cancel it!"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch('/user/cancelSingleProduct', {
                                method: "DELETE",
                                headers: {
                                    "Content-Type": "application/json",

                                },
                                body: JSON.stringify({ variantId, orderId })
                            }).then(res => res.json())
                                .then(data => {
                                    if (data && data.success) {
                                        Swal.fire({

                                            icon: "success",
                                            title: data.message,
                                            showConfirmButton: false,
                                            timer: 1000
                                        });
                                        const btn = document.getElementById(`cancelBtn-${variantId}`)
                                        btn.innerHTML = 'cancelled'
                                        btn.disabled = true;
                                        btn.style.backgroundColor = 'grey';
                                        btn.style.color = 'white';
                                    } else {
                                        Swal.fire(data.message)
                                    }
                                }).catch(error => {
                                    Swal.fire("Server error")
                                })

                        }
                    });

                }

            </script>

</body>

</html>