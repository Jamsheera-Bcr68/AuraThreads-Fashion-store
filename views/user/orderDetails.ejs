<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta charset="UTF-8">
    <title>Order Details</title>
    <link rel="stylesheet" href="/css/orderDetails.css">
</head>

<body>

    <div class="order-container">

        <h2>Order Details - ORD<%= order._id.toString().slice(-6).toUpperCase() %>
        </h2>

        <div class="section">
            <h3>Status</h3>
            <span class="badge <%= order.status.toLowerCase() %>">
                <%= order.status %>
            </span>
        </div>

        <div class="section">
            <h3>Order Info</h3>
            <p><strong>Order Date:</strong>
                <%= new Date(order.createdAt).toLocaleDateString() %>
            </p>
            <% if (order.deliveryDate) { %>
                <p><strong>Delivery Date:</strong>
                    <%= new Date(order.deliveryDate).toLocaleDateString() %>
                </p>
                <% } %>
                    <p><strong>Payment Method:</strong>
                        <%= order.paymentMethod %>
                    </p>
                    <p><strong>Total Amount:</strong>₹ <%= order.totalAmount.toFixed(2) %>
                            <p><strong>Discount Thruogh Coupon:</strong>₹ <%= order.coupenDiscountAmount.toFixed(2) %>
                                <p><strong>Discount Thruogh Offer:</strong>₹ <%= order.offerDiscountAmount.toFixed(2) %>
                                    <p><strong>Net Total :</strong>₹ <%= order.finalAmount.toFixed(2) %>
                                    </p>
        </div>

        <div class="section">
            <h3>Shipping Address</h3>
            <p>
                <%= order.address.name %><br>
                    <%= order.address.street %>, <%= order.address.city %>, <%= order.address.state %> - <%=
                                    order.address.pincode %><br>
                                    Phone: <%= order.address.phone %>
            </p>
        </div>

        <div class="section">
            <h3>Items</h3>
            <table class="table items-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Subtotal</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(item=> { %>
                        <tr>
                            <td>
                                <%= item.productId.productName %>
                            </td>
                            <td>
                                <img src="<%= item.productId.images[0] %>" alt="<%= item.productId.productName %>">
                            </td>
                            <td>
                                <%= item.quantity %>
                            </td>
                            <td>₹ <%= item.productId.price.toFixed(2) %>
                            </td>
                            <td>₹ <%= (item.quantity * item.productId.price).toFixed(2) %>
                            </td>
                            <td>
                                <% if (item.status==='cancelled' ) { %>
                                    <button class="" style="background-color: grey; color: white;"
                                        disabled>Cancel</button>
                                    <button class="" style="background-color: grey; color: white;"
                                        disabled>Return</button>
                                    <% } else { %>
                                        <button
                                            onclick="cancelSingleProduct('<%= item.productId._id %>', '<%= order._id %>')"
                                            class="orderCancel">Cancel</button>
                                        <button data-productid="<%= item.productId._id %>"
                                            data-orderid="<%= order._id %>" class="returnProduct"
                                            id="returnBtn">Return</button>
                                        <% } %>

                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>

        <button class="btn-back" id="btn-back">← Back to Orders</button>

    </div>

    <!--return product Modal -->
    <div id="returnModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Reason for Return</h2>
            <textarea class="text" id="returnReason" placeholder="Enter your reason..." rows="4"
                style="width: 100%;"></textarea>
            <br><br>
            <button class="btn" id="submitReason">Submit</button>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        window.onload = function () {
            const urlParams = new URLSearchParams(window.location.search);
            const source = urlParams.get('source');
            console.log(source, 'source is');

            const backBtn = document.getElementById("btn-back");

            if (backBtn) {
                backBtn.addEventListener('click', function () {
                    if (source === 'all') {
                        window.location.href = "/user/orders";
                    } else {
                        window.location.href = "/user/account";
                    }
                });
            }
        };
        function cancelSingleProduct(productId, orderId) {
            console.log('cancelSingleProduct btn clicked');
            console.log('product id ,orderid ', productId, orderId);
            Swal.fire({
                title: "Do you want to cancel this product?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Cancel it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/user/cancelSingleProduct', {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json",
                            'CSRF-Token': csrfToken
                         },
                        body: JSON.stringify({ productId, orderId })
                    }).then(res => res.json())
                        .then(data => {
                            if (data && data.succcess) {
                                Swal.fire({
                                    title: "Cancelled!",
                                    text: "This Product Cancelled.",
                                    icon: "success"
                                });
                            } else {
                                Swal.fire(data.message)
                            }
                        }).catch(error => {
                            Swal.fire("Server error")
                        })

                }
            });

        }

        const returnBtn = document.getElementById('returnBtn');
        const returnModal = document.getElementById('returnModal');
        const closeBtn = document.querySelector('.close');
        const submitBtn = document.getElementById('submitReason');

        let productId = '';
        let orderId = '';

        // Open Modal
        returnBtn.onclick = function () {
            console.log('retun btn clicked');
            
            productId = this.getAttribute('data-productid');
            orderId = this.getAttribute('data-orderid');
            returnModal.style.display = 'block';
        }

        // Close Modal
        closeBtn.onclick = function () {
            returnModal.style.display = 'none';
        }

        // Close Modal if clicked outside content
        window.onclick = function (event) {
            if (event.target == returnModal) {
                returnModal.style.display = 'none';
            }
        }

        // Submit Reason
        submitBtn.onclick = async function () {
            console.log('reason submitted');
            
            const reason = document.getElementById('returnReason').value.trim();
            console.log('reason ',reason);
            
            if (reason!=='') {
                
                try {
                    const response = await fetch('/user/return-product', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            productId: productId,
                            orderId: orderId,
                            reason: reason
                        })
                    });

                    const result = await response.json();
                    if (result.success) {
                        Swal.fire('Return request submitted successfully!');
                        returnModal.style.display = 'none';
                    } else {
                        Swal.fire(result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire('Something went wrong.');
                }

            } else {
                Swal.fire("Please enter a reason.");
            }
        }
    
    </script>



</body>

</html>