<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>User Signup</title>
  <!-- Bootstrap CSS -->
   <link rel="stylesheet" href="/css/register.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #3f4144;
      height: 100vh;
    }

    .card {
      border: none;
      border-radius: 20px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .card-title {
      color: #4a00e0;
      font-weight: bold;
    }

    .btn-primary {
      background-color: #8c4790;
      border: none;
    }

    .btn-primary:hover {
      background-color: #8a5a8d;
    }

    .social-login {
      display: flex;
      gap: 10px;
    }

    .btn-google {
      background-color: #db4437;
      color: white;
    }

    .btn-google:hover {
      background-color: #c33c2e;
    }

    .btn-facebook {
      background-color: #4267b2;
      color: white;
    }

    .btn-facebook:hover {
      background-color: #365899;
    }
  </style>
</head>

<body>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <div class="container d-flex justify-content-center align-items-center h-100">
    <div class="col-md-5">
      <div class="card p-4">
        <h3 style="color: #8c4790;" class="card-title text-center mb-4">User Signup</h3>

        <% if (typeof errorMessage !=='undefined' && errorMessage) { %>

          <div class="alert alert-danger">
            <%= errorMessage %>
          </div>
          <% } %>

            <form id='loginForm' >
              <div class="mb-3">
              
                <label for="email" class="form-label">Email address</label>
                <input type="email" name="email" class="form-control" id="email" placeholder="Enter email" />
              </div>
              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" class="form-control" id="password"
                  placeholder="Enter password" />
              </div>
              <div class="mb-3">
                <label for="confrm-password" class="form-label">Confirm Password</label>
                <input type="password" name="confirm-password" class="form-control" id="confirm-password"
                  placeholder="Re-enter password" />
              </div>
              <div class="mb-3">
                <label for="password" class="form-label">Phone number</label>
                <input type="text" name="phone" class="form-control" id="phone" placeholder="Enter Phone Number" />
              </div>
              
              <div class="mb-3">
                <label for="referalCode" class="form-label">Use Referal code and get <span style="color: green;" ><b>Rs.50.00</b></span> to wallet </label>
                <input type="text" name="referredBy" class="form-control" id="referalCode" placeholder="Enter Referal Code" />
              </div>
              <button type="submit" class="btn btn-primary w-100 mb-3">
                Signup
              </button>
              <div class="text-center text-muted">OR</div>
              <div class="social-login mt-3">
                <a href="/user/auth/google" class="btn btn-google w-100">
                  <i class="bi bi-google"></i> Sign up with Google
                </a>
                <a href="#" class="btn btn-facebook w-100">
                  <i class="bi bi-facebook"></i> Sign up with Facebook
                </a>
              </div>
            </form>
            <div class="text-center mt-3">
              <h6><a href="/user/login">Already Have n account? Login</a></h6>
            </div>
      </div>
    </div>
  </div>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    document.addEventListener("DOMContentLoaded", function () {
      document.getElementById('loginForm').addEventListener('submit', formValidate)
    });
    function formValidate(e) {
      e.preventDefault()//prvent form from submitting
      var email = document.getElementById("email").value.trim();
      const phone = document.getElementById("phone").value.trim();
      var confirm_password = document.getElementById("confirm-password").value.trim();
      var password = document.getElementById("password").value.trim();
      var referredBy=document.getElementById('referalCode').value.trim()
      var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; // Regex for email format
       const letterRegex = /[a-zA-Z]/;

      if (email === "" || password === "") {

        Swal.fire("All fields are required");
        return false;
      }else if(password.length<4){
         Swal.fire("Password should at least 4 charectors");

        return false;
      }else if(password.length>8){
        Swal.fire("Password should not more than 8 charectors");
        return false
      } else if (!emailPattern.test(email)) {
        Swal.fire("Enter a valid email address");

        return false;
      } else if (phone === '') {
        Swal.fire("Phone Number Cannot be Empty");

        return false;
      }else if(letterRegex.test(phone)){
        Swal.fire("Phone number should not contain letters.");
      } else if (confirm_password === '') {
        Swal.fire("confirm password is mandatory");

        return false;
      }
      else if (password !== confirm_password) {
        Swal.fire("Password is not matching");
        return false;
      }else if(phone.length<10){
        Swal.fire('Invalid mobile number')
      } else {
       fetch("/user/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            'CSRF-Token': csrfToken 
          },
          body: JSON.stringify({ email, phone, password, confirm_password,referredBy })
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire("Success", data.message, "success").then(() => {
                // Send second request to load OTP page
                window.location.href = "/user/otp";
              });
            } else {
              Swal.fire("Failed", data.message);
            }
          })
          .catch(error => {
            console.log('error is ', error);
            Swal.fire("Something went wrong");
          });

      }
    }

  </script>

</body>

</html>