<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Set Your Password</title>
  <link rel="stylesheet" href="/css/setpassword.css"> <!-- Optional CSS -->
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>

<body>
  <div class="container">

      <% if (showAlert) { %>
   <h3 style="margin-left: 8em;color: green;" >Signup Successfull</h3>
    <p style="margin-left: 8em;">Please Set password for your account</p>
  
<% } %>

    <h2 style="color: #8c4790;" >Set Password</h2>
    <label for="email"> Your email is:</label>


    <form id="googleSetPwd" action="/user/set-password" method="POST">
      <input id="email" type="email" style="font-weight: bold;" name="email" value="<%= email %>" readonly required
        autocomplete="username">
      <input id="pwd" type="password" name="password" placeholder="Enter new password" required
        autocomplete="new-password">

      <input id="con-pwd" type="password" name="confirmPassword" placeholder="Confirm password" required
        autocomplete="new-password">
      <button style="background-color: #8c4790;" type="submit">Set Password</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    const pwdForm = document.getElementById('googleSetPwd')
    pwdForm.addEventListener('submit', function (e) {
      e.preventDefault()
      console.log(' setpwdfor submitted');

      const pwd = document.getElementById('pwd').value
      const confirmPwd = document.getElementById('con-pwd').value
      console.log('pwd is', pwd);
      console.log('confirmPwd is ', confirmPwd);
      const email = document.getElementById('email').value
      console.log('email', email);


      if (pwd === '' || confirmPwd === '') {
        Swal.fire("Both fields are required")
      } else if (pwd !== confirmPwd) {
        console.log('passwords are not matching');

        Swal.fire('Passwords are not matching')
      } else {
        fetch('/user/setPassword', {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            'CSRF-Token': csrfToken
          },
          body: JSON.stringify({ email: email, password: pwd, confirmPassword: confirmPwd, })
        }).then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire({
                icon: "success",
                title: data.message,
                showConfirmButton: false,
                timer: 1000
              }).then(()=>{
                 window.location.href = '/user/login'
              })
             
            } else {
              Swal.fire(data.message)

            }
          }).catch(error => {
            console.log('error is ', error);
            Swal.fire('Some thing went wrong')
          })
      }

    })


  </script>
</body>

</html>