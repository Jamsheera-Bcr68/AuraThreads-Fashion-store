<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container py-5">
        <div class="row">
            <!-- Product Image -->
            <div class="col-md-6">
                <img src="<%= singleProduct.image %>" class="img-fluid rounded shadow-sm" alt="<%= singleProduct.productName %>">
            </div>

            <!-- Product Details -->
            <div class="col-md-6">
                <% singleProduct.reviews = ['good', 'very good', 'super'] %>
              <% singleProduct.highlights = ['good material', 'recent price', 'long lasting'] %>
              <% singleProduct.relatedProducts = [{ name: 'churidar', image: singleProduct.images[0] }] %>

                <div class="breadcrumbs text-muted mb-2">Home > <%= singleProduct.category %> > <%= singleProduct.productName %></div>
                
                <h1 class="display-5 fw-bold mb-3"><%= singleProduct.productName %></h1>
                <div class="price fs-4 text-danger mb-2">
                    $<%= singleProduct.price %> <span class="text-success">(<%= singleProduct.discount %>% Off)</span>
                </div>
                <div class="ratings text-warning mb-2">⭐⭐⭐⭐☆ (<%= singleProduct.reviews.length %> Reviews)</div>
                <div class="stock text-primary mb-3">
                    <%= singleProduct.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                </div>

                <!-- Highlights -->
                <div class="highlights p-3 border rounded bg-light mb-3">
                    <h5>Highlights:</h5>
                    <ul class="list-unstyled">
                        <% singleProduct.highlights.forEach(highlight => { %>
                            <li>✅ <%= highlight %></li>
                        <% }) %>
                    </ul>
                </div>

                <!-- Reviews -->
                <div class="reviews p-3 border rounded bg-light mb-3">
                    <h5>Reviews:</h5>
                    <% singleProduct.reviews.forEach(review => { %>
                        <p><b>🗨️ <%= review %></b></p>
                    <% }) %>
                </div>

                <!-- Related Products -->
                <div class="related-products p-3 border rounded bg-light">
                    <h5>Related Products:</h5>
                    <div class="d-flex gap-2">
                        <% singleProduct.relatedProducts.forEach(related => { %>
                            <img src="<%= related.image %>" alt="<%= related.name %>" class="img-thumbnail" style="width: 100px; height: 100px;">
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
