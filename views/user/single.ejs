<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container py-5">
        <div class="row">
            <!-- Product Image -->
            <div class="col-md-6">
                <img src="<%= singleProduct.image %>" class="img-fluid rounded shadow-sm" alt="<%= singleProduct.productName %>">
            </div>

            <!-- Product Details -->
            <div class="col-md-6">
                <% singleProduct.reviews = ['good', 'very good', 'super'] %>
              <% singleProduct.highlights = ['good material', 'recent price', 'long lasting'] %>
              <% singleProduct.relatedProducts = [{ name: 'churidar', image: singleProduct.images[0] }] %>

                <div class="breadcrumbs text-muted mb-2">Home > <%= singleProduct.category %> > <%= singleProduct.productName %></div>
                
                <h1 class="display-5 fw-bold mb-3"><%= singleProduct.productName %></h1>
                <div class="price fs-4 text-danger mb-2">
                    $<%= singleProduct.price %> <span class="text-success">(<%= singleProduct.discount %>% Off)</span>
                </div>
                <div class="ratings text-warning mb-2">⭐⭐⭐⭐☆ (<%= singleProduct.reviews.length %> Reviews)</div>
                <div class="stock text-primary mb-3">
                    <%= singleProduct.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                </div>

                <!-- Highlights -->
                <div class="highlights p-3 border rounded bg-light mb-3">
                    <h5>Highlights:</h5>
                    <ul class="list-unstyled">
                        <% singleProduct.highlights.forEach(highlight => { %>
                            <li>✅ <%= highlight %></li>
                        <% }) %>
                    </ul>
                </div>

                <!-- Reviews -->
                <div class="reviews p-3 border rounded bg-light mb-3">
                    <h5>Reviews:</h5>
                    <% singleProduct.reviews.forEach(review => { %>
                        <p><b>🗨️ <%= review %></b></p>
                    <% }) %>
                </div>

                <!-- Related Products -->
                <div class="related-products p-3 border rounded bg-light">
                    <h5>Related Products:</h5>
                    <div class="d-flex gap-2">
                        <% singleProduct.relatedProducts.forEach(related => { %>
                            <img src="<%= related.image %>" alt="<%= related.name %>" class="img-thumbnail" style="width: 100px; height: 100px;">
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

    <div id="kids" class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
            <h2>Kid's Collections</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">

              <% kidsProducts.forEach(product=> { %>
                <div class="item">
                  <div class="block-4 text-center p-3"
                    style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <figure class="block-4-image">
                      <a href="/user/products/<%= product._id %>">
                        <img class="img-fluid" src="<%= product.images[0] %>" alt="Image placeholder"
                          style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                      </a>
                    </figure>
                    <div class="block-4-text p-2">
                      <h3 class="mb-1">
                        <a href="#" class="text-dark" style="font-size: 14px;">
                          <%= product.productName %>
                        </a>
                      </h3>
                      <p class="text-warning mb-1" style="font-size: 12px;">
                        <% for (var i=1; i <=5; i++) { %>
                          <i
                            class="fa <%= i <= Math.floor(product.rating) ? 'fa-star' : (i - product.rating < 1 ? 'fa-star-half-o' : 'fa-star-o') %>"></i>
                          <% } %>
                      </p>
                      <!-- <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p> -->
                      <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;">
                        <%= product.price %>
                      </p>
                    </div>
                  </div>
                </div>
                <% }) %>

            </div>
          </div>
        </div>

        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center "> <a
              href="/user/productList?categoryId=<%= kidsProducts[0].categoryId %>">Show More </a></div>
        </div>



