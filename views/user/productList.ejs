<head>
    <link rel="stylesheet" href="/css/productList.css">
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>

<body>
    <style>
        .card-image {
            width: auto;
            height: 350px;
            margin-left: 1.5em;
        }
    </style>
    <%- include('../partials/userHeader') %>

        <div class="hero-section">
            <div class="container text-center">
                <h1 class="display-5 fw-bold">
                    <%= title %>
                </h1>
                <p class="lead">Discover our latest styles for every occasion</p>
            </div>
        </div>

        <div class="container py-2">

            <div class="row">
                <div class="col-lg-3 mb-4">
                    <div class="card p-3">
                        <form action="/user/productList" method="get">
                            <h5>Filter Collection</h5>
                            <hr>
                            <input type="hidden" name="sort" value="<%= sort %>">
                            <input type="hidden" name="query" value="<%= query %>">

                            <!-- Categories -->
                            <div class="mb-4">
                                <h6 class="filter-title">Categories</h6>
                                <% categories.forEach(category=> { %>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="<%= category._id %>"
                                            name="categoryId" value="<%= category._id %>"
                                            <%=Array.isArray(selectedCategories) &&
                                            selectedCategories.includes(category._id.toString()) ? 'checked' : '' %> >
                                        <label class="form-check-label" for="<%= category._id %>">
                                            <%= category.categoryName %>
                                        </label>
                                    </div>
                                    <% }) %>
                            </div>

                            <!-- Price Ranges -->
                            <div class="mb-4">
                                <h6 class="filter-title">Price Range</h6>
                                <% const priceRanges=["","0-200", "200-400" , "400-600" , "600-800" , "800-1000"
                                    , "1000-2000" ]; %>
                                    <% priceRanges.forEach((range, index)=> { %>

                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="priceRange"
                                                id="price<%= index %>" value="<%= range %>"
                                                <%=selectedPriceRange===range ? 'checked' : '' %> >
                                            <label class="form-check-label" for="price<%= index %>">
                                                ₹<%= range.replace("-", " - Rs." ) %>
                                            </label>
                                        </div>
                                        <% }) %>
                            </div>

                            <button type="submit" class="btn btn-dark w-100">Apply Filters</button>
                        </form>

                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <p class="mb-0">Showing <span id="productCount">
                                <%= products.length %>
                            </span> dresses</p>
                        <form action="/user/productList" method="get">
                            <div class="d-flex gap-2">
                                <!-- Hidden Inputs to Preserve Filters -->
                                <% if (Array.isArray(selectedCategories)) { %>
                                    <% selectedCategories.forEach(cat=> { %>
                                        <input type="hidden" name="categoryId" value="<%= cat %>">
                                        <% }) %>
                                            <% } else if (categoryId) { %>
                                                <input type="hidden" name="categoryId" value="<%= categoryId %>">
                                                <% } %>

                                                    <input type="hidden" name="query" value="<%= query %>">
                                                    <input type="hidden" name="priceRange" value="<%= priceRange %>">

                                                    <select class="form-select form-select-sm" name="sort"
                                                        id="sortSelect" style="width: auto;"
                                                        onchange="this.form.submit()">
                                                        <option value="" <%=!sort ? 'selected' : '' %>>Sort By</option>
                                                        <option value="newest" <%=sort==='newest' ? 'selected' : '' %>
                                                            >Newest First</option>
                                                        <option value="lowToHigh" <%=sort==='lowToHigh' ? 'selected'
                                                            : '' %>>Price: Low to High</option>
                                                        <option value="highToLow" <%=sort==='highToLow' ? 'selected'
                                                            : '' %>>Price: High to Low</option>
                                                        <option value="az" <%=sort==='az' ? 'selected' : '' %>>A - Z
                                                        </option>
                                                        <option value="za" <%=sort==='za' ? 'selected' : '' %>>Z - A
                                                        </option>
                                                    </select>
                            </div>
                        </form>



                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        <% products.forEach(function(product) { %>
                            <div class="col">
                                <div class="card h-100">
                                    <div class="position-relative">
                                        <a href="/user/products/<%= product.mainVariant?._id %>">
                                            <img src="<%= product?.mainVariant?.images?.[0] %>" class="card-image"
                                                alt="<%= product.productName %>">
                                        </a>
                                        <% if (product.finalDiscount) { %>
                                            <span
                                                class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                                <% if (product.discountType==='percentage' ) { %>
                                                    <%= product.finalDiscount %>% OFF
                                                        <% } else { %>
                                                            ₹<%= product.finalDiscount %> OFF
                                                                <% } %>
                                            </span>
                                            <% } %>

                                                <% if (product.sale) { %>
                                                    <span class="badge bg-danger">SALE</span>
                                                    <% } %>

                                                        <% let isInWishlist=wishlist.includes(product._id.toString());
                                                            %>
                                                            <div class="wishlist-icon">
                                                                <i class="<%= isInWishlist ? 'fas fa-heart wishlist-true' : 'far fa-heart' %>"
                                                                    data-id="<%= product._id %>">
                                                                </i>
                                                            </div>
                                    </div>
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <%= product.productName %>
                                        </h5>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <% if (product.discountPrice && product.discountPrice < product.price) {
                                                    %>
                                                    <span class="text-decoration-line-through ">₹ <%=
                                                            product.price.toFixed(2) %></span>
                                                    <span class="text-danger fw-bold ms-2">₹ <%=
                                                            product.discountPrice.toFixed(2) %></span>
                                                    <% } else { %>
                                                        <span class="fw-bold">₹ <%= product.price.toFixed(2) %> </span>
                                                        <% } %>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="rating-box ratings" id="product-rating">
                                                    <span class="rating-number">5</span>
                                                    <span class="rating-star">★</span>
                                                </div>
                                            </div>
                                        </div>
                                        <label style="font-weight: bold;" for="size">Size: <%= product.mainVariant.size %></label>
                                        <!-- <p class="card-text small text-muted">
                                            <%= product.description.substring(0, 60) %>...
                                        </p> -->
                                        <div class="mt-2 mb-3">
                                            <!-- <small class="text-muted">Available sizes: S,M,L,XL</small> -->
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent border-top-0">
                                        <div class="d-grid">
                                            <button data-id="<%= product._id %>"
                                                class="btn addToCart bg-success text-white" <%=product.stock===0
                                                ? 'disabled' : '' %>>
                                                <%= product.stock===0 ? 'Out of Stock' : 'Add to Cart' %>
                                            </button>
                                            <!-- <button class="btn addToWishList bg-success text-white"
                                                style="margin-top: .5em;" data-id="<%= product._id %>">Add to
                                                WishList</button> -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>

                </div>

                <nav class="mt-5">
                    <ul class="pagination justify-content-center">

                        <!-- Previous Button -->
                        <nav>
                            <ul class="pagination justify-content-center">
                                <% if (currentPage> 1) { %>
                                    <li class="page-item">
                                        <a class="page-link"
                                            href="?page=<%= currentPage - 1 %>&categoryId=<%= categoryId %>&priceRange=<%= priceRange %>&sort=<%= sort %>&query=<%= query %>">Previous</a>
                                    </li>
                                    <% } %>

                                        <% for (let i=1; i <=totalPages; i++) { %>
                                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                <a class="page-link"
                                                    href="?page=<%= i %>&categoryId=<%= categoryId %>&priceRange=<%= priceRange %>&sort=<%= sort %>&query=<%= query %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                            <% } %>

                                                <% if (currentPage < totalPages) { %>
                                                    <li class="page-item">
                                                        <a class="page-link"
                                                            href="?page=<%= currentPage + 1 %>&categoryId=<%= categoryId %>&priceRange=<%= priceRange %>&sort=<%= sort %>&query=<%= query %>">Next</a>
                                                    </li>
                                                    <% } %>
                            </ul>
                        </nav>

                    </ul>
                </nav>

            </div>
        </div>
        </div>

        <%- include('../partials/userFooter') %>
        <script src="/js/jquery.magnific-popup.min.js"></script>
            <script src="/js/aos.js"></script>
            <script src="/js/main.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
             // var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute("content");

                const cartButton = document.querySelectorAll('.addToCart')
                cartButton.forEach(btn => btn.addEventListener('click', function () {
                    const productId = this.getAttribute('data-id')
                    console.log('product id is', productId);

                    fetch('/user/cart/add', {
                        method: 'post',
                        headers: {
                            'content-Type': 'application/json',
                              'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({ productId, quantity: Number(1) })
                    }).then(response => response.json())
                        .then(data => {
                            if (data && data.success) {
                                Swal.fire({
                                    title: "Item Added to Cart!",
                                    text: "You can continue shopping or view your cart.",
                                    icon: "success",
                                    showCancelButton: true,
                                    confirmButtonText: "Show Cart",
                                    cancelButtonText: "OK",
                                    reverseButtons: true // optional: puts "OK" on the left
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // Navigate to the cart page
                                        window.location.href = "/user/cart";
                                    }
                                    // else do nothing (OK just closes the alert)
                                });
                            } else {
                                Swal.fire(data.message)
                            }
                        })


                }))



                document.getElementById('sortSelect').addEventListener('change', function () {
                    this.form.submit();
                });

                /* Sample JavaScript for the EJS template */
                document.addEventListener('DOMContentLoaded', function () {
                    console.log('Dress shop page loaded with <%= products.length %> dresses');

                    const wishlistIcons = document.querySelectorAll('.wishlist-icon');

                    wishlistIcons.forEach(icon => {
                        icon.addEventListener('click', function () {
                            console.log('wishlist icon clicked');

                            const heart = this.querySelector('i');
                            const productId = heart.getAttribute('data-id');

                            const isNotInWishlist = heart.classList.contains('far');

                            if (isNotInWishlist) {
                                console.log('Item not in wishlist');

                                // Add to wishlist
                                fetch('/user/wishList/add', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'CSRF-Token': csrfToken
                                    },
                                    body: JSON.stringify({ productId })
                                })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data && data.success) {
                                            heart.classList.remove('far');
                                            heart.classList.add('fas', 'wishlist-true'); // Make it filled and red
                                            Swal.fire({
                                                title: "Item Added to Wishlist!",
                                                text: "You can continue shopping or view your wishList.",
                                                icon: "success",
                                                showCancelButton: true,
                                                confirmButtonText: "Show wishlist",
                                                cancelButtonText: "OK",
                                                reverseButtons: true // optional: puts "OK" on the left
                                            }).then((result) => {
                                                if (result.isConfirmed) {
                                                    // Navigate to the cart page
                                                    window.location.href = "/user/wishlist";
                                                }
                                                // else do nothing (OK just closes the alert)
                                            });
                                        } else {
                                            Swal.fire(data.message);
                                        }
                                    });

                            } else {
                                console.log('item is in wishlist');
                                console.log(productId);

                                // Remove from wishlist
                                fetch(`/user/wishList/delete/${productId}`, {
                                    method: 'DELETE',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'CSRF-Token': csrfToken
                                    },
                                    body: JSON.stringify({ productId })
                                })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data && data.success) {
                                            heart.classList.remove('fas', 'wishlist-true');
                                            heart.classList.add('far'); // Make it outline
                                            
                                            Swal.fire({
                                                icon: "success",
                                                title: data.message,
                                                showConfirmButton: false,
                                                timer: 1000
                                            })

                                        } else {
                                            Swal.fire(data.message);
                                        }
                                    }).catch(err=>{
                                        console.log(err);
                                        
                                        Swal.fire("Internal server error")
                                    })
                            }
                        });
                    });


                    // Example of how you might handle add to cart functionality
                    const addToCartButtons = document.querySelectorAll('.btn-outline-primary');
                    addToCartButtons.forEach(button => {
                        button.addEventListener('click', function (e) {
                            const productCard = e.target.closest('.card');
                            const productName = productCard.querySelector('.card-title').textContent;
                            console.log(`Added ${productName} to bag`);

                        });
                    });
                });


                const addToWishListBtn = document.querySelectorAll('.addToWishList')
                addToWishListBtn.forEach(btn => btn.addEventListener('click', function () {
                    const productId = this.getAttribute('data-id')
                    console.log('wishlist btn clicked');

                    console.log('product id is', productId);

                    fetch('/user/wishList/add', {
                        method: 'post',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({ productId })
                    }).then(response => response.json())
                        .then(data => {
                            if (data && data.success) {
                                Swal.fire({
                                    icon: "success", // or "warning", depending on your case
                                    title: data.message,
                                    showConfirmButton: false,
                                    timer: 1000
                                });
                            } else {
                                Swal.fire({
                                    icon: "error",
                                    title: data.message,
                                    showConfirmButton: false,
                                    timer: 1000
                                });
                            }
                        }).catch(err=>{
                            console.log(err);
                            Swal.fire('server error')
                        })
                }))

            </script>
            </body>

</html>