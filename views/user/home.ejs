
<body>
  
  <script src="/js/aos.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/jquery-3.3.1.min.js"></script>
  <script src="/js/jquery-ui.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/slick.min.js"></script>
<style>
  .block-4-image{
    width: 13em;
    height: auto;
    margin-left: 4em;
}
  
</style>

  <%- include('../partials/userHeader') %>
  <!--hero session -->
  <div class="site-blocks-cover" style="background-image: url(/images/image.png);" data-aos="fade">
    
    <div class="container">
      <div class="row align-items-center justify-content-between">
        <!-- Image Column -->
        <div class="col-md-6 text-center text-md-right">
          <img class="hero-img img-fluid" src="/images/women-03.jpg" alt="">
        </div>
        
        <!-- Text Column -->
        <div class="col-md-6 text-center text-md-left pt-5 pt-md-0">
          <h1 class="mb-2">Finding Your Perfect Appearance</h1>
          <div class="intro-text">
            <p class="mb-4 fw-bold">Discover trendy and elegant dresses for every occasion. Shop the latest styles with comfort and confidence!</p>
            <p>
              <a href="#" class="btn btn-sm btn-primary">Shop Now</a>
            </p>
          </div>
        </div>
      </div>
    </div>
    
  </div>

  <!--Icon area -->
  <div class="site-section site-section-sm site-blocks-1">
    <div class="container">
      <div class="row">
        <% const features = [
          { icon: "icon-truck", title: "Free Shipping","description":"Free Shipping on All Orders!." },
          { icon: "icon-refresh2", title: "Free Returns" ,"description":"Free Return on All Orders!."},
          { icon: "icon-help", title: "Customer Support" ,"description":"Better Custemer Support."}
        ]; %>
        <% features.forEach((feature, index) => { %>
          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
            <div class="icon mr-4 align-self-start">
              <span class="<%= feature.icon %>"></span>
            </div>
            <div class="text">
        
              <h2 class="text-uppercase"><%= feature.title %></h2>
              <p><%= feature.description %>"</p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

   <!--shop by categories -->
   <div class="site-section site-blocks-2">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-7 fw-bold site-section-heading text-center pt-4">
          <h2>Shop By Categories</h2>
        </div>
      </div>
      <div class="row categoy"> 
       
        <% categories.forEach((category, index) => { %>
          <div class="col-sm-6 col-md-6 col-lg-4 mb-4 mb-lg-0" data-aos="fade" data-aos-delay="<%= index * 100 %>">
            <a class="block-2-item" href="#womens">
              <figure class="image">
                <a href="/product/productList?categoryId=<%= category._id %>"><img src="/<%= category.images[0] %>" alt="<%= category.categoryName %>" class="img-fluid"></a>
              </figure>
              <div class="text">
                <span class="text-uppercase">Category</span>
                <h3><%= category.categoryName %></h3>
                <p><%= category.description %></p>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
</div>

   
   
  <div id="kids" class="site-section block-3 site-blocks-2 bg-light">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
          <h2>Kid's Collections</h2>
        </div>
      </div>
      <div class="row">
        <div class="col-md-12">
          <div class="nonloop-block-3 owl-carousel">
            
            <% kidsProducts.forEach(product => { %>
              <div class="item">
                <div class="block-4 text-center p-3" style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                  <figure class="block-4-image">
                    <a href="/product/products/<%= product._id %>">
                      <img src="<%= product.images[0] %>" 
                    alt="Image placeholder"
                    style="border-radius: 8px; height: 220px; width: 100%; object-fit: cover;">
                    </a>
                  </figure>
                  <div class="block-4-text p-2">
                    <h3 class="mb-1">
                      <a href="#" class="text-dark" style="font-size: 14px;"><%= product.productName %></a>
                    </h3>
                    <p class="text-warning mb-1" style="font-size: 12px;">
                      <% for (var i = 1; i <= 5; i++) { %>
                        <i class="fa <%= i <= Math.floor(product.rating) ? 'fa-star' : (i - product.rating < 1 ? 'fa-star-half-o' : 'fa-star-o') %>"></i>
                      <% } %>
                    </p>
                    <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p>
                    <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;"><%= product.price %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
     
      <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center "> <a href="/product/productList?categoryId=<%= kidsProducts[0].categoryId %>">Show More </a></div>
      </div>
        
 
    
    <div id="mens" class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
            <h2>Men's Collections</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">
              
              <% mensProducts.forEach(product => { %>
                <div class="item">
                  <div class="block-4 text-center p-3" style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <figure class="block-4-image">
                      <a href="/product/products/<%= product._id %>">
                        <img src="<%= product.images[0] %>" 
                      alt="Image placeholder"
                      style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                      </a>
                    </figure>
                    <div class="block-4-text p-2">
                      <h3 class="mb-1">
                        <a href="#" class="text-dark" style="font-size: 14px;"><%= product.productName %></a>
                      </h3>
                      <p class="text-warning mb-1" style="font-size: 12px;">
                        <% for (var i = 1; i <= 5; i++) { %>
                          <i class="fa <%= i <= Math.floor(product.rating) ? 'fa-star' : (i - product.rating < 1 ? 'fa-star-half-o' : 'fa-star-o') %>"></i>
                        <% } %>
                      </p>
                      <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p>
                      <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;"><%= product.price %></p>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
         
        </div>
        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center "> <a href="/product/productList?categoryId=<%= mensProducts[0].categoryId %>">Show More </a></div>
      </div>
      </div>
      
    </div>


    <div id="womens" class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
            <h2>Women's Collections</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">
              
              <% womenProducts.forEach(product => { %>
                <div class="item">
                  <div class="block-4 text-center p-3" style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <figure class="block-4-image">
                     <a href="/product/products/<%= product._id %>">
                      <img class="img-fluid" src="<%= product.images[0] %>" 
                      alt="Image placeholder"
                      style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                     </a>
                    </figure>
                    <div class="block-4-text p-2">
                      <h3 class="mb-1">
                        <a href="#" class="text-dark" style="font-size: 14px;"><%= product.productName %></a>
                      </h3>
                      <p class="text-warning mb-1" style="font-size: 12px;">
                        <% for (var i = 1; i <= 5; i++) { %>
                          <i class="fa <%= i <= Math.floor(product.rating) ? 'fa-star' : (i - product.rating < 1 ? 'fa-star-half-o' : 'fa-star-o') %>"></i>
                        <% } %>
                      </p>
                      <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p>
                      <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;"><%= product.price %></p>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center "> <a href="/product/productList?categoryId=<%= womenProducts[0].categoryId %>">Show More </a></div>
      </div>
      </div>
         
        </div>
      </div>
    </div>
  </div>
  
   <!--big sale session -->
  <div class="site-section block-8">
    <div class="container">
      <div class="row justify-content-center mb-5">
        <div class="col-md-7 site-section-heading text-center pt-4">
          <h2>Big Sale!</h2>
        </div>
      </div>
      <div class="row align-items-center">
        <div class="col-md-12 col-lg-7 mb-5">
          <a href="#"><img src="/images/blog_1.jpg" alt="Image placeholder" class="img-fluid rounded"></a>
        </div>
        <div class="col-md-12 col-lg-5 text-center pl-md-5">
          <h2><a href="#">50% less in all items</a></h2>
          <p class="post-meta mb-4">By <a href="#">Carl Smith</a> <span class="block-8-sep">&bullet;</span> September 3, 2018</p>
          <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit.</p>
          <p><a href="#" class="btn btn-primary btn-sm">Shop Now</a></p>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/userFooter') %>
  
</body>
</html>
