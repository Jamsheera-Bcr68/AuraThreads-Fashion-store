<head>


  <!-- Slick CSS -->
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />

  <!-- Slick Theme (optional) -->
  <link rel="stylesheet" type="text/css"
    href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

  <!-- Slick JS -->
  <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

</head>

<body>

  <script src="/js/aos.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/jquery-3.3.1.min.js"></script>
  <script src="/js/jquery-ui.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/owl.carousel.min.js"></script>
  <script src="/js/popper.min.js"></script>
  <script src="/js/slick.min.js"></script>
  <style>

/* .category-slide img {
  width: 100%;
  height: auto ;
  display: block;
} */

.slick-slide img {
  height: auto !important;
  object-fit: cover;
}
    .block-4-image {
      width: 13em;
      height: auto;
      margin-left: 4em;
    }
     .block-c-image {
      width: 16em;
      height: auto;
      margin-left: 2em;
    }
/*     
    .category-slide .text {
  position: relative;
  z-index: 10;
  background: white; /* or rgba(255,255,255,0.8) 
  padding: 10px;
    } 
 */
 </style>

  <%- include('../partials/userHeader') %>
    <!--hero session -->
    <div class="site-blocks-cover" style="background-image: url(/images/image.png);" data-aos="fade">

      <div class="container">
        <div class="row align-items-center justify-content-between">
          <!-- Image Column -->
          <div class="col-md-6 text-center text-md-right">
            <img class="hero-img img-fluid" src="/images/women-03.jpg" alt="">
          </div>

          <!-- Text Column -->
          <div class="col-md-6 text-center text-md-left pt-5 pt-md-0">
            <h1 class="mb-2">Finding Your Perfect Appearance</h1>
            <div class="intro-text">
              <p class="mb-4 fw-bold">Discover trendy and elegant dresses for every occasion. Shop the latest styles
                with comfort and confidence!</p>
              <p>
                <a href="/user/productList" style="background-color: #8c4790;color: white;" class="btn btn-sm">Shop
                  Now</a>
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!--Icon area -->
    <div class="site-section site-section-sm site-blocks-1">
      <div class="container">

        <div class="row">
          <% const features=[ { icon: "icon-truck" , title: "Free Shipping" ,
            description: "Free Shipping on All Orders!." }, { icon: "icon-refresh2" , title: "Free Returns" ,
            description: "Free Return on All Orders!." }, { icon: "icon-help" , title: "Customer Support" ,
            description: "Better Customer Support." } ]; %>

            <% features.forEach((feature, index)=> { %>
              <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up"
                data-aos-delay="<%= index * 100 %>">
                <div class="icon mr-4 align-self-start">
                  <span class="<%= feature.icon %>"></span>
                </div>
                <div class="text">

                  <h2 class="text-uppercase">
                    <%= feature.title %>
                  </h2>
                  <p>
                    <%= feature.description %>"
                  </p>
                </div>
              </div>
              <% }) %>
        </div>
      </div>
    </div>

    <div id="categories" class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
            <h2>Shop By Categories</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">

              <% categories.forEach(category=> { %>
                <div class="item">

                  
                  <div class="block-4 text-center p-3"
                    style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">

                  <div class="block-4-text p-2">
                       
                          <h3 class="mb-1"> <%= category.categoryName %></h3>
                     </div>

                    <figure class="block-c-image">
                      <a href="/user/productList?categoryId=<%= category._id %>">
                        <img class="img-fluid" src="<%= category?.images[0] %>" alt="Image placeholder"
                          style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                      </a>
                      
                    </figure>
                    
                  </div>
                </div>
                <% }) %>
            </div>
          </div>
        </div>
        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          
        </div>
      </div>

    </div>


    <div id="kids" class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
            <h2>Kid's Collections</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">

              <% kidsProducts.forEach(product=> { %>
                <div class="item">
                  <div class="block-4 text-center p-3"
                    style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <figure class="block-4-image">

                      <a href="/user/products/<%= product.mainVariant._id %>">
                        <img class="img-fluid" src="<%= product.mainVariant?.images?.[0] %>" alt="Image placeholder"
                          style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                      </a>
                      <% if (product.finalDiscount) { %>
                        <span style="width: 20%;"
                          class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                          <% if (product.discountType==='percentage' ) { %>
                            <%= product.finalDiscount %>% OFF
                              <% } else { %>
                                ₹<%= product.finalDiscount %> OFF
                                  <% } %>
                        </span>
                        <% } %>
                    </figure>
                    <div class="block-4-text p-2">
                      <h3 class="mb-1">
                        <a href="#" class="text-dark" style="font-size: 14px;">
                          <%= product.productName %>
                        </a>
                      </h3>

                      <p class="text-warning mb-1" style="font-size: 12px;">
                        <% for (var i=1; i <=5; i++) { %>
                          <i
                            class="fa <%= i <= Math.floor(product.rating) ? 'fa-star' : (i - product.rating < 1 ? 'fa-star-half-o' : 'fa-star-o') %>"></i>
                          <% } %>
                      </p>
                      <!-- <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p> -->
                      <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;">
                        <% if (product.discountPrice && product.discountPrice < product.price) { %>
                          <span class="text-decoration-line-through text-muted">₹ <%= product.price.toFixed(2) %></span>
                          <span class="text-danger fw-bold ms-2">₹ <%= product.discountPrice.toFixed(2) %></span>
                          <% } else { %>
                            <span class="fw-bold">₹ <%= product.price.toFixed(2) %> </span>
                            <% } %>
                      </p>
                      <span style="border-radius: 3px;" class="rating-box ratings bg-success text-white"
                        id="product-rating">
                        <span class="rating-number">5</span>
                        <span class="rating-star">★</span>
                      </span>
                    </div>
                  </div>
                </div>
                <% }) %>

            </div>
          </div>
        </div>

        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center ">
            <% if(kidsProducts.length!==0){ %>
              <a href="/user/productList?categoryId=<%= kidsProducts[0].categoryId %>">Show More </a>
              <% } %>
          </div>
        </div>



        <div id="mens" class="site-section block-3 site-blocks-2 bg-light">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
                <h2>Men's Collections</h2>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <div class="nonloop-block-3 owl-carousel">


                  <% menProducts.forEach(product=> { %>
                    <div class="item">
                      <div class="block-4 text-center p-3"
                        style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                        <figure class="block-4-image">
                          <a href="/user/products/<%= product.mainVariant._id %>">
                            <img class="img-fluid"  src="<%= (product.mainVariant && product.mainVariant?.images && product.mainVariant.images[0]) || product.images[0] %>" alt="Image placeholder"
                              style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                          </a>
                          <% if (product.finalDiscount) { %>
                            <span style="width: 20%;"
                              class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                              <% if (product.discountType==='percentage' ) { %>
                                <%= product.finalDiscount %>% OFF
                                  <% } else { %>
                                    ₹<%= product.finalDiscount %> OFF
                                      <% } %>
                            </span>
                            <% } %>
                        </figure>
                        <div class="block-4-text p-2">
                          <h3 class="mb-1">
                            <a href="#" class="text-dark" style="font-size: 14px;">
                              <%= product.productName %>
                            </a>
                          </h3>

                          <!-- <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p> -->
                          <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;">
                            <% if (product.discountPrice && product.discountPrice < product.price) { %>
                              <span class="text-decoration-line-through text-muted">₹ <%= product.price.toFixed(2) %>
                              </span>
                              <span class="text-danger fw-bold ms-2">₹ <%= product.discountPrice.toFixed(2) %></span>
                              <% } else { %>
                                <span class="fw-bold">₹ <%= product.price.toFixed(2) %> </span>
                                <% } %>
                          </p>
                          <span style="border-radius: 3px;" class="rating-box ratings bg-success text-white"
                            id="product-rating">
                            <span class="rating-number">5</span>
                            <span class="rating-star">★</span>
                          </span>
                        </div>
                      </div>
                    </div>

                    <% }) %>


                </div>
              </div>
            </div>
          </div>

        </div>
        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center ">
            <% if(menProducts.length>0){ %>
              <a href="/user/productList?categoryId=<%= menProducts[0].categoryId %>">Show More </a>
              <% } %>
          </div>
        </div>
      </div>

    </div>



    <div id="womens" class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading fw-bold text-center pt-4">
            <h2>Women's Collections</h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">

              <% womenProducts.forEach(product=> { %>
                <div class="item">
                  <div class="block-4 text-center p-3"
                    style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <figure class="block-4-image">
                      <a href="/user/products/<%= product.mainVariant._id %>">
                        <img class="img-fluid" src="<%= product.mainVariant?.images?.[0]  %>" alt="Image placeholder"
                          style="border-radius: 8px; height: 250px; width: 100%; object-fit: cover;">
                      </a>
                      <% if (product.finalDiscount) { %>
                        <span style="width: 20%;"
                          class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                          <% if (product.discountType==='percentage' ) { %>
                            <%= product.finalDiscount %>% OFF
                              <% } else { %>
                                ₹<%= product.finalDiscount %> OFF
                                  <% } %>
                        </span>
                        <% } %>
                    </figure>
                    <div class="block-4-text p-2">
                      <h3 class="mb-1">
                        <a href="#" class="text-dark" style="font-size: 14px;">
                          <%= product.productName %>
                        </a>
                      </h3>
                      <div class="d-flex align-items-center">

                      </div>


                      <!-- <p class="text-success fw-bold mb-1" style="font-size: 12px;">Free Delivery</p> -->
                      <p class="text-primary font-weight-bold mb-0" style="font-size: 14px;">
                        <% if (product.discountPrice && product.discountPrice < product.price) { %>
                          <span class="text-decoration-line-through text-muted">₹ <%= product.price.toFixed(2) %></span>
                          <span class="text-danger fw-bold ms-2">₹ <%= product.discountPrice.toFixed(2) %></span>
                          <% } else { %>
                            <span class="fw-bold">₹ <%= product.price.toFixed(2) %> </span>
                            <% } %>
                      </p>
                      <span style="border-radius: 3px;" class="rating-box ratings bg-success text-white"
                        id="product-rating">
                        <span class="rating-number">5</span>
                        <span class="rating-star">★</span>
                      </span>
                    </div>
                  </div>
                </div>
                <% }) %>
            </div>
          </div>
        </div>
        <div class="more  d-flex justify-content-end" style="background-color: rgb(248 249 250);height: 50px;">
          <div class="showMore text-center ">
            <% if(menProducts.length>0){ %>

              <a href="/user/productList?categoryId=<%= womenProducts[0].categoryId %>">Show More </a>
              <% } %>
          </div>
        </div>
      </div>

    </div>



    <!--big sale session -->
    <div class="site-section block-8">
      <div class="container">
        <div class="row justify-content-center mb-5">
          <div class="col-md-7 site-section-heading text-center pt-4">
            <h2>Big Sale!</h2>
          </div>
        </div>
        <div class="row align-items-center">
          <div class="col-md-12 col-lg-7 mb-5">
            <a href="#"><img src="/images/blog_1.jpg" alt="Image placeholder" class="img-fluid rounded"></a>
          </div>
          <div class="col-md-12 col-lg-5 text-center pl-md-5">
            <h2><a href="#">Special Offer on Kids Products</a></h2>
            <p class="post-meta mb-4">By <a href="#">Carl Smith</a> <span class="block-8-sep">&bullet;</span> September
              3, 2018</p>
            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit.</p>
            <p><a style="background-color: #8c4790;color: white;" href="#" class="btn  btn-sm">Shop Now</a></p>
          </div>
        </div>
      </div>
    </div>
    <%- include('../partials/userFooter') %>
      <script>
        $(document).ready(function () {
          $('.category-carousel').slick({
            slidesToShow: 3,
            slidesToScroll: 1,
            infinite: true,
            arrows: true,
            dots: false,
            responsive: [
              {
                breakpoint: 768,
                settings: {
                  slidesToShow: 2
                }
              },
              {
                breakpoint: 480,
                settings: {
                  slidesToShow: 1
                }
              }
            ]
          });
        });
      </script>



</body>