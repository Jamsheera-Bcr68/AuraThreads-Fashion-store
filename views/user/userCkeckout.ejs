<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout - Aura Threads</title>
  <link rel="stylesheet" href="/css/checkout.css">

</head>

<body>
  <header>
    <%- include('../partials/userHeader') %>
  </header>
  <div>
    <h1 style="text-align: center; font-weight: bold; color: #8c4790;">Checkout Information</h1>
  </div>
  <div class="container" style="display: flex;max-width: 1500 px;">

    <div class="col-md-6 col-12 checkout-container" style="width: 50%; background: #fdfcfc; border-radius: 10px;">
      <div class="checkout-form">


        <!-- Contact Info -->
        <div class="form-section">
          <h3 style="text-align: center;;font-weight: bold;  margin-top: 1em;">Contact Information</h3>

          <form id="contactForm" action="">
            <div id="contactInfo" class="editable-mode">
              <div class="form-group">
                <label for="email">Email Address</label>
                <input name="email" type="email" id="email" placeholder="<%= user?.email || 'Email Address' %>"
                  value="<%= typeof email !== 'undefined' ? email : (user?.email || '') %>" disabled>
              </div>

              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input name="phone" type="tel" id="phone" placeholder="<%= user?.phone || 'Phone Number' %>"
                  value="<%= typeof phone !== 'undefined' ? phone :(user?.phone || '') %>" disabled>
              </div>

              <div class="form-group">
                <label for="fullname">Full Name</label>
                <input name="fullName" type="text" id="fullname" placeholder="<%= user?.fullName || 'Your Full Name' %>"
                  value="<%= typeof fullname !== 'undefined' ? fullname : (user?.fullName || '') %>" disabled>
              </div>
            </div>
            <div class="button-wrapper">
              <button type="submit" id="submitBtn" style="margin-top: 10px; display: none;">Submit</button>
              <button type="button" id="toggleEditBtn">Edit</button>
            </div>

          </form>

        </div>

        <!-- Shipping Addresses -->
        <div class="form-section">
          <h3 style="font-weight: bold;">Shipping Addresses</h3><span> <button onclick="oppenAddressModal()"
              id="addAdressBtn">Add Adress</button></span>
          <p>Select your address</p>

          <div class="addresses-container" style="display: flex; flex-wrap: wrap; gap: 20px;">
            <% if (addresses && addresses.length> 0) { %>
              <% addresses.forEach((address, index)=> { %>
                <div class="address-box" style="border: 1px solid #ccc; padding: 15px; width: 45%; position: relative;">
                  <input type="radio" name="selectedAddress" value="<%= address._id %> %>" id="address-<%= index %>"
                    style="position: absolute; top: 10px; right: 10px;">
                  <label for="address-<%= index %>">
                    <p><strong>Label:</strong>
                      <%= address.label %>
                    </p>

                    <p>
                      <%= address.line1 || '-' %>
                    </p>
                    <p>
                      <%= address.city %>
                    </p>
                    <p>
                      <%= address.state %>,
                        <%= address.country %>
                    </p>
                    <p><strong>ZIP:</strong>
                      <%= address.zip %>
                    </p>

                  </label>
                </div>
                <% }); %>
                  <% } else { %>
                    <p>No saved addresses found.</p>
                    <% } %>
          </div>
        </div>

      </div>
    </div>

    <div class="col-md-6 col-12 order-container"
      style="width: 45%;margin-left: 3em; background: #fdfcfc;margin-top: 2em; border-radius: 10px; padding: 20px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
      <h2 style="text-align: center;font-weight: bold; color: rgb(16, 21, 16);">Order Summary</h2>
      <table style="width: 100%; border-collapse: collapse; font-weight: bold;">
        <thead>
          <tr style="border-bottom: 1px solid #eee;">
            <th style="text-align: left; padding: 10px;">Image</th>
            <th style="text-align: left; padding: 10px;">Details</th>
          </tr>
        </thead>
        <tbody>
          <% cartItems.forEach(function(item) { %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 15px;">
                <img src="<%= item.images[0] || '/api/placeholder/80/100' %>" alt="<%= item.productName %>"
                  style="width: 80px; height: 100px; border-radius: 4px;">
              </td>
              <td style="padding: 15px;">
                <div class="product-name" style="font-weight: bold;">
                  <%= item.productName %>
                </div>
                <div class="product-variant" style="font-size: 14px; color: #666;">Size: <%= item.size %> | Color: <%=
                      item.color %>
                </div>
                <div class="product-quantity" style="margin-top: 5px; font-size: 14px;">Quantity: <strong>
                    <%= item.quantity %> ,
                  </strong> Price: ₹ <strong style="color: #1b6a2a; font-weight: bold; margin-top: 5px;">
                    <%= item.price %>
                  </strong></div>
                <div class="product-price" style="color: #d81b60; font-weight: bold; margin-top: 5px;">₹ <%=
                    item.subTotal %>
                </div>
              </td>
            </tr>
            <% }); %>
        </tbody>
      </table>

      <!-- Price Summary -->

      <div class="price-details" style="margin-top: 20px;font-weight: bold;">
        <div class="price-row" style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Subtotal</span><span style="color: #1b6a2a; font-weight: bold; margin-top: 5px;"> ₹ <%= totalAmount %>
          </span>
        </div>

        <div class="price-row" style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Shipping</span><span style="color: #1b6a2a;">₹ <%= shippingCharge %></span>
        </div>
        <div class="price-row" style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Tax</span><span style="color: #1b6a2a;">₹ <%= taxAmount %></span>
        </div>
        <div class="price-row" style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Discount via coupon</span><span id="discountAmount" style="color: #1b6a2a;">₹ <%= couponDiscountAmount
              %></span>
        </div>
        <div class="price-row" style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Discount via offer</span><span id="offerDiscountAmount" style="color: #1b6a2a;">₹ <%=
              offerDiscountAmount %></span>
        </div>
        <div class="total-row"
          style="display: flex; justify-content: space-between; font-weight: bold; border-top: 1px solid #eee; padding-top: 10px; margin-top: 10px;">
          <span>Total</span><span id="finalAmount" style="color: #1b6a2a;">₹ <%=
              (totalAmount-offerDiscountAmount-couponDiscountAmount+taxAmount+shippingCharge).toFixed(2) %></span>
        </div>
      </div>

      <!-- Promo Code -->
      <div class="form-group" style="margin-top: 25px;">
        <label for="coupon">Coupon Code</label>
        <button style="background-color: #8c4790;color: white;margin-left: 10em;border: 0;border-radius: 5px;"
          onclick="openCouponModal()" id="showCouponsBtn">Show Coupons</button>


        <div style="display: flex;">
          <input type="text" id="coupon" value="<%= couponCode ||'' %>" placeholder="Enter Coupon code"
            style="flex: 1; padding: 10px; border: 1px solid #ccc; border-right: none; border-radius: 4px 0 0 4px;">
          <button id="coupenBtn" data-applied="<%= couponCode ? 'true' : 'false' %>"
            style="padding: 10px 16px; background-color: <%= couponCode ? '#cc0000' : '#104615' %>; color: white; border: none; border-radius: 0 4px 4px 0; cursor: pointer;">
            <%= couponCode ? 'Remove' : 'Apply' %>
          </button>

        </div>
      </div>
      <!-- Payment Info -->
      <div class="payment-container" style="margin-top: 1em;">

        <!--wallet -->
        <div class="wallet-box">
          <input class="form-check-input" type="checkbox" id="useWallet" name="useWallet"
            style="width: 20px; height: 20px;" <% if (wallet.balance> 0) { %> checked <% } %>
            >
            <label class="form-check-label" for="useWallet" style="font-size: 18px; font-weight: bold; color: #155724;">
              Use Wallet Balance (₹<%= wallet.balance.toFixed(2) %>)
            </label>
        </div>


        <div class="form-section" id="paymentSection">
          <h3 style="font-weight: bold; color: green;">Payment Method</h3>

          <div class="payment-options">
            <div class="payment-option ">Credit Card</div>
            <div class="payment-option">UPI</div>
            <div class="payment-option">COD</div>
          </div>

          <div class="form-group">
            <label for="cardnumber">Card Number</label>
            <input type="tel" id="cardnumber" placeholder="1234 5678 9012 3456" pattern="[0-9 ]*" maxlength="19"
              inputmode="numeric" value="<%= typeof cardnumber !== 'undefined' ? cardnumber : '' %>">
          </div>

          <div class="row">
            <div class="col form-group">
              <label for="expiry">Expiry Date</label>
              <input type="text" id="expiry" placeholder="MM/YY"
                value="<%= typeof expiry !== 'undefined' ? expiry : '' %>">
            </div>
            <div class="col form-group">
              <label for="cvv">CVV</label>
              <input type="text" id="cvv" placeholder="123" value="<%= typeof cvv !== 'undefined' ? cvv : '' %>">
            </div>
          </div>



          <div class="form-group">
            <label for="cardname">Name on Card</label>
            <input type="text" id="cardname" placeholder="Full Name on Card"
              value="<%= typeof cardname !== 'undefined' ? cardname : '' %>">
          </div>

          <div class="form-group upi-field" style="display: none;">
            <label for="upi">UPI ID</label>
            <input type="text" id="upi" placeholder="example@upi">
          </div>
        </div>

        <!-- Complete Purchase -->

        <!-- hidden inputs -->
        <input id="totalAmount" type="hidden" name="totalAmount" value="<%= totalAmount %>">
        <form action="/user/place-order" method="POST" id="productCheckoutForm">




          <div style="text-align: right; margin-top: 20px;">
            <button class="btn" type="submit"
              style="padding: 12px 24px; background-color: #28a745; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer;">
              Place Order
            </button>
          </div>
        </form>

        <!-- Secure Badge -->
        <div class="secure-badge" style="margin-top: 20px;">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M8 0C5.8 0 4 1.8 4 4V5H3C2.4 5 2 5.4 2 6V14C2 14.6 2.4 15 3 15H13C13.6 15 14 14.6 14 14V6C14 5.4 13.6 5 13 5H12V4C12 1.8 10.2 0 8 0ZM6 4C6 2.9 6.9 2 8 2C9.1 2 10 2.9 10 4V5H6V4ZM8 11C8.6 11 9 10.6 9 10C9 9.4 8.6 9 8 9C7.4 9 7 9.4 7 10C7 10.6 7.4 11 8 11Z"
              fill="#666666" />
          </svg>
          Secure Checkout - All information is encrypted and secure
        </div>
      </div>

    </div>
    </form>

    <!--Show Coupon Modal-->

    <div id="couponModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeCouponModal()">&times;</span>
        <h3>Available Coupons</h3>
        <div id="coupon-list">
          <% coupons.forEach(coupon=> { %>
            <div class="coupon-card">
              <input id="couponCode" type="text" value="<%= coupon.coupenCode %>">
              <button id="Cbutton" onclick="copyCoupon('<%= coupon.coupenCode%>');  closeCouponModal();">copy</button>
              <p>Discount: <%= coupon.discountValue || coupon.discountPercentage + '%' %>
              </p>
              <p>Minimum Purchase:<%=coupon.minPurchase %>
              </p>
              <p>Expires: <%= coupon.expiryDate.toDateString() %>
              </p>


            </div>
            <% }) %>
        </div>
      </div>
    </div>

  </div>
  <!--Add address madal-->
  <div id="modal-overlay" class="modal-overlay" style="display: none;">
    <div id="address-form" class="address-form-modal">
      <h3 id="address-form-title">Add New Address</h3>
      <form id="addAddressForm" action="/user/addres/add" method="POST">

        <input type="hidden" id="address-id" name="id" />
        <div class="form-group">
          <label for="address-label">Label (e.g., Home, Work)</label>
          <input type="text" id="address-label" name="label" required>
        </div>
        <div class="form-group">
          <label for="address-line1">Address Line 1</label>
          <input type="text" id="address-line1" name="line1" required>
        </div>
        <div class="form-group">
          <label for="address-line2">Address Line 2 (Optional)</label>
          <input type="text" id="address-line2" name="line2">
        </div>
        <div class="form-group">
          <label for="address-city">City</label>
          <input type="text" id="address-city" name="city" required>
        </div>
        <div class="form-group">
          <label for="address-state">State/Province</label>
          <input type="text" id="address-state" name="state" required>
        </div>


        <div class="form-group">
          <label for="address-zip">ZIP/Postal Code</label>
          <input type="text" id="address-zip" name="zip" required>
        </div>
        <div class="form-group">
          <label for="address-country">Country</label>
          <input type="text" value="" name="country" id="address-country" required>

        </div>
        <div class="form-group">
          <label for="address-phone">Phone Number</label>
          <input type="tel" id="address-phone" name="phone" required>
        </div>
        <div hidden class="form-group checkbox-group">
          <input type="checkbox" id="default" name="isDefault" value="true">
          <label for="default">Set as Default Address</label>
        </div>
        <div class="action-buttons">
          <button type="button" class="btn-secondary" onclick="cancelAddressForm()">
            Cancel
          </button>
          <button id="addressSubmitBtn" type="submit">Save Address</button>
        </div>
      </form>
    </div>

  </div>

  <%- include('../partials/userFooter') %> `

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>

      document.addEventListener("DOMContentLoaded", function () {
        const useWalletCheckbox = document.getElementById('useWallet');
        const paymentSection = document.getElementById('paymentSection');

        function togglePaymentSection() {
          if (useWalletCheckbox.checked) {
            paymentSection.style.display = 'none';
          } else {
            paymentSection.style.display = 'block';
          }
        }

        togglePaymentSection();

        useWalletCheckbox.addEventListener('change', togglePaymentSection);
        const options = document.querySelectorAll(".payment-option");

        const cardFields = document.querySelectorAll("#cardnumber, #expiry, #cvv, #cardname");
        const upiField = document.querySelector(".upi-field");

        options.forEach(option => {
          option.addEventListener("click", function () {
            options.forEach(o => o.classList.remove("active"));
            this.classList.add("active");

            const selected = this.textContent.trim();

            if (selected === "Credit Card") {
              cardFields.forEach(f => f.closest(".form-group").style.display = "block");
              upiField.style.display = "none";
            } else if (selected === "UPI") {
              cardFields.forEach(f => f.closest(".form-group").style.display = "none");
              upiField.style.display = "block";
            } else {
              cardFields.forEach(f => f.closest(".form-group").style.display = "none");
              upiField.style.display = "none";
            }
          });
        });

        //profile for  submission
        const toggleBtn = document.getElementById('toggleEditBtn');
        const inputs = document.querySelectorAll('#contactInfo input');
        let isEditable = false;

        toggleBtn.addEventListener('click', () => {
          isEditable = !isEditable;
          console.log('toggleEditBtn clicked');

          inputs.forEach(input => {
            input.disabled = !isEditable;
          });

          toggleBtn.textContent = isEditable ? 'Cancel' : 'Edit';
          submitBtn.style.display = isEditable ? 'inline-block' : 'none';


          if (!isEditable) {
            fetch('/user/data', {
              method: "GET"
            }).then(res => res.json())
              .then(data => {
                if (data && data.success) {
                  console.log('user from backend', data.user);

                  document.getElementById('email').value = data.user.email
                  document.getElementById('phone').value = data.user.phone || ''
                  document.getElementById('fullname').value = data.user.fullName || ""
                }
              })

            console.log("Saved values:", {
              email: document.getElementById('email').value,
              phone: document.getElementById('phone').value,
              fullname: document.getElementById('fullname').value
            });
          }
        });


      });

      const placeorderform = document.getElementById('productCheckoutForm')

      placeorderform.addEventListener('submit', function (e) {
        e.preventDefault()
        console.log('placeorderform submitted');

        const selectedAddressRadio = document.querySelector('input[name="selectedAddress"]:checked');
        if (!selectedAddressRadio) {
          Swal.fire("Please select a shipping address.");
          return;
        }

        const selectedAddressId = selectedAddressRadio.value

        console.log(selectedAddressId);

        const activePaymentOption = document.querySelector('.payment-option.active');
        const paymentMethod = activePaymentOption ? activePaymentOption.textContent.trim() : null;
        let paymentDetails = {};
        if (paymentMethod === 'Credit Card') {
          paymentDetails = {
            cardNumber: document.getElementById('cardnumber').value,
            expiry: document.getElementById('expiry').value,
            cvv: document.getElementById('cvv').value,
            cardName: document.getElementById('cardname').value
          };
          console.log(paymentDetails);
          
          if (paymentDetails.cardNumber =='') {
            return Swal.fire('Card number cannot be empty')
          }
          if (paymentDetails.expiry == '') {
            return Swal.fire('Expiry date cannot be empty');
          }

          if (/[a-zA-Z]/.test(paymentDetails.expiry)) {
            return Swal.fire('Enter proper expiry date');
          }
          if(paymentDetails.cvv==''){
             return Swal.fire('CVV  cannot be empty');
          }
          

        } else if (paymentMethod === 'UPI') {

          paymentDetails = {
            upiId: document.getElementById('upi').value
          };
        } else if (paymentMethod === 'COD') {
          paymentDetails = {}; // No extra fields needed
        }

        console.log('Payment method', paymentMethod);
        console.log('payment detais ', paymentDetails);
        let totalAmount = document.getElementById('totalAmount').value

        console.log('total amount is ', totalAmount);

        totalAmount = parseFloat(totalAmount);


        if (isNaN(totalAmount)) totalAmount = 0;

        const useWallet = document.getElementById('useWallet').checked
        console.log('useWallet ', useWallet);


        const orderData = {
          addressId: selectedAddressId,
          paymentMethod,
          paymentDetails,
          totalAmount,
          useWallet,
        };

        fetch("/user/place-order", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",

          },
          body: JSON.stringify(orderData),
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.paymentMethod == 'COD') {
              Swal.fire({
                title: "Order Placed!",
                text: data.message,
                icon: "success",
                confirmButtonText: "View Order Details",
              }).then(() => {
                window.location.href = `/user/order-success?orderId=${data.orderId}`;
              });

            }else if(data.paymentMethod == 'wallet'){
              Swal.fire({
                title: "Order Placed!",
                text: data.message,
                icon: "success",
                confirmButtonText: "View Order Details",
              }).then(() => {
                window.location.href = `/user/order-success?orderId=${data.orderId}`;
              });
              
            }else if (data && data.success && data.razorpayOrderId) {
              console.log(('data', data));

              const options = {
                key: data.key_id,
                amount: data.amount, // in paisa
                currency: data.currency,
                name: "AuraThreads",
                description: "Test Transaction",
                order_id: data.razorpayOrderId,
                handler: function (response) {
                  console.log('before fetching');

                  fetch("/user/varifyPayment", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      razorpay_payment_id: response.razorpay_payment_id,
                      razorpay_order_id: response.razorpay_order_id,
                      razorpay_signature: response.razorpay_signature,
                      orderId: data.orderId,
                    }),
                  })
                    .then((res) => res.json())
                    .then((data) => {
                      if (data && data.success) {
                        Swal.fire({
                          title: "Order Placed!",
                          text: data.message,
                          icon: "success",
                          confirmButtonText: "View Order Details",
                        }).then(() => {
                          window.location.href = `/user/order-success?orderId=${data.orderId}`;
                        });
                      } else {
                        Swal.fire("Payment verification failed.");
                        window.location.href = '/user/order-failure'
                      }
                    });
                },
                modal: {
                  ondismiss: function () {
                    console.log('Checkout closed by user or payment failed.');
                    Swal.fire("Payment Cancelled or Failed!");
                    window.location.href = '/user/order-failure';
                  }
                },
                prefill: {
                  name: data.user?.fullName || "",
                  email: data.user?.email || "",
                  contact: data.user?.phone || "",
                },
                theme: { color: "#3399cc" },
              };

              const rzp = new Razorpay(options);
              rzp.open();
            } else {
              Swal.fire(data.message || "Order creation failed.");
            }
          })
          .catch((error) => {
            Swal.fire("Something went wrong.");
            console.log(error);
          });
      })



      const coupenBtn = document.getElementById('coupenBtn');
      let isApplied = coupenBtn.dataset.applied === 'true';

      coupenBtn.addEventListener('click', function () {
        const code = document.getElementById('coupon').value;
        console.log('Apply coupon button clicked');
        console.log('Code is:', code);
        if (code == '') {
          return Swal.fire('Enter a Coupon Code')
        }
        // If coupon already applied, remove it
        if (isApplied) {
          console.log(isApplied);

          fetch('/user/removeCoupon', {
            method: 'GET',

          })
            .then((res) => res.json())
            .then((data) => {
              Swal.fire({
                icon: "success",
                title: data.message || "Coupon removed successfully!",
                showConfirmButton: false,
                timer: 1000
              })
              document.getElementById('finalAmount').innerText = data.finalAmount;
              this.textContent = 'Apply';
              this.style.backgroundColor = '#104615';
              document.getElementById('discountAmount').innerText = '0';
              // fallback if undefined
              document.getElementById('coupon').value = ''; // Clear input field
              isApplied = false;
            })
            .catch((error) => {
              console.error('Error removing coupon:', error);
              Swal.fire("Failed to remove coupon");
            });
          return;
        }
        console.log(isApplied);

        // If not applied, apply the coupon
        fetch('/user/applyCoupon', {
          method: 'POST',
          headers: {
            "Content-Type": "application/json",

          },
          body: JSON.stringify({ code })
        })
          .then((res) => res.json())
          .then((data) => {

            if (data.success) {
              document.getElementById('discountAmount').innerText = data.discountAmount;
              document.getElementById('finalAmount').innerText = data.total;

              document.getElementById('coupon').value = code;
              Swal.fire({
                icon: "success",
                title: data.message,
                showConfirmButton: false,
                timer: 1000
              })
              this.textContent = 'Remove';
              this.style.backgroundColor = '#cc0000';
              isApplied = true;
            } else {
              Swal.fire(data.message)
              document.getElementById('coupon').value = '';
            }
          })
          .catch(error => {
            console.log('Error is', error);
            Swal.fire("Server Error");
          });
      });



      function openCouponModal() {
        console.log('showCoupons clicked');
        document.getElementById('couponModal').style.display = 'block'
      }

      function closeCouponModal() {
        document.getElementById('couponModal').style.display = 'none'
      }
      window.onclick = function (e) {
        const modal = document.getElementById('couponModal')
        if (e.target == modal) {
          modal.style.display = 'none'
        }
      }
      function copyCoupon(code) {
        navigator.clipboard.writeText(code).then(() => {
          Swal.fire({
            icon: "success",
            title: "Coupon code copied: ", code,
            showConfirmButton: false,
            timer: 1000
          })

        }).catch(err => {
          console.error("Copy failed: ", err);
          Swal.fire("Failed to copy coupon code.");
        });
      }

      function oppenAddressModal() {
        console.log('oppenAddressModal clicked');
        document.getElementById("modal-overlay").style.display = "flex";
      }

      function cancelAddressForm() {
        document.getElementById("modal-overlay").style.display = "none";
      }

      // Optional: Close modal on click outside the form
      window.onclick = function (e) {
        const modal = document.getElementById("modal-overlay");
        if (e.target === modal) {
          modal.style.display = "none";
        }
      };



      const addAddressForm = document.getElementById('addAddressForm')
      addAddressForm.addEventListener('submit', function (e) {
        e.preventDefault()
        console.log('addAddressForm submitted');
        const formData = new FormData(this)
        const formObject = Object.fromEntries(formData)
        console.log('form data', formObject);


        const label = formObject.label.trim()
        if (!label) {

          return Swal.fire("Label is required")

        }
        if (/^\d/.test(label)) {

          return Swal.fire("Label cannot start with numbers")
        }
        if (label.length < 3) {

          return Swal.fire("Label should contain  atleast 3 charectors")
        }
        const line1 = formObject.line1.trim()
        console.log("line1");

        if (!line1) {

          return Swal.fire('Address line cannot be empty')
        }
        if (/^\d/.test(line1) || /^\d/.test(formObject.line2)) {

          return Swal.fire("Address lines cannot start with numbers")
        }
        if (line1.length < 3) {

          return Swal.fire("AddressLine should contain atleast 3 charectors")
        }
        const city = formObject.city.trim()
        console.log("city");
        if (!city) {

          return Swal.fire('City cannot be empty')
        }
        if (/^\d/.test(city)) {

          return Swal.fire("City cannot start with numbers")
        }
        if (city.length < 3) {

          return Swal.fire("City should contain atleast 3 charectors")
        }
        const country = formObject.country.trim()
        console.log("country");
        if (!country) {

          return Swal.fire("Country Cannot be empty")
        }
        if (/^\d/.test(country)) {

          return Swal.fire("Country cannot start with numbers")
        }
        if (country.length < 3) {


          return Swal.fire("Country should contain atleast 3 charectors")
        }

        const state = formObject.state.trim()
        console.log("state");
        if (!state) {

          return Swal.fire("State Cannot be empty")
        }
        if (/^\d/.test(state)) {

          return Swal.fire("State cannot start with numbers")
        }
        if (state.length < 3) {

          return Swal.fire("State should contain atleast 3 charectors")
        }


        const post = formObject.zip.trim()
        console.log("post");
        if (!post) {

          return Swal.fire("Post Cannot be empty")
        }
        if (!/^\d+$/.test(post)) {

          return Swal.fire("Invalid post code")
        }
        const phone = formObject.phone.trim()
        if (!phone) {

          return Swal.fire("Phone Cannot be empty")
        }
        if (!/^\d+$/.test(phone)) {

          return Swal.fire("Invalid  phone number")
        }
        if (phone.length < 10) {
          return Swal.fire('invalid phone number')
        }

        fetch('/user/address/add', {
          method: "POST",
          headers: {
            "Content-Type": "application/json",

          },
          body: JSON.stringify(formObject)
        }).then(res => res.json())
          .then(data => {
            if (data && data.success) {
              Swal.fire({

                icon: "success",
                title: data.message,
                showConfirmButton: false,
                timer: 1000
              }).then(() => {
                addDiv(data.newAddress)
              })
              cancelAddressForm()
            } else {
              Swal.fire(data.message)
            }
          }).catch(error => {
            Swal.fire("Server Error")
          })
      })

      const contactForm = document.getElementById('contactForm')
      contactForm.addEventListener('submit', async function (e) {
        e.preventDefault()
        console.log('contactForm submitted');


        // Enable all inputs temporarily
        const inputs = this.querySelectorAll('input');
        inputs.forEach(input => input.disabled = false);

        const formData = new FormData(this)

        const formObject = Object.fromEntries(formData)
        console.log('form data', formObject);

        const email = formObject.email.trim()
        if (!email) {
          return Swal.fire("Email is required")
        }
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          Swal.fire('Please enter a valid email address!');

          return;
        }

        if (email.length < 5 || email.length > 254) {
          Swal.fire('Please enter a valid email');

          return;
        }

        const phone = formObject.phone.trim()
        console.log(phone);


        if (!phone) {
          return Swal.fire('Phone number is required')
        }
        const phoneRegex = /^\d+$/;
        if (!phoneRegex.test(phone)) {
          Swal.fire('Phone number must contain only digits.');

          return;
        }

        if (phone.length !== 10) {
          Swal.fire('Phone number must be exactly 10 digits.');

          return;
        }
        const fullName = formObject.fullName.trim()
        if (!fullName) {
          return Swal.fire("enter your fullname")
        }
        try {
          const response = await fetch('/user/profile/update', {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",

            },
            body: JSON.stringify(formObject)
          });

          const data = await response.json();

          if (data && data.success) {

            Swal.fire({
              icon: "success",
              title: data.message,
              showConfirmButton: false,
              timer: 1000
            }).then(() => {
              const toggleBtn = document.getElementById('toggleEditBtn');
              const submitBtn = document.getElementById('submitBtn');
              const inputs = document.querySelectorAll('#contactInfo input');

              // Disable all fields again
              inputs.forEach(input => input.disabled = true);

              // Reset button state
              toggleBtn.textContent = 'Edit';
              submitBtn.style.display = 'none';

              // Optional: reset the toggle flag
              isEditable = false;
            })

            if (data.newEmail) {
              console.log('new emial', data.newEmail);

              window.location.href = '/user/emailChangeOtp?redirectTo=/user/checkout'
            }
          } else {
            Swal.fire(data.message);
          }
        } catch (error) {
          Swal.fire('Something went wrong. Please try again.');
          console.error('Fetch error:', error);
        }
      })

      const cardInput = document.getElementById('cardnumber');
      cardInput.addEventListener('input', function () {
        this.value = this.value.replace(/[^\d\s]/g, '');
      });

      function addDiv(address) {
        const container = document.querySelector('.addresses-container')
        const index = container.querySelectorAll('.address-box').length;

        const html = `
    <div class="address-box" style="border: 1px solid #ccc; padding: 15px; width: 45%; position: relative;">
      <input type="radio" name="selectedAddress" value="${address._id}" id="address-${index}" style="position: absolute; top: 10px; right: 10px;">
      <label for="address-${index}">
        <p><strong>Label:</strong> ${address.label}</p>
        <p>${address.line1 || '-'}</p>
        <p>${address.city}</p>
        <p>${address.state}, ${address.country}</p>
        <p><strong>ZIP:</strong> ${address.zip}</p>
      </label>
    </div>
  `;

        // If "No saved addresses" message exists, remove it:
        const noAddress = container.querySelector('p');
        if (noAddress && noAddress.textContent.includes('No saved addresses')) {
          noAddress.remove();
        }

        // Append new box
        container.insertAdjacentHTML('beforeend', html);
      }


    </script>

