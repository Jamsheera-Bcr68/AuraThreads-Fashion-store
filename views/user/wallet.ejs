                            data-bs-target="#addFundsModal">
                            Add Funds
                        </button>

                       
                    </div>
                </div>

              
                    <div class="col-md-3  balance-card  summary-card">
                        <h4>Total Transactions</h4>
                        <p>
                            <%= wallet.transactions.length %>
                        </p>

                    </div>
                    <div class="col-md-3  balance-card summary-card">
