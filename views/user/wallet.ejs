</head>

<body>
    <%- include('../partials/userHeader') %>
        <div class="container">
            <div class="wallet-header">
                <h1 class="wallet-title">My Wallet</h1>
                <p class="wallet-subtitle">Manage your store credit, payment methods, and rewards</p>
            </div>

            <div class="tabs">
                <button class="tab-btn active" data-tab="overview">Overview</button>
              <a style="text-decoration: none; color: #8c4790;margin-top: 1em;" href="/user/transactions">Transactions</a>
                 <!-- <button class="tab-btn" data-tab="transactions">Transactions</button> -->

            </div>

            <!-- Overview Tab -->
            <div class=" tab-content active" id="overview">
                <!-- <div style="align-content: space-between;" class="row">
                 <div style="background-color: #eef8f5;"  class="col-md-3 mb-3 balance-card summary-card text-center">
                    <h3>Current Balance</h3>
