               </div>
                 -->

                <div class="summary-cards">
                    <div class="summary-card text-center">
                        <h3>Current Balance</h3>
                        <div class="balance-amount">₹ <span id="balance">
                                <%= wallet.balance %>
                            </span></div>
                        <div class="balance-actions">
                            <button style="background-color: #8c4790; color: white;" type="button" class="btn mt-2"
                                data-bs-toggle="modal" data-bs-target="#addFundsModal">
                                Add Funds
                            </button>
                        </div>
                    </div>

                    <div class="summary-card">
                        <h4>Total Transactions</h4>
                        <p>
                            <%= wallet.transactions.length %>
                        </p>
                    </div>

                    <div class="summary-card">
                        <h4>Total Debits</h4>
                        <p>
                            <%= debitLength %>
                        </p>
                    </div>

                    <div class="summary-card">
                        <h4>Total Credits</h4>
                        <p>
                            <%= creditLength %>
                        </p>
                    </div>
                </div>


                <div class="section-header mt-5 fw-bold">
                    <h3 style="color: #8c4790;">Recent Transactions</h3>
                    <a href="/user/transactions" class="view-all" >View All</a>
                </div>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentTransactions.forEach(tx=> { %>
                            <tr>
                                <td>
                                    <%= tx.date.toLocaleDateString() %>
                                </td>
                                <td>
                                    <%= tx.description %>
                                </td>
                                <td>
                                    <span
                                        style="background-color: <%= tx.type === 'debit' ? 'red' : 'green' %>; color: white;">
                                        <%= tx.type %>
                                    </span>
                                </td>
                                <td class="<%= tx.type === 'debit' ? 'amount-debit' : 'amount-credit' %>">
                                    <%= tx.amount %>
                                </td>
                            </tr>
                            <% }) %>

                    </tbody>
                </table>
            </div>

            <!-- Transactions Tab -->
            <div class="tab-content" id="transactions">
                <h3 class="section-header">Transaction History</h3>


                <table class="table">
                    <thead style="font-weight: bold;">
                        <tr>
                            <th>Date</th>
                            <th>Transaction Type</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% wallet.transactions.forEach(tr=> { %>
                            <tr>
                                <td>
                                    <%= tr.date.toLocaleDateString() %>
                                </td>
                                <td>
                                    <span
                                        style="background-color: <%= tr.type === 'debit' ? 'red' : 'green' %>; color: white;">
                                        <%= tr.type %>
                                    </span>
                                </td>
                                <td>
                                    <%= tr.description %>
                                </td>
                                <td><span class="status-badge status-completed">Completed</span></td>
                                <td class="<%= tr.type === 'debit' ? 'amount-debit' : 'amount-credit' %>">
                                    <%= tr.amount %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>


            </div>



        </div>


        <!-- Add Funds Modal -->
        <div style="z-index: 2000;margin-top: 14em;" class="modal fade" id="addFundsModal" tabindex="-1"
            aria-labelledby="addFundsModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="addFundsModalLabel">Add Funds</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <form id="addFundsForm">
                            <div class="mb-3">
                                <label for="amount" class="form-label">Enter Amount</label>
                                <input type="number" class="form-control" name="amount" id="amount"
                                    placeholder="Enter amount in ₹" min="1" required>
                            </div>
                        </form>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" form="addFundsForm" class="btn btn-primary">Add Funds</button>
                    </div>

                </div>
            </div>
        </div>

        <%- include('../partials/userFooter') %>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script>
               
                // Simple tab system
                document.addEventListener('DOMContentLoaded', function () {
                    const tabButtons = document.querySelectorAll('.tab-btn');
                    const tabContents = document.querySelectorAll('.tab-content');

                    tabButtons.forEach(button => {
                        button.addEventListener('click', () => {
                            // Remove active class from all buttons and contents
                            tabButtons.forEach(btn => btn.classList.remove('active'));
                            tabContents.forEach(content => content.classList.remove('active'));

                            // Add active class to clicked button and corresponding content
                            button.classList.add('active');
                            const tabId = button.getAttribute('data-tab');
                            document.getElementById(tabId).classList.add('active');
                        });
                    });

                    // Tab links within content
                    const tabLinks = document.querySelectorAll('[data-tab-link]');
                    tabLinks.forEach(link => {
                        link.addEventListener('click', (e) => {
                            e.preventDefault();
                            const tabId = link.getAttribute('data-tab-link');

                            // Activate corresponding tab
                            tabButtons.forEach(btn => {
                                if (btn.getAttribute('data-tab') === tabId) {
                                    btn.click();
                                }
                            });
                        });
                    });
                });

                const addmoneyForm = document.getElementById('addFundsModal')
                addmoneyForm.addEventListener('submit', function (e) {
                    e.preventDefault()
                    console.log('addFundsModal submitted');
                    let amount = document.getElementById('amount').value

                    if (amount === '') {
                        Swal.fire("Enter An Amount")
                    }
                    if (amount < 0) {
                        return Swal.fire("Enter a Valid Amount")
                    }
                    console.log('amount ', amount);

                    fetch('/user/wallet/addMoney', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                          
                        },
                        body: JSON.stringify({ amount })
                    }).then(res => res.json())
                        .then(data => {
                            if (data && data.success) {
                                console.log('balance', data.balance);

                                document.getElementById('balance').innerHTML = data.balance
                                Swal.fire({
                                    icon: "success",
                                    title: data.message,
                                    showConfirmButton: false,
                                    timer: 1000
                                })
                                document.getElementById('amount').value = ''
                                const modalEl = document.getElementById('addFundsModal');
                                const addFundsModal = bootstrap.Modal.getInstance(modalEl);
                                if (addFundsModal) {
                                    addFundsModal.hide();
                                }

                            } else {
                                Swal.fire(data.message)
                            }
                        }).catch(error => {
                            console.log('error is ', error);
                            Swal.fire("Server Error")
                        })
                })
            </script>
</body>

</html>