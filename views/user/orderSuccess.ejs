<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
  <style>
    .order-card {
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.05);
      border: none;
    }
    .success-icon {
      width: 80px;
      height: 80px;
      background-color: #dcf5e7;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .order-details {
      background-color: #f8f9fa;
      border-radius: 12px;
      padding: 20px;
    }
    .item-row {
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }
    .item-row:last-child {
      border-bottom: none;
    }
  </style>
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card order-card p-4 p-md-5">
          
          <!-- Success Header -->
          <div class="text-center mb-4">
            <div class="success-icon mx-auto">
              <i class="fas fa-check-circle text-success fa-3x"></i>
            </div>
            <h2 class="fw-bold mb-1">Order Confirmed!</h2>
            <p class="text-muted">Thank you for your purchase</p>
            <p class="text-success"> Expected Delivery Date : <%= order.deliveryDate.toDateString() %></p>
          </div>
          
          <!-- Order Summary -->
          <div class="order-details mb-4">
            <div class="row">
              <div class="col-sm-6 mb-3">
                <h6 class="text-muted mb-1">Order ID</h6>
                <p class="mb-0 fw-medium"><%= order._id %></p>
              </div>
              <div class="col-sm-6 mb-3">
                <h6 class="text-muted mb-1">Date</h6>
                <p class="mb-0"><%= order.createdAt.toDateString() %></p>
              </div>
              <div class="col-sm-6 mb-3">
                <h6 class="text-muted mb-1">Total Amount</h6>
                <p class="mb-0 fw-bold">₹ <%= order.orderTotal %></p>
               
              </div>
              <div class="col-sm-6 mb-3">
                <h6 class="text-muted mb-1">Payment Method</h6>
                <p class="mb-0"><%= order.paymentMethod %></p>
              </div>
            </div>
          </div>
          
          <!-- Shipping Address -->
          <div class="mb-4">
            <h5 class="fw-bold mb-3">Shipping Address</h5>
            <div class="card border-0 bg-light p-3">
              <p class="mb-0">
                <%= order.address.name %><br/>
                <%= order.address.street %>, <%= order.address.city %><br/>
                <%= order.address.state %> - <%= order.address.zip %><br/>
                <i class="fas fa-phone-alt me-1 small"></i> <%= order.address.phone %>
              </p>
            </div>
          </div>
          
          <!-- Order Items -->
          <div class="mb-4">
            <h5 class="fw-bold mb-3">Order Items</h5>
            <div class="card border-0 bg-light p-3">
              <% order.items.forEach(item => { %>
                <div class="item-row d-flex justify-content-between align-items-center">
                  <div>
                    <p class="mb-0 fw-medium"><%= item.productId.productName %></p>
                    <small class="text-muted">Qty: <%= item.quantity %></small>
                  </div>
                  <span class="fw-bold">₹ <%= parseInt( item.productId.price) * parseInt( item.quantity) %></span>
                </div>
              <% }) %>
              <div class="item-row d-flex justify-content-between align-items-center">
                <div>
                  <p class="mb-0 fw-medium">Total Amount</p>
                
                </div>
                <span class="fw-bold">₹ <%= order.totalAmount %></span>
              </div>
              <div class="item-row d-flex justify-content-between align-items-center">
                <div>
                  <p class="mb-0 fw-medium">Discount via Coupon</p>
                  
                </div>
                <span class="fw-bold">₹ <%= order.coupenDiscountAmount %></span>
              </div>
              <div class="item-row d-flex justify-content-between align-items-center">
                <div>
                  <p class="mb-0 fw-medium">Discount via Offer</p>
                  
                </div>
                <span class="fw-bold">₹ <%= order.offerDiscountAmount %></span>
              </div>
              
              <div class="item-row d-flex justify-content-between align-items-center">
                <div>
                  <p class="mb-0 fw-medium">Final Amount</p>
                  
                </div>
                <span class="fw-bold">₹ <%= order.finalAmount %></span>
              </div>
              <div class="item-row d-flex justify-content-between align-items-center">
                <div>
                  <p class="mb-0 fw-medium">Shipping Charge </p>
                  
                </div>
                <span class="fw-bold">₹ <%= order.shippingCharge %></span>
              </div>
              <div class="item-row d-flex justify-content-between align-items-center">
                <div>
                  <p class="mb-0 fw-medium">Net order Total </p>
                  
                </div>
                <span class="fw-bold">₹ <%= order.orderTotal %></span>
              </div>
            </div>
          </div>
          
          <!-- Actions -->
          <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-2">
            <a href="/user/orders" class="btn btn-primary px-4 py-2">
              <i class="fas fa-clipboard-list me-2"></i>View All Orders
            </a>
            <a href="/user/home" class="btn btn-outline-secondary px-4 py-2">
              <i class="fas fa-shopping-bag me-2"></i>Continue Shopping
            </a>
          </div>
          
        </div>
      </div>
    </div>
  </div>
</body>
</html>