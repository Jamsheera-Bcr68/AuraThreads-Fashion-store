          let editAddressId
          function editAddress(id, label, line1, line2, city, state, zip, country, phone, isDefault) {
            console.log('edit button clicked');
            editAddressId = id

            document.getElementById("edit-address-label").value = label;
            document.getElementById("edit-address-line1").value = line1;
            document.getElementById("edit-address-line2").value = line2 || '';
            document.getElementById("edit-address-city").value = city;
            document.getElementById("edit-address-state").value = state;
            document.getElementById("edit-address-zip").value = zip;
            document.getElementById("edit-address-country").value = country;
            document.getElementById("edit-address-phone").value = phone;

            // Handle checkbox for default address
            document.getElementById("edit-default").checked = isDefault;

            // Show modal

            console.log('edit modal about to open');

            const editModal = new bootstrap.Modal(document.getElementById('editAddressModal'));
            editModal.show();
          }

          // handle edit form submission
          const editAddressForm = document.getElementById('edit-address-form')
          editAddressForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            console.log('Edit form submitted');

            let formData = new FormData(this);
            let formObject = Object.fromEntries(formData)
            console.log(formObject);

            const label = formObject.label.trim()
            if (!label) {

              return Swal.fire("Label is required")

            }
            if (/^\d/.test(label)) {

              return Swal.fire("Label cannot start with numbers")
            }
            if (label.length < 3) {

              return Swal.fire("Label should contain  atleast 3 charectors")
            }

            const line1 = formObject.line1.trim()
            console.log("line1");

            if (!line1) {

              return Swal.fire('Address line cannot be empty')
            }
            if (/^\d/.test(line1) || /^\d/.test(formObject.line2)) {

              return Swal.fire("Address lines cannot start with numbers")
            }
            if (line1.length < 3) {

              return Swal.fire("AddressLine should contain atleast 3 charectors")
            }


            const city = formObject.city.trim()
            console.log("city");
            if (!city) {

              return Swal.fire('City cannot be empty')
            }
            if (/^\d/.test(city)) {

              return Swal.fire("City cannot start with numbers")
            }
            if (city.length < 3) {

              return Swal.fire("City should contain atleast 3 charectors")
            }

            const country = formObject.country.trim()
            console.log("country");
            if (!country) {

              return Swal.fire("Country Cannot be empty")
            }
            if (/^\d/.test(country)) {

              return Swal.fire("Country cannot start with numbers")
            }
            if (country.length < 3) {


              return Swal.fire("Country should contain atleast 3 charectors")
            }

            const state = formObject.state.trim()
            console.log("state");
            if (!state) {

              return Swal.fire("State Cannot be empty")
            }
            if (/^\d/.test(state)) {

              return Swal.fire("State cannot start with numbers")
            }
            if (state.length < 3) {

              return Swal.fire("State should contain atleast 3 charectors")
            }

            const post = formObject.zip.trim()
            console.log("post");
            if (!post) {

              return Swal.fire("Post Cannot be empty")
            }
            if (!/^\d+$/.test(post)) {

              return Swal.fire("Invalid post code")
            }


            if (formObject.phone.length < 10 || formObject.phone.length > 12) {

              return Swal.fire('Invalid mobile number')
            }
            if (!/^\d+$/.test(formObject.phone)) {

              return Swal.fire("Invalid mobile number")
            }


            fetch(`/user/address/edit/${editAddressId}`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                'CSRF-Token': csrfToken
              },
              body: JSON.stringify(formObject)
            }).then(response => response.json())
              .then(data => {
                if (data && data.success) {
                  Swal.fire({

                    icon: "success",
                    title: data.message,
                    showConfirmButton: false,
                    timer: 1000
                  })
                  const modalElement = document.getElementById('editAddressModal');
                  const editModal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
                  editModal.hide();
                } else {
                  Swal.fire(data.message)
                }
              }).catch(error => {
                console.log('error is', error);
                Swal.fire("Some thing went wrong")
              })

          })

          function deleteAddress(addressId) {
