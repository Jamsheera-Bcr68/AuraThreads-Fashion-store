<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Details</title>
  <link rel="stylesheet" href="/css/singleproduct.css" />
  <meta name="csrf-token" content="<%= csrfToken %>">  
  <base href="/" />
</head>

<body>


  <%- include('../partials/userHeader') %>
    <div class="container">
      <!-- Breadcrumbs -->
      <% singleProduct.reviews=['good', 'very good' , 'super' ] %>
        <%singleProduct.highlights=['good material', 'recent price' , 'longlasting' ] %>
          <% singleProduct.relatedProducts=[{ name: 'churidar' ,image: singleProduct.images[0] }] %>
            <% singleProduct.rating=5 %>

              <div class="breadcrumbs">
                <a href="/user/home">Home</a>
                <span><a href="#">
                    <%= singleProduct.categoryName %>
                  </a></span>
                <span><a href="#">
                    <%= singleProduct.productName %>
                  </a></span>
              </div>

              <div class="product-container">
                <!-- Product Gallery -->
                <div class="product-gallery">
                  <div class="main-image" id="mainImage">
                    <img src="<%= singleProduct.images[0] %>" alt="<%= singleProduct.productName %>"
                      id="productMainImage" />
                  </div>
                  <div class="thumbnails">
                    <% singleProduct.images.forEach((image, index)=> { %>
                      <div class="thumbnail" data-img="<%= image %>">
                        <img src="<%= image %>" alt="Image <%= index + 1 %>" />
                      </div>
                      <% }) %>
                  </div>
                </div>

                <!-- Product Info -->
                <div class="product-info">
                  <h1 class="product-title">
                    <%= singleProduct.productName %>
                  </h1>

                  <div class="rating-container">
                    <div class="rating-box ratings" id="product-rating">
                      <span class="rating-number">
                        <%= singleProduct.rating %>
                      </span>
                      <span class="rating-star">★</span>
                    </div>
                    <span class="review-count">(<%= singleProduct.reviews.length %> reviews)</span>
                  </div>

                  <!-- Price -->
                  <div class="price-container">
                    <span class="price">₹ <%= singleProduct.price %></span>
                    <span class="original-price">₹ 500.00</span>
                    <span class="discount-badge">Save 8%</span>
                  </div>

                  <!-- Coupon -->
                  <div class="coupon">
                    <p>
                      Apply coupon <span class="coupon-code">TECH15</span> at checkout
                      for an extra 15% off
                    </p>
                  </div>

                  <div class="stock <%= singleProduct.stock > 0 ? 'in-stock' : 'out-of-stock'%>">
                    <%= singleProduct.stock> 0 ? 'In Stock - Ships within 24 hours' :
                      'Out of stock ' %>
                  </div>
                  <!--Stock Status (Toggle between these divs based on inventory)-->
                  <!--  <div class="stock in-stock" id="inStock">
            In Stock - Ships within 24 hours
          </div>
          <div class="stock low-stock" id="lowStock" style="display: none">
            Low Stock - Only 2 left, order soon!
          </div>
          <div class="stock sold-out" id="soldOut" style="display: none">
            <%= singleProduct.stock > 0 ? 'In Stok' : 'Out Of Stock' %>
          </div>
       
          <!-- Error Banner (show only when needed) -->
                  <div class="error-banner" id="errorBanner" style="display: none">
                    <span class="icon">⚠️</span>
                    <div>
                      <strong>Out of Stock!</strong> This product is currently
                      unavailable. Please check back later or browse similar products.
                    </div>
                  </div>

                  <!-- Actions -->
                  <div class="product-actions">
                    <div class="quantity">

                      <button id="decreaseQty">-</button>
                      <input type="text" value="1" min="1" max="10" id="quantity">
                      <button data-productId="<%= singleProduct._id %>" data-max="<%= singleProduct.stock %>"
                        id="increaseQty">+</button>
                    </div>
                    <button class="add-to-cart" data-id="<%= singleProduct._id %>" id="addToCartBtn" style="width: 20%"
                      <%=singleProduct.stock===0 ? 'disabled' : '' %>>
                      <%= singleProduct.stock===0 ? 'Out of Stock' : 'Add to Cart' %>
                    </button>
                    <button class="buy-now" id="buyNowBtn" <%=singleProduct.stock===0 ? 'disabled' : '' %> ><a style="text-decoration: none; color: white;" href="/user/checkout">By Now</a></button>
                    <button class="btn btn-outline-danger" type="button"  onclick="addToWishlist('<%= singleProduct._id %>')">
                      <span style="font-size: 1.5rem;">♥</span>  Wishlist
                    </button>
                  </div>

                  <!-- Highlights -->
                  <div class="highlights">
                    <h3>Highlights</h3>
                    <ul>
                      <% singleProduct.highlights.forEach(highlight=> { %>
                        <li>
                          <%= highlight %>
                        </li>
                        <% }) %>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="specandreview product-container">
                <div class="specandReview">
                  <div class="tabs">
                    <div class="tab-header">
                      <button class="tab-button active" data-tab="reviews">
                        Reviews (<%= singleProduct.reviews.length %>)
                      </button>
                      <button class="tab-button" data-tab="details">Details</button>
                      <button class="tab-button" data-tab="shipping">
                        Shipping & Returns
                      </button>
                    </div>

                    <!--Reviews-->
                    <div class="tab-content active" id="reviews">
                      <div class="review">
                        <div class="review-header">
                          <div>
                            <span class="reviewer">John D.</span>
                            <div class="stars">★★★★★</div>
                          </div>
                          <div class="review-date">March 5, 2025</div>
                        </div>
                        <div class="review-text">
                          <p>
                            Absolutely love this dress! The meterial quality is
                            unbelievable. The cotton metreial is
                            actually useful for summer. good quality.
                          </p>
                        </div>
                      </div>

                      <div class="review">
                        <div class="review-header">
                          <div>
                            <span class="reviewer">Sarah M.</span>
                            <div class="stars">★★★★☆</div>
                          </div>
                          <div class="review-date">February 28, 2025</div>
                        </div>
                        <div class="review-text">
                          <p>
                            Great dress overall. The outfilt is beautiful and the meterial
                            looks amazing . Removing one star because it's a bit
                            heavy for my child and the price is still steep even with
                            the discount.
                          </p>
                        </div>
                      </div>

                      <div class="review">
                        <div class="review-header">
                          <div>
                            <span class="reviewer">Michael T.</span>
                            <div class="stars">★★★☆☆</div>
                          </div>
                          <div class="review-date">February 15, 2025</div>
                        </div>
                        <div class="review-text">
                          <p>
                            This is not comfortable for small babies under 3 years.
                          </p>
                        </div>
                      </div>
                    </div>

                    <!-- Details Tab -->
                    <div class="tab-content" id="details">
                      <h3>Product Description</h3>
                      <p>
                        <%= singleProduct.description %>
                      </p>

                      <h3>About this Sellers</h3>

                      <p>
                        [MAMTA_FASHION]This top is made of rib fabric. which is very soft and stretchable to wear which
                        you can carry with any jeans and which will give a great feel to your personality

                        Country of Origin : India

                        Country of Origin : India
                      </p>
                    </div>

                    <!-- Shipping Tab -->
                    <div class="tab-content" id="shipping">
                      <h3>Shipping Information</h3>
                      <p>
                        Free standard shipping on all orders over $50. Standard shipping
                        takes 3-5 business days. Express shipping (1-2 business days)
                        available for an additional fee.
                      </p>

                      <h3>Returns Policy</h3>
                      <p>
                        We accept returns within 30 days of delivery for a full refund
                        or exchange. Product must be in original, undamaged condition
                        with all original packaging and accessories. Return shipping
                        fees may apply unless the return is due to our error.
                      </p>
                    </div>
                  </div>

                  <!-- Specifications -->
                  <div class="specification">
                    <h3>Product Details</h3>
                    <table class="spec-table">
                      <tr>
                        <td>Name </td>
                        <td>
                          <%= singleProduct.productName %>
                        </td>
                      </tr>
                      <tr>
                        <td>Kurta Fabric</td>
                        <td>Rayon</td>
                      </tr>
                      <tr>
                        <td>size</td>
                        <td>small,medium,large,xl</td>
                      </tr>
                      <tr>
                        <td>Fabric </td>
                        <td>
                          No Dupatta
                        </td>
                      </tr>
                    </table>
                  </div>
                </div>
              </div>
    </div>
    <div class="site-section block-3 site-blocks-2 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-7 site-section-heading text-center pt-4">
            <h2>Related Products</h2>
          </div>
        </div>
        <div class="row product-container">
          <div class="col-md-12">
            <div class="nonloop-block-3 owl-carousel">
              <% relatedProducts.forEach(product=> { %>
                <div class="item">
                  <div class="block-4 text-center">
                    <figure class="block-4-image">
                      <a href="/user/products/<%= product._id %>">
                        <img src="/uploads/<%= product.images[0].split('/').pop() %>" alt="Image placeholder"
                          class="img-fluid">
                      </a>
                    </figure>
                    <div class="block-4-text p-4">
                      <h3><a href="#">
                          <%= product.productName %>
                        </a></h3>
                      <p class="mb-0">
                        <%= product.description %>
                      </p>
                      <p class="text-primary font-weight-bold">
                        $<%= product.price %>
                      </p>
                    </div>
                  </div>
                </div>
                <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/userFooter') %>

