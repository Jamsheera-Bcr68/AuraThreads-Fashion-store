return ,cancel <button>

                                 <% if (item.status==='cancelled' ) { %>
                                    <button class="" style="background-color: grey; color: white;"
                                        disabled>Cancelled</button>
                            
                                        <% } else if(item.status==='returned'){ %>
                                           <button class="" style="background-color: grey; color: white;"
                                        disabled>Returned</button>
                                        <% } else { %>
                                        <button
                                            onclick="cancelSingleProduct('<%= item.productId._id %>', '<%= order._id %>')"
                                            class="orderCancel">Cancel</button>
                                        <button id="returnBtn" data-productid="<%= item.productId._id %>" data-orderid="<%= order._id %>" class="returnProduct"
                                       >Return
                                        </button>
                                    
                                            <% } %>

</button>