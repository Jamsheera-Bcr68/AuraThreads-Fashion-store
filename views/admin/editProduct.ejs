<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Edit Product</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>
    <div class="container ">
        <%- include('../partials/header.ejs') %>
            <div class="d-flex" id="wrapper">
                <%- include('../partials/sidebar') %>
                    <div class="container mt-4 ms-2">
                        <h2 class="text-center fw-bold">Edit Product</h2>
                        <form id="editForm" action="/product/products/edit/<%=product._id %>" method="POST"
                            enctype="multipart/form-data" class="form-container">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Product Name</label>
                                        <input type="text" class="form-control" name="productName"
                                            value="<%= product.productName %>" required>
                                    </div>
                                    <input type="hidden" name="productId" value="<%= product._id %>">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Category</label>
                                            <select class="form-select" name="categoryId" required>
                                                <option disabled>Select Category</option>
                                                <% categories.forEach(category=> { %>
                                                    <option value="<%= category._id %>"
                                                        <%=category._id.toString()===product.categoryId.toString()
                                                        ? 'selected' : '' %>>
                                                        <%= category.categoryName %>
                                                    </option>
                                                    <% }) %>
                                            </select>

                                        </div>
                                        <% variants.forEach(variant=> { %>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Stock</label>
                                                <input type="number" name="stock" class="form-control"
                                                    value="<%= variant.stock %>" min="0"  required>
                                            </div>

                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Brand</label>
                                            <input type="text" class="form-control" name="brand"
                                                value="<%= product.brand %>">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Price (₹ )</label>
                                            <input type="number" class="form-control" name="price"
                                                value="<%= product.price %>" min="0" required>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div id="colorSelect" class="col-md-6 mb-3">
                                            <label class="form-label">Color</label>
                                           <select class="form-select" name="color" required>
      <option value="">Select Color</option>
      <option value="red" <%= variant?.color === 'red' ? 'selected' : '' %>>Red</option>
      <option value="blue" <%= variant?.color === 'blue' ? 'selected' : '' %>>Blue</option>
      <option value="black" <%= variant?.color === 'black' ? 'selected' : '' %>>Black</option>
      <option value="white" <%= variant?.color === 'white' ? 'selected' : '' %>>White</option>
      <option value="orange" <%= variant?.color === 'orange' ? 'selected' : '' %>>Orange</option>
      <option value="peach" <%= variant?.color === 'peach' ? 'selected' : '' %>>Peach</option>
      <option value="green" <%= variant?.color === 'green' ? 'selected' : '' %>>Green</option>
      <option value="yellow" <%= variant?.color === 'yellow' ? 'selected' : '' %>>Yellow</option>
    </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Size</label>
                                            <select class="form-select" name="size" required>
      <option value="">Select Size</option>
      <option value="S" <%= variant?.size === 'S' ? 'selected' : '' %>>Small</option>
      <option value="M" <%= variant?.size === 'M' ? 'selected' : '' %>>Medium</option>
      <option value="L" <%= variant?.size === 'L' ? 'selected' : '' %>>Large</option>
      <option value="XL" <%= variant?.size === 'XL' ? 'selected' : '' %>>Extra Large</option>
      <option value="FS" <%= variant?.size === 'FS' ? 'selected' : '' %>>Free Size</option>
    </select>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        <textarea class="form-control" name="description"
                                            rows="3"><%= product.description %></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Selected Images</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <% if (variant?.images && variant.images.length> 0) { %>
                                                <% variant.images.forEach(image=> { %>
                                                    <img src="<%= image %>" alt="Product Image"
                                                        style="width: 80px; height: auto; border-radius: 4px;" />
                                                    <% }) %>
                                                        <% } else { %>
                                                            <p>No images available</p>
                                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="mb-3">

                                        <label class="form-label">Upload Images</label>
                                        <input type="file" class="form-control" name="images" multiple accept="image/*">
                                    </div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="form-check me-3">
                                            <input class="form-check-input" type="checkbox" name="isListed" value="true"
                                                <%=product.isListed ? 'checked' : '' %>>
                                            <label class="form-check-label">List this product</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="isActive" value="true"
                                                <%=product.isActive ? 'checked' : '' %>>
                                            <label class="form-check-label">Set as Active</label>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <div class="d-flex justify-content-end">
                                            <button type="reset" class="btn btn-secondary me-2"><a
                                                    style="text-decoration: none;color: white;"
                                                    href="/product/products">Cancel</a></button>
                                            <button id="updateProductButton" type="submit"
                                                class="btn btn-primary">Update
                                                Product</button>
                                        </div>
                                </div>
                            </div>
                        </form>
                    </div>
            </div>
            <%- include('../partials/footer.ejs') %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const editForm = document.getElementById('editForm')
        editForm.addEventListener('submit', function (e) {
            e.preventDefault()
            console.log('edit form submitted');
            const formData = new FormData(this)

            const images = formData.getAll('images');
            console.log('Images:', images);

            if (images.length > 5) {
                return Swal.fire({
                    icon: 'error',

                    text: "you can upload only upto 5 images"
                });
            }
            const formObject = Object.fromEntries(formData);
            console.log(formObject);

            const productName = formObject.productName.trim();
            console.log(productName);

            if (!productName) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Product Name cannot be empty"
                });
            }

            if (productName.length < 3) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Product Name should contain at least 3 letters"
                });
            }

            if (productName.length > 20) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Product Name should not contain more than 20 letters"
                });
            }

            if (/^\d/.test(productName)) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Product Name should not start with numbers"
                });
            }

            const stock = Number(formObject.stock);
            if (isNaN(stock) || stock < 0) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Stock cannot be less than zero"
                });
            }

            if (!formObject.stock) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Stock cannot be empty"
                });
            }

            const price = Number(formObject.price);
            if (isNaN(price) || price === 0) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Price cannot be zero"
                });
            }
            const productId = formObject.productId

            if (price < 0) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Price cannot be less than zero"
                })
            }
            if (price > 10000) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "Price cannot be greater than 10000"
                })
            }


            fetch(`/product/products/edit/${productId}`, {
                method: 'POST',

                body: formData,

            }).then(res => res.json())
                .then(data => {
                    if (data && data.success) {
                        Swal.fire({
                            icon: "success",
                            title: 'Product Updated Successfully ',
                            showConfirmButton: false,
                            timer: 1000
                        })
                        window.location.href = '/product/products'
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: data.message,
                            showConfirmButton: false,
                            timer: 1000
                        })
                    }
                }).catch(err => {
                    Swal.fire('Server Error')
                })
        })

    </script>
</body>

</html>