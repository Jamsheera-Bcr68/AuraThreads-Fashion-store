<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Offer Management</title>
    <link rel="stylesheet" href="/css/offers.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <%- include('../partials/header.ejs') %>
        <div class="d-flex" id="wrapper">

            <div class="container">
                <!-- Sidebar -->
                <%- include('../partials/sidebar') %>

                    <!-- Main Content -->
                    <div class="main-content">
                        <!-- Header -->
                        <div class="page-title">
                            <h1>Offer Management Dashboard</h1>
                        </div>

                        <!-- Stats Section -->
                        <div class="stats">
                            <div class="stat-card">
                                <h3>Total Offers</h3>
                                <p>
                                    <%= stats.totalOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Active Offers</h3>
                                <p>
                                    <%= stats.activeOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Pending Approval</h3>
                                <p>
                                    <%= stats.pendingOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Expired Offers</h3>
                                <p>
                                    <%= stats.expiredOffers %>
                                </p>
                            </div>
                        </div>

                        <!-- Offers Section -->
                        <div class="offers-section">

                            <div class="section-header">
                                <h2 class="section-title"><a href="/admin/offers">All Offers</a></h2>
                                <h2><a href="/admin/referalOffers">Referral</a></h2>
                                <button class="btn btn-primary" id="referralOfferbtn" data-bs-toggle="modal"
                                    data-bs-target="#referralModal"><i class="fas fa-plus"></i>Add Referral
                                    Offer</button>
                            </div>
                            <div class="table-wrapper">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>ID</th>
                                            <th>Bonus Amount</th>
                                            <th>Minimun order</th>
                                            <th>Reward Type</th>
                                            <th>Status</th>

                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% offers.forEach(function(offer,index) { %>
                                            <tr>
                                                <td>
                                                    <%= index+1 %>
                                                </td>
                                                <td>OFF<%= offer.id.slice(-4) %>
                                                </td>
                                                <td>
                                                    <%= offer.bonusAmount %>
                                                </td>
                                                <td>
                                                    <%= offer.minOrderAmount %>
                                                </td>
                                                <td>
                                                    <%= offer.rewardType %>

                                                </td>

                                                <td>
                                                    <span class="status status-<%= offer.status.toLowerCase() %>">
                                                        <%= offer.status %>
                                                    </span>
                                                </td>
                                                <td class="action-cell">
                                                    <button data-id="<%= offer._id %>"
                                                        class="btn btn-warning action-btn edit-btn"><i
                                                            class="fas fa-edit"></i></button>
                                                            <button 
                                                            data-id="<%= offer._id %>" 
                                                            class="btn btn-danger action-btn delete-btn <%= offer.status === 'inactive' ? 'disabled' : '' %>">
                                                            <i class="fas fa-trash-alt"></i>
                                                          </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            </div>


        </div>
        <!--Pagination-->

        <%- include('../partials/footer.ejs') %>



            <!-- Delete Confirmation Modal -->
            <div class="modal" id="deleteModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2>Confirm Delete</h2>
                        <button class="close">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this offer? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-warning" id="cancelDeleteBtn">Cancel</button>
                        <button class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>
            <!--add refferal offer modal-->
            <!-- Referral Offer Modal -->
            <div class="modal fade" id="referralModal" tabindex="-1" aria-labelledby="referralModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <form id="refferalForm" action="/admin/addrefferalOffer" method="POST">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="referralModalLabel">Add Referral Offer</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="bonusAmount" class="form-label">Referral Bonus (₹)</label>
                                    <input type="number" class="form-control" name="bonusAmount" id="bonusAmount"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label for="minOrderAmount" class="form-label">Minimum Order Amount to Qualify
                                        (₹)</label>
                                    <input type="number" class="form-control" name="minOrderAmount" id="minOrderAmount"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label for="rewardType" class="form-label">Reward Type</label>
                                    <select class="form-select" name="rewardType" id="rewardType" required>
                                        <option value="wallet">Wallet Credit</option>
                                        <option value="discount">Discount Coupon</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="status" class="form-label">Referral Status</label>
                                    <select class="form-select" name="status" id="status" required>
                                        <option value="enabled">Enabled</option>
                                        <option value="disabled">Disabled</option>
                                    </select>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success">Save</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Edit Referral Modal -->
            <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <form id="editReferralForm" action="/admin/editReferralOffer" method="POST">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="editModalLabel">Edit Referral Offer</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <!-- Hidden input for offer ID -->
                                <input type="hidden" id="editOfferId" name="offerId" value="">

                                <div class="mb-3">
                                    <label for="editBonusAmount" class="form-label">Referral Bonus (₹)</label>
                                    <input type="number" id="editBonusAmount" name="bonusAmount" class="form-control"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label for="editMinOrderAmount" class="form-label">Minimum Order Amount to Qualify
                                        (₹)</label>
                                    <input type="number" id="editMinOrderAmount" name="minOrderAmount"
                                        class="form-control" required>
                                </div>

                                <div class="mb-3">
                                    <label for="editRewardType" class="form-label">Reward Type</label>
                                    <select id="editRewardType" name="rewardType" class="form-select" required>
                                        <option value="wallet">Wallet Credit</option>
                                        <option value="discount">Discount Coupon</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="editStatus" class="form-label">Referral Status</label>
                                    <select id="editStatus" name="status" class="form-select" required>
                                        <option value="enabled">Enabled</option>
                                        <option value="disabled">Disabled</option>
                                    </select>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success">Update</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>


            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                const addOfferBtn = document.getElementById('addOfferBtn');
                const offerModal = document.getElementById('offerModal');
                const deleteModal = document.getElementById('deleteModal');
                const modalTitle = document.getElementById('modalTitle');
                const closeButtons = document.querySelectorAll('.close');
                const cancelBtn = document.getElementById('cancelBtn');
                const saveOfferBtn = document.getElementById('saveOfferBtn');
                const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
                const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
                //DELETEING OFFER
                const deleteBtns = document.querySelectorAll('.delete-btn');
                deleteBtns.forEach(button => button.addEventListener('click', function () {
                    console.log('delete button clcked');
                    const offerId = button.dataset.id
                    console.log('offer id', offerId);
                    Swal.fire({
                        title: "Are you sure?",
                        text: "You won't be able to revert this!",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#3085d6",
                        cancelButtonColor: "#d33",
                        confirmButtonText: "Yes, delete it!"
                    }).then((result) => {
                        if (result.isConfirmed) {

                            fetch(`/admin/refferalOffer/delete/${offerId}`, {
                                method: "DELETE"
                            }).then(res => res.json())
                                .then(data => {
                                    if (data && data.success) {
                                        Swal.fire({
                                            title: "Deleted!",
                                            text: "Your file has been deleted.",
                                            icon: "success"
                                        });
                                    } else {
                                        Swal.fire(data.message)
                                    }
                                }).catch(error => {
                                    Swal.fire("Server error")
                                    console.log('error', error);

                                })


                        }
                    });
                }))

                //CREATEING NEW OFFER
                const refferalForm = document.getElementById('refferalForm')
                refferalForm.addEventListener('submit', function (e) {
                    e.preventDefault()
                    console.log('refferalForm submited');
                    const formData = new FormData(this)
                    const formObject = Object.fromEntries(formData)
                    console.log('formObject ', formObject);

                    // Store a reference to the modal before the fetch call
                    const referralModal = bootstrap.Modal.getInstance(document.getElementById('referralModal'));

                    fetch('/admin/addrefferalOffer', {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(formObject)
                    }).then(res => res.json())
                        .then(data => {
                            if (data && data.success) {
                                Swal.fire(data.message)
                                // Use the stored modal reference to hide
                                referralModal.hide();
                            } else {
                                Swal.fire(data.message || "An error occurred")
                            }
                        }).catch(error => {
                            Swal.fire("Server Error")
                            referralModal.hide()
                        })
                })
                // Close modals
                closeButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        offerModal.classList.remove('active');
                        deleteModal.classList.remove('active');
                        document.getElementById('wrapper').removeAttribute('inert'); // Optional: in case modal is closed via close button
                    });
                });

                // Cancel delete
                cancelDeleteBtn.addEventListener('click', () => {
                    deleteModal.classList.remove('active');
                });

                // Helper to format date for input
                function formatDateForInput(dateStr) {
                    const parts = dateStr.split('/');
                    return `${parts[2]}-${parts[1]}-${parts[0]}`;
                }

                //edit offer
                let offerId;
                const editBtns = document.querySelectorAll('.edit-btn')
                editBtns.forEach(button => button.addEventListener('click', function () {
                    const editModal = document.getElementById('editModal')
                    const modal = new bootstrap.Modal(editModal);
                    console.log('edit button clicked');
                    modal.show()
                     offerId=button.dataset.id
                    console.log('offer id ',offerId);
                    
                    fetch(`/admin/getSinglerefferal/${offerId}`, {
                        method: "GET"
                    }).then(res=>res.json())
                        .then(data => {
                            if (data && data.success&&data.offer) {
                                // Set values in the form
                                document.getElementById('editOfferId').value = data.offer.offerId;
                                document.getElementById('editBonusAmount').value = data.offer.bonusAmount;
                                document.getElementById('editMinOrderAmount').value = data.offer.minOrderAmount;
                                document.getElementById('editRewardType').value = data.offer.rewardType;
                                document.getElementById('editStatus').value = data.offer.status;
                            }
                        })
                }))
                
                const editRefferralForm=document.getElementById('editReferralForm')
                editReferralForm.addEventListener('submit',function(e){
                    e.preventDefault()
                    console.log('editReferralForm submitted');
                    
                    const formData=new FormData(this)
                    const formObject=Object.fromEntries(formData)

                    fetch(`/admin/editReferralForm/${offerId}`,{
                        method:'POST',
                        headers:{"Content-Type":"application/json"},
                        body:JSON.stringify(formObject)
                    }).then(res=>res.json())
                    .then(data=>{
                        if(data && data.success){
                            Swal.fire(data.message)
                        }else{
                            Swal.fire(data.message)
                        }
                    }).catch(error=>{
                        Swal.fire("Server Error")
                    })
                })
            </script>

</body>

</html>