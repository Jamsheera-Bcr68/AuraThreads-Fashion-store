    document.addEventListener('DOMContentLoaded', function () {
      const imageInput = document.getElementById('imageInput');
      const previewContainer = document.getElementById('previewContainer');
      const cropButton = document.getElementById('cropButton');

      const categoryForm = document.getElementById('categoryForm');
      const uploadedImagesInput = document.getElementById('uploadedImagesInput');
      let cropInstances = {};
      let uploadedImagePaths = []; // Store uploaded image paths

      imageInput.addEventListener('change', function (event) {
        // Clear previous previews and crop instances

        document.getElementById('cropButton').style.display = 'block'
        previewContainer.innerHTML = '';
        cropInstances = {};
        uploadedImagePaths = [];

        // Create preview for each selected image
        Array.from(event.target.files).forEach((file, index) => {
          const reader = new FileReader();

          reader.onload = function (e) {
            // Create container for each image
            const imageContainer = document.createElement('div');
            imageContainer.style.position = 'relative';
            imageContainer.style.margin = '10px';
            imageContainer.style.width = '200px';

            // Create image element
            const img = document.createElement('img');
            img.src = e.target.result;
            img.style.maxWidth = '100%';
            img.style.maxHeight = '200px';
            img.style.objectFit = 'contain';
            img.setAttribute('data-index', index);

            // Create remove button
            const removeButton = document.createElement('button');
            removeButton.innerHTML = '×';
            removeButton.style.position = 'absolute';
            removeButton.style.top = '0';
            removeButton.style.right = '0';
            removeButton.style.backgroundColor = 'red';
            removeButton.style.color = 'white';
            removeButton.style.border = 'none';
            removeButton.style.borderRadius = '50%';
            removeButton.style.width = '25px';
            removeButton.style.height = '25px';
            removeButton.style.cursor = 'pointer';

            removeButton.addEventListener('click', () => {
              // Remove the image from preview and crop instances
              imageContainer.remove();
              delete cropInstances[index];

              // Update file input to remove the specific file
              const filesArray = Array.from(imageInput.files);
              filesArray.splice(index, 1);

              // Recreate FileList
              const dataTransfer = new DataTransfer();
              filesArray.forEach(file => dataTransfer.items.add(file));
              imageInput.files = dataTransfer.files;
            });

            // Append image and remove button to container
            imageContainer.appendChild(img);
            imageContainer.appendChild(removeButton);

            // Add to preview container
            previewContainer.appendChild(imageContainer);

            // Initialize Cropper for each image
            const cropper = new Cropper(img, {
              aspectRatio: 3 / 4, // Square crop
              viewMode: 2,
              guides: true,
              background: false
            });

            // Store cropper instance
            cropInstances[index] = cropper;
          };

          // Read the file
          reader.readAsDataURL(file);
        });
      });

      cropButton.addEventListener('click', function () {
        if (Object.keys(cropInstances).length === 0) {
          Swal.fire("No images selected!", "Please select an image before cropping and uploading.", "warning");
          return;
        }

        let uploadPromises = [];
        uploadedImagePaths = []; // Reset before new uploads

        Object.keys(cropInstances).forEach(index => {
          const cropper = cropInstances[index];
          if (cropper) {
            uploadPromises.push(new Promise((resolve, reject) => {
              cropper.getCroppedCanvas().toBlob((blob) => {
                if (!blob) {
                  reject("Failed to get cropped image.");
                  return;
                }

                const formData = new FormData();
                formData.append('image', blob, `cropped-image-${index}.jpg`);
                console.log('send img to back');

                fetch('/admin/upload', {
                  method: 'POST',
                  body: formData
                })
                  .then(response => response.json())
                  .then(data => {
                    console.log('came from bacekend', data.filePaths);

                    if (data.filePaths && data.filePaths.length > 0) {
                      uploadedImagePaths.push(...data.filePaths);

                      const uploadedImageURL = data.filePaths[0];
                      // Find the image element using data-index
                      const img = document.querySelector(`img[data-index="${index}"]`);
                      if (img) {
                        // Destroy the cropper instance
                        cropInstances[index].destroy();
                        delete cropInstances[index];
                        // Replace the src with uploaded image URL (from backend)
                        img.src = uploadedImageURL;
                        img.style.border = '2px solid #28a745'; // Optional: add a border to show it's uploaded
                      }


                      resolve();
                    } else {
                      reject('Upload failed');
                    }
                  })
                  .catch(error => reject(error));
              });
            }));
          }
        });

        if (uploadPromises.length === 0) {
          Swal.fire("No images to upload!", "Please select an image and try again.", "info");
          return;
        }

        Promise.all(uploadPromises)
          .then(() => {
            Swal.fire({
              icon: "success",
              title: 'image uploaded ',
              showConfirmButton: false,
              timer: 1000
            }).then(()=>{
               document.getElementById('cropButton').style.display = 'none'
            })
            console.log('uploadedImagesInput', uploadedImagesInput);
            console.log('uploadedImagePaths', uploadedImagePaths);

            // Update hidden input with uploaded image paths
            if (uploadedImagesInput) {
              uploadedImagesInput.value = JSON.stringify(uploadedImagePaths);
            }
            console.log('Uploaded image paths:', uploadedImagePaths);
          })
          .catch(error => {
            console.error('Error uploading images:', error);
            Swal.fire("Upload Error", "Failed to upload images.", "error");
          });
      });

      //form submit event listener
      categoryForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        console.log('from category submit form');


        // Check if images have been uploaded
        const storedImagePaths = uploadedImagesInput.value;
        const fileInputImages = imageInput.files;

        if (!storedImagePaths && fileInputImages.length === 0) {
          Swal.fire("Image Upload Required", "Please upload images before adding the product.", "warning");
          return;
        }

        const formData = new FormData(this);

        // Log all form data entries for debugging
        console.log('Form Data Entries:');
        for (let [key, value] of formData.entries()) {
          console.log(`${key}: ${value}`);
        }
        const categoryName = formData.get('categoryName').trim()
        console.log(categoryName);
        if (!categoryName) {
          return Swal.fire({
            icon: 'error',
            title: 'Error',
            text: "Category Name cannot be empty"
          })
        }
        if (categoryName.length < 3) {
          return Swal.fire({
            icon: 'error',
            title: 'Error',
            text: "Category Name Should contain at least 3 letters"
          })
        }
        if (categoryName.length > 20) {
          return Swal.fire({
            icon: 'error',
            title: 'Error',
            text: "Category Name Should not contain more than 20 letters"
          })
        }
        if (/^\d/.test(categoryName)) {
          return Swal.fire({
            icon: 'error',
            title: 'Error',
            text: "Category Name Should not sart with numbers"
          })
        }
        if(/^[^a-zA-Z]/.test(categoryName)) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: "Category Name should start with a letter"
          });
          return;
        }

        try {
          const response = await fetch("/admin/category/add", {
            method: "POST",
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            console.log('result.newCategory', result.newCategory);

            const category = result.newCategory
            const newRow = document.createElement('tr')
            rowId = `row-${result.newCategory._id}`

            const newRowHtml = `
            <tr id=${rowId}>
              <td>#CAT${category._id.slice(-6)}</td>
              <td>${category.categoryName}</td>
              
               
              <td><img class="catImg" src="${category.images[0]}" alt=""></td>
              <td>${category.description}</td>
              <td>${category.isListed}</td>
              <td>
        <button class="btn btn-warning btn-sm"
         onclick="openEditModal(
        '${category._id}',
        \`${category.categoryName}\`,
        \`${category.description}\`,
        '${category.isListed}',
        '${category.images[0]}'
      )">
          Edit
        </button>
        <button onclick="deleteCategory('${category._id}')" class="btn btn-danger btn-sm">
          Delete
        </button>
      </td>
      </tr>
            `
            const tableBody = document.querySelector('tbody');
            tableBody.insertAdjacentHTML('afterbegin', newRowHtml);


            Swal.fire({
              icon: "success",
              title: 'Category Added Successfully ',
              showConfirmButton: false,
              timer: 1000
            }).then(() => {
              // Reset form and preview
              categoryForm.reset();
              previewContainer.innerHTML = '';
              uploadedImagePaths = [];
              uploadedImagesInput.value = '';

              const addCategoryModal = bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'));
              if (addCategoryModal) addCategoryModal.hide();
            });



          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: result.message || 'Failed to add Category'
            });
          }
        } catch (error) {
          console.error("Error submitting form:", error);
          Swal.fire({
            icon: 'error',
            title: 'Submission Error',
            text: 'An unexpected error occurred'
          });
        }
      });

    });


    function deleteCategory(id) {
      console.log("from delete cATEGORY SCRIPT", id);

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/admin/category/delete/${id}`, {
            method: "DELETE",

          }).then(res => res.json())
            .then(data => {
              if (data && data.success) {
                Swal.fire({

                  icon: "success",
                  title: data.message,
                  showConfirmButton: false,
                  timer: 1000
                })
                document.getElementById(`row-${id}`).remove()
              } else {
                Swal.fire(data.message)
                document.getElementById('addCategoryModal').style.display = 'none'
              }
            }).catch(error => {
              Swal.fire(data.message)
              document.getElementById('addCategoryModal').style.display = 'none'
            })
        }
      });
    }

    //edit
    let editCategoryId = '';
    function openEditModal(id, categoryName, description, isListed, imagePath) {
      console.log('image path', imagePath);

      console.log("from edit script");

      editCategoryId = id
      document.getElementById("editCategoryName").value = categoryName;
      document.getElementById("editCategoryDescription").value = description;

      const checkbox = document.getElementById("editCategoryIsListed");
      checkbox.checked = isListed === "true" || isListed === true;
      document.getElementById('editCategoryImagePreview').src = imagePath;


      document.getElementById(
        "editCategoryForm"
      ).action = `/admin/category/edit/${id}`;

      var editModal = new bootstrap.Modal(
        document.getElementById("editCategoryModal")
      );
      editModal.show();


    }

    const editForm = document.getElementById('editCategoryForm');

    editForm.addEventListener('submit', function (e) {
      e.preventDefault();
      console.log('Edit category form submitted');
      console.log('editCategoryId', editCategoryId);
      const formData = new FormData(this);
      const formObject = Object.fromEntries(formData);


      formObject.isListed = formData.get('isListed') === 'on';
      console.log('formObject.isListed', formObject.isListed);

      const categoryName = formData.get('categoryName').trim();

      // VALIDATIONS
      if (!categoryName) {
        return Swal.fire({
          icon: "error",
          title: "Category name cannot be empty!",
          showConfirmButton: false,
          timer: 1000
        });
      }

      if (/^\d/.test(categoryName)) {
        return Swal.fire({
          icon: "error",
          title: "Category name cannot start with a number!",
          showConfirmButton: false,
          timer: 1000
        });
      }

      if (categoryName.length > 20) {
        return Swal.fire({
          icon: "error",
          title: "Category name must be at most 20 characters",
          showConfirmButton: false,
          timer: 1000
        });
      }

      if (categoryName.length < 3) {
        return Swal.fire({
          icon: "error",
          title: "Category name must be at least 3 characters",
          showConfirmButton: false,
          timer: 1000
        });
      }
      if (/^[^a-zA-Z]/.test(categoryName)) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: "Category Name should start with a letter"
        });
        return;
      }

      console.log('editCategoryId', editCategoryId)

      // SUBMIT
      fetch(`/admin/category/edit/${editCategoryId}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(formObject)
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            const category = data.existCategory
            const row = document.getElementById(`row-${editCategoryId}`)
            row.innerHTML = `
        <td>#CAT${category._id.slice(-6)}</td>
        <td>${category.categoryName}</td>
        <td><img class="catImg" src="${category.images[0]}" alt=""></td>
        <td>${category.description}</td>
        <td>${category.isListed}</td>
        <td>
          <button class="btn btn-warning btn-sm"
            onclick="openEditModal('${category._id}', \`${category.categoryName}\`, \`${category.description}\`, '${category.isListed}', '${category.images[0]}')">
            Edit
          </button>
          <button onclick="deleteCategory('${category._id}')" class="btn btn-danger btn-sm">
            Delete
          </button>
        </td>
      `;

            Swal.fire({
              icon: "success",
              title: data.message,
              showConfirmButton: false,
              timer: 1000
            }).then(() => {
              const editModalEl = document.getElementById("editCategoryModal");
              const editModal = bootstrap.Modal.getInstance(editModalEl); // ✅ Get the existing instance
              if (editModal) editModal.hide();



            });
          } else {
            Swal.fire({
              icon: "error",
              title: data.message || "Update failed",
              showConfirmButton: false,
              timer: 1000
            });
          }
        })
        .catch(err => {
          console.error("Error submitting edit form:", err);
          Swal.fire({
            icon: "error",
            title:data.message|| "Something went wrong!",
            showConfirmButton: false,
            timer: 1000
          })
        })
    })
  </script>


