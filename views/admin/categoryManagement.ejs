<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
    <title>Admin - Category Management</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
  <body>
   

    <div class="container ">
      <%- include('../partials/header.ejs') %>

      <div class="d-flex" id="wrapper">
        <%- include('../partials/sidebar') %>

        <div class="container mt-4">
          <h2 class="text-center fw-bold mb-4">Category Management</h2>
          <% if (successMessage.length > 0) { %>
            <div class="alert alert-success"><%= successMessage %></div>
        <% } %>
        
        <% if (errorMessage.length > 0) { %>
            <div class="alert alert-danger"><%= errorMessage %></div>
        <% } %> 
        
        <div class="searchAddButtons">
          <div class="d-flex bg-info justify-content-end mb-3">
            <!-- <div class="search-container">
              <input type="text" id="searchInput" placeholder="Search for products..." />
              <button class="searchbtn" onclick="searchProducts()">Search</button>
          </div> -->
              
          </div>
          <div class="d-flex justify-content-start mb-3">
            <button
              class="btn btn-success fw-bold"
              data-bs-toggle="modal"
              data-bs-target="#addCategoryModal"
            >
              + Create Category
            </button>
          </div>
        </div>
          <!-- Button to Open Modal -->
         

          <!-- Category Table -->
          <div class="card p-4 shadow">
            <h4>Existing Categories</h4>
            <table class="table table-striped mt-3">
              <thead class="table-dark">
                <tr>
                  <th>#</th>
                  <th>Category Name</th>
                  <th>Description</th>
                  <th>listed</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% categories.forEach((category, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= category.categoryName %></td>
                  <td><%= category.description %></td>
                  <td><%= category.isListed %></td>
                  <td>
                    <button
                      class="btn btn-warning btn-sm"
                      onclick="openEditModal('<%= category._id %>', `<%= category.categoryName %>`, `<%= category.description %>`,'<%= category.isListed %>' )"
                    >
                      Edit
                    </button>
                    <button
                      onclick="deleteCategory('<%= category._id %>')"
                      class="btn btn-danger btn-sm"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
     <!--Pagination-->
     <nav>
      <ul class="pagination justify-content-center">
        <!-- Previous Button -->
        <% if (currentPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
          </li>
        <% } else { %>
          <li class="page-item disabled">
            <a class="page-link" href="#" tabindex="-1">Previous</a>
          </li>
        <% } %>
    
        <!-- Page Numbers -->
        <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %>&limit=5"><%= i %></a>
          </li>
        <% } %>
    
        <!-- Next Button -->
        <% if (currentPage < totalPages) { %>
          <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
          </li>
        <% } else { %>
          <li class="page-item disabled">
            <a class="page-link" href="#">Next</a>
          </li>
        <% } %>
      </ul>
    </nav>
    <!--Footer-->
      <%- include('../partials/footer.ejs') %>
    </div>

    <!--edit Category Modal -->

 
    <div
      class="modal fade"
      id="editCategoryModal"
      tabindex="-1"
      aria-labelledby="editCategoryModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editCategoryModalLabel">
              Edit Category
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form
              id="editCategoryForm"
              action="/admin/category/edit"
              method="post"
            >
              <div class="mb-3">
                <label class="form-label">Category Name</label>
                <input
                  type="text"
                  class="form-control"
                  name="categoryName"
                  id="editCategoryName"
                  required
                />
              </div>
              <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea
                  class="form-control"
                  name="description"
                  id="editCategoryDescription"
                  rows="3"
                ></textarea>
              </div>
              <!-- test-->
              <div class="mb-3">
                <label class="form-label">Is Listed</label>
                <div class="form-check">
                  <input
                    type="checkbox"
                    class="form-check-input"
                    name="isListed"
                    id="editCategoryIsListed"
                  />
                  <label class="form-check-label" for="editCategoryIsListed"
                    >Yes</label
                  >
                </div>
              </div>

              <button type="submit" class="btn btn-primary">
                Update Category
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Category Modal -->
<div
class="modal fade"
id="addCategoryModal"
tabindex="-1"
aria-labelledby="addCategoryModalLabel"
aria-hidden="true"
>
<div class="modal-dialog">
  <div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title" id="addCategoryModalLabel">
        Create New Category
      </h5>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="modal"
        aria-label="Close"
      ></button>
    </div>
    <div class="modal-body">
      <form id="categoryForm" action="/admin/category/add" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label">Category Name</label>
          <input
            type="text"
            class="form-control"
            name="categoryName"
            required
          />
        </div>
        
        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea
            class="form-control"
            name="description"
            rows="3"
          ></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Category Images</label>
        
          <input
            type="file"
            class="form-control"
            name="images"
            accept="image/*"
            multiple
            required
          />
        </div>
        
        <!-- Checkbox for Is Listed -->
        <div class="mb-3">
          <label class="form-label">Is Listed</label>
          <div class="form-check">
            <input
              type="checkbox"
              class="form-check-input"
              name="isListed"
              id="addCategoryIsListed"
            />
            <label class="form-check-label" for="addCategoryIsListed"
              >Yes</label
            >
          </div>
        </div>

        <button type="submit" class="btn btn-primary">
          Add Category
        </button>
      </form>
    </div>
  </div>
</div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>


      function deleteCategory(id) {
        console.log("from delete cATEGORY SCRIPT" + id);

        Swal.fire({
          title: "Are you sure?",
          text: "You won't be able to revert this!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33",
          cancelButtonColor: "#3085d6",
          confirmButtonText: "Yes, delete it!",
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/admin/category/delete/${id}`, { method: "DELETE",
              
             }).then(res=>res.json())
             .then(data=>{
              if(data && data.success){
                Swal.fire(data.message)
                
              }else{
                Swal.fire(data.message)
              }
             }).catch(error=>{
              Swal.fire('Server Error')
             })
          }
        });
      }

      //edit
      function openEditModal(id, categoryName, description, isListed) {
        console.log("from edit script");

        document.getElementById("editCategoryName").value = categoryName;
        document.getElementById("editCategoryDescription").value = description;

        const checkbox = document.getElementById("editCategoryIsListed");
        checkbox.checked = isListed === "true" || isListed === true;
        console.log(isListed);

        document.getElementById(
          "editCategoryForm"
        ).action = `/admin/category/edit/${id}`;

        var editModal = new bootstrap.Modal(
          document.getElementById("editCategoryModal")
        );
        editModal.show();
      }

      
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
