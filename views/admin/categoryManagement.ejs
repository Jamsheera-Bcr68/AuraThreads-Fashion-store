<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Cropper.js CSS -->
  <!-- Include Cropper.js (CDN) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">

  <title>Admin - Category Management</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
  <style>
    .catImg {
      height: 55px;
    }
  </style>

  <div class="container">
    <%- include('../partials/header.ejs') %>

      <div class="d-flex" id="wrapper">
        <%- include('../partials/sidebar') %>

          <div class="container mt-4">

            <% if (successMessage.length> 0) { %>
              <div class="alert alert-success">
                <%= successMessage %>
              </div>
              <% } %>

                <% if (errorMessage.length> 0) { %>
                  <div class="alert alert-danger">
                    <%= errorMessage %>
                  </div>
                  <% } %>

                    <div class="searchAddButtons">
                      <div class="d-flex bg-info justify-content-end mb-3">


                      </div>
                      <div class="d-flex justify-content-start mb-3">
                        <button style=" margin-right: 4em;" class="btn btn-success fw-bold" data-bs-toggle="modal"
                          data-bs-target="#addCategoryModal">
                          + Create Category
                        </button>
                      </div>
                    </div>
                    <!-- Button to Open Modal -->


                    <!-- Category Table -->
                    <div class="card ms-4  shadow">

                      <table class="table table-striped ">
                        <thead class="table-primary">
                          <tr>
                            <th>Category Id</th>
                            <th>Category Name</th>
                            <th>Image</th>
                            <th>Description</th>
                            <th>listed</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% categories.forEach((category, index)=> { %>
                            <tr id="row-<%= category._id %>">
                              <td>
                                #CAT<%= category._id.toString().slice(-6) %>
                              </td>
                              <td>
                                <%= category.categoryName %>
                              </td>
                              <td><img class="catImg" src="<%= category.images[0] %>" alt=""></td>
                              <td>
                                <%= category.description %>
                              </td>
                              <td>
                                <%= category.isListed %>
                              </td>
                              <td>
                                <button class="btn btn-warning btn-sm"
                                  onclick="openEditModal('<%= category._id %>', `<%= category.categoryName %>`, `<%= category.description %>`,'<%= category.isListed %>', '<%= category.images[0] %>' )">
                                  Edit
                                </button>
                                <button onclick="deleteCategory('<%= category._id %>')" class="btn btn-danger btn-sm">
                                  Delete
                                </button>
                              </td>
                            </tr>
                            <% }) %>
                        </tbody>
                      </table>
                    </div>
          </div>
      </div>
      <!--Pagination-->
      <nav>
        <ul class="pagination justify-content-center">
          <!-- Previous Button -->
          <% if (currentPage> 1) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
            </li>
            <% } else { %>
              <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1">Previous</a>
              </li>
              <% } %>

                <!-- Page Numbers -->
                <% for (let i=1; i <=totalPages; i++) { %>
                  <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&limit=5">
                      <%= i %>
                    </a>
                  </li>
                  <% } %>

                    <!-- Next Button -->
                    <% if (currentPage < totalPages) { %>
                      <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
                      </li>
                      <% } else { %>
                        <li class="page-item disabled">
                          <a class="page-link" href="#">Next</a>
                        </li>
                        <% } %>
        </ul>
      </nav>
      <!--Footer-->
      <%- include('../partials/footer.ejs') %>
  </div>

  <!--edit Category Modal -->


  <div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editCategoryModalLabel">
            Edit Category
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="editCategoryForm" action="/admin/category/edit" method="post">
            <div class="mb-3">
              <label class="form-label">Category Name</label>
              <input type="text" class="form-control" name="categoryName" id="editCategoryName" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea class="form-control" name="description" id="editCategoryDescription" rows="3"></textarea>
            </div>
            <!-- <div class="mb-3">
              <label class="form-label">Change Category Image</label>
              <input type="file" class="form-control" name="newImage" id="editImageInput" accept="image/*">
            </div> -->

            <!--image-->
            <div class="mb-3">
              <label class="form-label">Image</label>
              <div>
                <img id="editCategoryImagePreview" src="" alt="Category Image"
                  style="max-width: 100%; max-height: 150px;" />
              </div>
            </div>
            <!-- test-->
            <div class="mb-3">
              <label class="form-label">Is Listed</label>

              <div class="form-check">
                <input type="checkbox" class="form-check-input" name="isListed" id="editCategoryIsListed" />
                <label class="form-check-label" for="editCategoryIsListed">Yes</label>
              </div>
            </div>

            <button type="submit" class="btn btn-primary">
              Update Category
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Category Modal -->
  <div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addCategoryModalLabel">
            Create New Category
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="categoryForm" action="/admin/category/add" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label">Category Name</label>
              <input id="categoryName" type="text" class="form-control" name="categoryName" required />
            </div>

            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea id="description" class="form-control" name="description" rows="3"></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Category Images</label>

              <input id="imageInput" type="file" class="form-control" accept="image/*" multiple />
              <input type="hidden" id="uploadedImagesInput" name="uploadedImages">
            </div>

            <!-- Image Preview Container -->
            <div id="previewContainer" style="display: flex; flex-wrap: wrap; gap: 10px;"></div>

            <!-- Cropped Canvas (Hidden) -->
            <canvas id="croppedCanvas" style="display: none;"></canvas>

            <button class="btn btn-primary" type="button" id="cropButton" style="display: none;">Crop</button>


            <!-- Checkbox for Is Listed -->
            <div class="mb-3">
              <label class="form-label">Is Listed</label>
              <div class="form-check">
                <input type="checkbox" class="form-check-input" name="isListed" id="addCategoryIsListed" />
                <label class="form-check-label" for="addCategoryIsListed">Yes</label>
              </div>
            </div>

            <button type="submit" class="btn btn-primary">
              Add Category
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://unpkg.com/cropperjs/dist/cropper.min.js"></script>
