<!DOCTYPE html>
<html>

<head>
  <title>Sales Report</title>
  <style>
    /* Print-friendly styles here */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    td,
    th {
      border: 1px solid #999;
      padding: 6px;
      text-align: center;
    }

    img {
      max-width: 100%;
    }
  </style>
</head>

<body>
  <h2>Sales Report</h2>
  <p>From <%= startDate %> to <%= endDate %>
  </p>

  <img src="<%= chartImage %>" alt="Sales Chart" />

  <h3>Sales Table</h3>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>
          <%= reportType==='daily' || reportType==='custom' ? 'Date' : reportType==='weekly' ? 'Week' :
            reportType==='monthly' ? 'Month' : 'Year' %>
        </th>

        <th>Total Sales</th>
      </tr>
    </thead>
    <tbody>
      <% salesData.forEach((sale, index)=> { %>
        <tr>
          <td>
            <%= index + 1 %>
          </td>
          <td>
            <%= sale._id %>
          </td>
          <td>₹<%= sale.totalSales %>
          </td>
        </tr>
        <% }) %>
    </tbody>
  </table>
</body>

</html>