<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Product</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>
    <style>
        .container {
            max-width: 100%;
            margin: 0;
            padding: 0;
            margin-top: 0;
        }

        body {
            margin: 0;
        }

        .form-container {
            margin-left: 1rem;
            padding: 20px;
            border: 1px solid blue;
            border-radius: 5px;
            background-color: #f8f9fa;
        }

        .row {
            margin-top: 1rem;
        }

        .form-check-label {
            margin-left: 5px;
        }
    </style>

    <div class="container">
        <!-- Include Header -->
        <%- include('../partials/header.ejs') %>

            <div class="d-flex" id="wrapper">
                <!-- Include Sidebar -->
                <%- include('../partials/sidebar') %>


                    <div class="container mt-4">
                        <h2 class="text-center fw-bold">Add New Product</h2>



                        <form id="addForm" action="/product/products/add" method="POST" enctype="multipart/form-data"
                            class="form-container" novalidate>
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-md-6" id="productData">
                                    <!-- Product Name -->
                                    <div class="mb-3">
                                        <label class="form-label">Product Name</label>
                                        <input type="text" class="form-control" value="" name="productName" required>
                                    </div>


                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Category</label>
                                            <select class="form-select" name="categoryId" required>
                                                <option value="">Select a Category</option>
                                                <% categories.forEach(category=> { %>
                                                    <option value="<%= category._id %>">
                                                        <%= category.categoryName %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Price (₹ )</label>
                                            <input type="number" class="form-control" value="" name="price" min="0"
                                                required>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        <textarea class="form-control" name="description" rows="3"></textarea>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Brand</label>
                                            <input type="text" class="form-control" name="brand">
                                        </div>

                                    </div>
                                    <!-- Description -->


                                </div>

                                <!-- Right Column -->
                                <div id="variantColumn" class="col-md-6">
                                    <div class="variant-block">

                                        <div class="row">

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Size</label>
                                                <select class="form-select" name="size">
                                                    <option value="">Select Size</option>
                                                    <option value="S">Small</option>
                                                    <option value="M">Medium</option>
                                                    <option value="L">Large</option>
                                                    <option value="XL">Extra Large</option>
                                                    <option value="FS">Free Size</option>
                                                </select>
                                            </div>
                                            <div id="colorSelect" class="col-md-6 mb-3">
                                                <label class="form-label">Color</label>
                                                <select class="form-select" name="color">
                                                    <option value="">Select Color</option>
                                                    <option value="red">Red</option>
                                                    <option value="blue">Blue</option>
                                                    <option value="black">Black</option>
                                                    <option value="white">White</option>
                                                    <option value="orange">Orange</option>
                                                    <option value="peach">Peach</option>
                                                    <option value="green">Green</option>
                                                    <option value="yellow">Yellow</option>
                                                    <option value="pink">Pink</option>
                                                    <option value="violet">Violet</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row">

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Stock</label>
                                                <input class="form-control" value="" type="number" name="stock" min="0"
                                                    required>

                                            </div>
                                        </div>
                                        <!-- Checkboxes in One Row -->
                                        <div class="d-flex align-items-center mb-3">
                                            <!-- <div class="form-check me-3">
                                                <input class="form-check-input" type="checkbox" name="isListed"
                                                    value="true">
                                                <label class="form-check-label">List this product</label>
                                            </div> -->
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="isActive"
                                                    value="true">
                                                <label class="form-check-label">Set as Active</label>
                                            </div>
                                        </div>
                                        <!-- Other form fields -->
                                        <div class="mb-3">
                                            <label class="form-label">Upload Images</label>
                                            <!-- In the file upload input -->
                                            <input type="file" class="form-control" id="imageInput" name="imageInput"
                                                multiple accept="image/*" required
                                                title="Please select at least one image">

                                            <!-- Hidden input to store uploaded image paths -->
                                            <input type="hidden" id="uploadedImagesInput" name="uploadedImages">
                                        </div>

                                        <!-- Image Preview Container -->
                                        <div id="previewContainer" style="display: flex; flex-wrap: wrap; gap: 10px;">
                                        </div>

                                        <!-- Cropped Canvas (Hidden) -->
                                        <canvas id="croppedCanvas" style="display: none;"></canvas>

                                        <button class="btn btn-primary" type="button" id="cropButton">Crop &
                                            Upload</button>


                                    </div>


                                    <!-- Buttons in One Row -->
                                    <div class="d-flex justify-content-end">
                                        <button type="reset" class="btn btn-secondary me-2">reset</button>
                                        <button type="button" class="btn btn-secondary me-2"><a
                                                style="text-decoration: none;color: white;"
                                                href="/product/products">Back</a></button>
                                        <button type="submit" id="addProductForm" class="btn btn-primary">Add
                                            Product</button>
                                    </div>
                        </form>
                        <button id="addVariant" class="btn btn-primary" style="display: none;">Save
                        </button>
                    </div>
            </div>

    </div>
    </div>

    <%- include('../partials/footer.ejs') %>
        </div>
        <!-- Include Cropper.js (CDN) -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>

            document.addEventListener('DOMContentLoaded', function () {
                const imageInput = document.getElementById('imageInput');
                const previewContainer = document.getElementById('previewContainer');
                const cropButton = document.getElementById('cropButton');

                const addForm = document.getElementById('addForm');
                const uploadedImagesInput = document.getElementById('uploadedImagesInput');
                let cropInstances = {};
                let uploadedImagePaths = []; // Store uploaded image paths

                imageInput.addEventListener('change', function (event) {
                    // Clear previous previews and crop instances
                    previewContainer.innerHTML = '';
                    cropInstances = {};
                    uploadedImagePaths = [];

                    // Create preview for each selected image
                    Array.from(event.target.files).forEach((file, index) => {
                        const reader = new FileReader();

                        reader.onload = function (e) {
                            // Create container for each image
                            const imageContainer = document.createElement('div');
                            imageContainer.style.position = 'relative';
                            imageContainer.style.margin = '10px';
                            imageContainer.style.width = '200px';

                            // Create image element
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.style.maxWidth = '100%';
                            img.style.maxHeight = '200px';
                            img.style.objectFit = 'contain';
                            img.setAttribute('data-index', index);

                            // Create remove button
                            const removeButton = document.createElement('button');
                            removeButton.innerHTML = '×';
                            removeButton.style.position = 'absolute';
                            removeButton.style.top = '0';
                            removeButton.style.right = '0';
                            removeButton.style.backgroundColor = 'red';
                            removeButton.style.color = 'white';
                            removeButton.style.border = 'none';
                            removeButton.style.borderRadius = '50%';
                            removeButton.style.width = '25px';
                            removeButton.style.height = '25px';
                            removeButton.style.cursor = 'pointer';

                            removeButton.addEventListener('click', () => {
                                // Remove the image from preview and crop instances
                                imageContainer.remove();
                                delete cropInstances[index];

                                // Update file input to remove the specific file
                                const filesArray = Array.from(imageInput.files);
                                filesArray.splice(index, 1);

                                // Recreate FileList
                                const dataTransfer = new DataTransfer();
                                filesArray.forEach(file => dataTransfer.items.add(file));
                                imageInput.files = dataTransfer.files;
                            });

                            // Append image and remove button to container
                            imageContainer.appendChild(img);
                            imageContainer.appendChild(removeButton);

                            // Add to preview container
                            previewContainer.appendChild(imageContainer);

                            // Initialize Cropper for each image
                            const cropper = new Cropper(img, {
                                aspectRatio: 3 / 4, // Square crop
                                viewMode: 2,
                                guides: true,
                                background: false
                            });

                            // Store cropper instance
                            cropInstances[index] = cropper;
                        };

                        // Read the file
                        reader.readAsDataURL(file);
                    });
                });

                cropButton.addEventListener('click', function () {
                    if (Object.keys(cropInstances).length === 0) {
                        Swal.fire("No images selected!", "Please select an image before cropping and uploading.", "warning");
                        return;
                    }

                    let uploadPromises = [];
                    uploadedImagePaths = []; // Reset before new uploads

                    Object.keys(cropInstances).forEach(index => {
                        const cropper = cropInstances[index];
                        if (cropper) {
                            uploadPromises.push(new Promise((resolve, reject) => {
                                cropper.getCroppedCanvas().toBlob((blob) => {
                                    if (!blob) {
                                        reject("Failed to get cropped image.");
                                        return;
                                    }

                                    const formData = new FormData();
                                    formData.append('image', blob, `cropped-image-${index}.jpg`);

                                    fetch('/product/upload', {
                                        method: 'POST',
                                        body: formData
                                    })
                                        .then(response => response.json())
                                        .then(data => {
                                            if (data.filePaths && data.filePaths.length > 0) {
                                                uploadedImagePaths.push(...data.filePaths);
                                                resolve();
                                            } else {
                                                reject('Upload failed');
                                            }
                                        })
                                        .catch(error => reject(error));
                                });
                            }));
                        }
                    });

                    if (uploadPromises.length === 0) {
                        Swal.fire("No images to upload!", "Please select an image and try again.", "info");
                        return;
                    }

                    Promise.all(uploadPromises)
                        .then(() => {
                            Swal.fire({
                                icon: "success",
                                title: 'image uploaded ',
                                showConfirmButton: false,
                                timer: 1000
                            });
                              cropInstances = {};
                            // Update hidden input with uploaded image paths
                            if (uploadedImagesInput) {
                                uploadedImagesInput.value = JSON.stringify(uploadedImagePaths);
                            }
                            console.log('Uploaded image paths:', uploadedImagePaths);
                        })
                        .catch(error => {
                            console.error('Error uploading images:', error);
                            Swal.fire("Upload Error", "Failed to upload images.", "error");
                        });
                });

                //form submit event listener
                addForm.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    // Check if images have been uploaded
                    const storedImagePaths = uploadedImagesInput.value;
                    const fileInputImages = imageInput.files;

                    if (!storedImagePaths && fileInputImages.length === 0) {
                        Swal.fire("Image Upload Required", "Please upload images before adding the product.", "warning");
                        return;
                    }

                    const formData = new FormData(this);

                    // Log all form data entries for debugging
                    console.log('Form Data Entries:');
                    for (let [key, value] of formData.entries()) {
                        console.log(`${key}: ${value}`);
                    }
                    const productName = formData.get('productName').trim()
                    console.log(productName);
                    if (!productName) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Product Name cannot be empty"
                        })
                    }
                    if (productName.length < 3) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Product Name Should contain at least 3 letters"
                        })
                    }
                    if (productName.length > 20) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Product Name Should not contain more than 20 letters"
                        })
                    }
                    if (/^\d/.test(productName)) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Product Name Should not sart with numbers"
                        })
                    }
                    const stock = formData.get('stock')
                    if (stock < 0) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Stock cannot be less than zero"
                        })
                    }
                    if (!stock) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Stock cannot be empty"
                        })
                    }
                    const price = formData.get('price')
                    if (price == 0) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Price cannot be zero"
                        })
                    }
                    if (price < 0) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Price cannot be less than zero"
                        })
                    }
                    if (price > 10000) {
                        return Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: "Price cannot be greater than 10000"
                        })
                    }


                    try {
                        const response = await fetch("/product/products/add", {
                            method: "POST",
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {

                            const swalWithBootstrapButtons = Swal.mixin({
                                customClass: {
                                    confirmButton: "btn btn-success",
                                    cancelButton: "btn btn-secondary"
                                },
                                buttonsStyling: false
                            });

                            swalWithBootstrapButtons.fire({
                                title: "Add Another Variant?",
                                text: "The product was added successfully. Do you want to add another variant for this product?",
                                icon: "question",
                                showCancelButton: true,
                                confirmButtonText: "Yes, add more",
                                cancelButtonText: "No, I'm done",
                                reverseButtons: true
                            }).then((result) => {
                                if (result.isConfirmed) {
                                  
                                    const productData = document.getElementById('productData')
                                    const inputs = productData.querySelectorAll('input, select, textarea');
                                    // Disable each field
                                    inputs.forEach(input => {
                                        input.setAttribute('readonly', true);
                                    });

                                    const variantColumn = document.getElementById('variantColumn')
                                    // Clear all inputs & selects (except checkboxes and readonly/disabled)
                                    const variantInputs = variantColumn.querySelectorAll('input:not([readonly]):not([type="checkbox"]), select, textarea');

                                    variantInputs.forEach(input => {
                                        input.value = '';
                                    });
                                    //unckheck check boxes
                                    const checkboxes = variantColumn.querySelectorAll('input[type="checkbox"]');
                                    checkboxes.forEach(checkbox => {
                                        checkbox.checked = false;
                                    });

                                    // Clear image preview and input
                                    const previewContainer = document.getElementById('previewContainer');
                                    previewContainer.innerHTML = '';

                                    const imageInput = document.getElementById('imageInput');
                                    imageInput.value = '';

                                   
                                    uploadedImagesInput.value = '' 
                                    uploadedImagePaths = []; 

                                } else if (result.dismiss === Swal.DismissReason.cancel) {
                                    Swal.fire({
                                        title: "All Done!",
                                        text: "Product and variant saved successfully.",
                                        icon: "success"
                                    }).then(() => {
                                        const productData = document.getElementById('productData');
                                        const inputs = productData.querySelectorAll('input, select, textarea');
                                        inputs.forEach(input => {
                                            input.removeAttribute('readonly');
                                        });
                                        // ✅ Redirect or reset the form
                                        window.location.href = "/product/products"; // or wherever you want
                                    });
                                }
                            });


                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: result.message || 'Failed to add product'
                            });
                        }
                        // if (result.success) {
                        //     Swal.fire({
                        //         icon: "success",
                        //         title: 'Product Added Successfully ',
                        //         showConfirmButton: false,
                        //         timer: 1000
                        //     }).then(() => {
                        //         // Reset form and preview
                        //         addForm.reset();
                        //         previewContainer.innerHTML = '';
                        //         uploadedImagePaths = [];
                        //         uploadedImagesInput.value = '';
                        //     });
                        //     window.location.href = '/product/products'
                        // } else {
                        //     Swal.fire({
                        //         icon: 'error',
                        //         title: 'Error',
                        //         text: result.message || 'Failed to add product'
                        //     });
                        // }
                    } catch (error) {
                        console.error("Error submitting form:", error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Submission Error',
                            text: 'An unexpected error occurred'
                        });
                    }
                });

            });


        </script>
</body>

</html>