<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - Return Requests</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('../partials/header.ejs') %>
    <div class="d-flex" id="wrapper">
        <%- include('../partials/sidebar') %>
        <div class="container mt-5 ms-4">
           
          
           <div class="container-fluid">
             <!-- Table -->
            <table class="table table-bordered table-hover">
              <thead class="table-primary">
                <tr>
                  <th>Order ID</th>
                  <th>User</th>
                  <th>Product</th>
                  <th>Reason</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% returnRequests.forEach(req => { %>
                  <tr>
                    
                    <td>#ORD<%= req.orderId.toString().slice(-6) %></td>
                     <td><%= req.userEmail %></td>
                    <td><%= req.productName %></td>
                    <td><%= req.reason %></td>
                    <td><%= req.requestedDate.toLocaleDateString() %></td>
                    <td>
                      <% if (req.status === 'pending') { %>
                        <span class="badge bg-warning text-dark">Pending</span>
                      <% } else if (req.status === 'approved') { %>
                        <span class="badge bg-success">Approved</span>
                      <% } else { %>
                        <span class="badge bg-danger">Rejected</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (req.status === 'pending') { %>
                        <form id="approvalForm" method="POST" action="/admin/returns/approve" style="display:inline;">
                          <input type="hidden" name="orderId" value="<%= req.orderId %>">
                          <input type="hidden" name="variantId" value="<%= req.variantId %>">
                          <button class="btn btn-success btn-sm">Approve</button>
                        </form>
                        <form id="rejectingForm" method="POST" action="/admin/returns/reject" style="display:inline;">
                          <input type="hidden" name="orderId" value="<%= req.orderId %>">
                          <input type="hidden" name="variantId" value="<%= req.variantId %>">
                          <button class="btn btn-danger btn-sm">Reject</button>
                        </form>
                      <% } else { %>
                        <span class="text-muted">Action Taken</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
           </div>
          </div>
        
    </div>
  
     <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Handle all approve buttons
  document.querySelectorAll('form[action="/admin/returns/approve"]').forEach(form => {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const formData = new FormData(this);
      const formObject = Object.fromEntries(formData);
      console.log('Approving:', formObject);

      fetch('/admin/returns/approve', {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formObject)
      })
      .then(res => res.json())
      .then(data => {
        Swal.fire({
           icon: "success",
          title: data.message,
          showConfirmButton: false,
          timer: 1000
        })
        .then(() => location.reload()); // refresh after approval
      })
      .catch(error => {
        console.log(error);
        Swal.fire('Server Error');
      });
    });
  });

  // Handle all reject buttons
  document.querySelectorAll('form[action="/admin/returns/reject"]').forEach(form => {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const formData = new FormData(this);
      const formObject = Object.fromEntries(formData);
      console.log('Rejecting:', formObject);

      fetch('/admin/returns/reject', {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formObject)
      })
      .then(res => res.json())
      .then(data => {
         Swal.fire({
           icon: "success",
          title: data.message,
          showConfirmButton: false,
          timer: 1000
        })
        .then(() => location.reload()); 
      })
      .catch(error => {
        console.log(error);
        Swal.fire('Server Error');
      });
    });
  });
</script>

</body>
</html>
