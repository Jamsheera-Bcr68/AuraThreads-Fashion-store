<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin - Product Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
  <style>
    .container {
      margin-left: 0;
      margin-right: 0;
      padding: 0;
      max-width: 100%;
    }

    body {
      margin: 0;
    }

    .alert:empty {
      display: none;
    }
  </style>
  <div class="container ">
    <!-- Include Header -->
    <%- include('../partials/header.ejs') %>

      <div class="d-flex" id="wrapper">
        <!-- Include Sidebar -->
        <%- include('../partials/sidebar') %>

          <div class="container p-4">
            <% if (successMessage.length> 0) { %>
              <div class="alert alert-success">
                <%= successMessage %>
              </div>
              <% } %>
                <% if (errorMessage.length> 0) { %>
                  <div class="alert alert-danger">
                    <%= errorMessage %>
                  </div>
                  <% } %>
                    <!-- Add Product Button -->
                    <div class="text-end mb-3">
                      <a href="/product/products/add" class="btn btn-primary">Add Product</a>
                    </div>

                    <!-- Product Table -->
                    <div class="table-responsive">
                      <table class="table table-bordered">
                        <thead class="table-dark">
                          <tr>
                            <th>Product Id</th>
                            <th>Image</th>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Available Stock</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% products.forEach((product, index)=> { %>
                            <tr id="row-<%= product._id %>">
                              <td>
                               #PRD<%= product._id.toString().slice(-6) %>
                              </td>
                              <td>
                                <img src="<%= product.images[0] %>" alt="Product Image"
                                  style="width: 60px; height: auto;">
                              </td>
                              <td>
                                <%= product.productName %>
                              </td>
                              <td>₹ <%= product.price %>
                              </td>
                              <td>
                                <%= product.categoryId.categoryName %>
                              </td>
                              <td>
                                <%= product.stock %>
                              </td>
                              <td>
                                <a href="/product/products/edit/<%= product._id %>"
                                  class="btn btn-warning btn-sm">Edit</a>
                                <a href="#" class="btn btn-danger btn-sm" onclick="confirmDeletion('<%= product._id %>');
     return false;">Delete</a>
                              </td>
                            </tr>
                            <% }) %>
                        </tbody>
                      </table>
                    </div>
          </div>
      </div>
  </div>
  <nav>
    <ul class="pagination justify-content-center">
      <!-- Previous Button -->
      <% if (currentPage> 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
        </li>
        <% } else { %>
          <li class="page-item disabled">
            <a class="page-link" href="#" tabindex="-1">Previous</a>
          </li>
          <% } %>

            <!-- Page Numbers -->
            <% for (let i=1; i <=totalPages; i++) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&limit=5">
                  <%= i %>
                </a>
              </li>
              <% } %>

                <!-- Next Button -->
                <% if (currentPage < totalPages) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
                  </li>
                  <% } else { %>
                    <li class="page-item disabled">
                      <a class="page-link" href="#">Next</a>
                    </li>
                    <% } %>
    </ul>
  </nav>


  <%- include('../partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

      function confirmDeletion(productId) {
        console.log("Form confirm delete function" + productId);
        Swal.fire({
          title: "Are you sure?",
          text: "You won't be able to revert this!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#3085d6",
          cancelButtonColor: "#d33",
          confirmButtonText: "Yes, delete it!",
        }).then((result) => {
          if (result.isConfirmed) {
            // Send DELETE request to the server
            fetch(`/product/products/delete/${productId}`, {
              method: "DELETE",

            })
              .then((response) => response.json())
              .then((data) => {
                if (data.success) {
                  Swal.fire({
                    icon: "success",
                    title: 'Product Deleted ',
                    showConfirmButton: false,
                    timer: 1000
                  }).then(() => {
                    const row=document.getElementById(`row-${productId}`)
                    row.remove()
                    //location.reload(); // Reload page after deletion
                  });
                } else {
                  Swal.fire({
                    title: "Error!",
                    text: "Something went wrong. Please try again.",
                    icon: "error",
                  });
                }
              })
              .catch((error) => {
                console.error("Error deleting product:", error);
                Swal.fire({
                  title: "Error!",
                  text: "Something went wrong. Please try again.",
                  icon: "error",
                });
              });
          }
        });
      }
    </script>
</body>

</html>