<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Offer Management</title>
    <link rel="stylesheet" href="/css/offers.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <%- include('../partials/header.ejs') %>
        <div class="d-flex" id="wrapper">

            <div class="container">
                <!-- Sidebar -->
                <%- include('../partials/sidebar') %>

                    <!-- Main Content -->
                    <div style="width: 100%;
  max-width: 100vw;" class="main-content">
                        <!-- Header -->
                        <div class="page-title">
                            <h1>Offer Management Dashboard</h1>
                        </div>

                        <!-- Stats Section -->
                        <div class="stats">
                            <div class="stat-card">
                                <h3>Total Offers</h3>
                                <p>
                                    <%= stats.totalOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Active Offers</h3>
                                <p id="activeCount">
                                    <%= stats.activeOffers %>
                                </p>
                            </div>

                            <div class="stat-card">
                                <h3>Expired Offers</h3>
                                <p>
                                    <%= stats.expiredOffers %>
                                </p>
                            </div>
                        </div>

                        <!-- Offers Section -->
                        <div class="offers-section">
                            <div class="section-header">
                                <h2 class="section-title"></h2>
                                <button class="btn btn-success" id="addOfferBtn"><i class="fas fa-plus"></i> Add New
                                    Offer</button>
                            </div>

                            <div class="table-wrapper">
                                <table>
                                    <thead>
                                        <tr>

                                            <th>ID</th>
                                            <th>Offer Name</th>
                                            <th>Offer On</th>
                                            <th>Discount</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% populatedOffers.forEach(function(offer,index) { %>
                                            <tr>

                                                <td>OFF<%= offer.id.slice(-4) %>
                                                </td>
                                                <td>
                                                    <%= offer.offerName %>
                                                </td>
                                                <td>
                                                    <%= offer.applicableName %>
                                                </td>
                                                <td>
                                                    <%= offer.discountValue %>
                                                        <%= offer.discountType=='percentage' ? '%' :'₹' %>
                                                </td>
                                                <td>
                                                    <%= offer.startDate.toISOString().substring(0, 10) %>
                                                </td>
                                                <td>
                                                    <%= offer.endDate.toISOString().substring(0, 10) %> %>
                                                </td>
                                                <td>
                                                    <span id="status-<%= offer._id %>"
                                                        class="status status-<%= offer.status.toLowerCase() %>">
                                                        <%= offer.status %>
                                                    </span>
                                                </td>
                                                <td class="action-cell">
                                                    <button data-id="<%= offer._id %>"
                                                        class="btn btn-warning action-btn edit-btn"><i
                                                            class="fas fa-edit"></i></button>
                                                    <button data-id="<%= offer._id %>"
                                                        class="btn btn-danger action-btn delete-btn"
                                                        <%=(offer.status==='inactive' || offer.status==='expired' )
                                                        ? 'disabled' : '' %>>
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            </div>

        </div>
        <!--Pagination-->
        <nav>
            <ul class="pagination justify-content-center">
                <!-- Previous Button -->
                <% if (currentPage> 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
                    </li>
                    <% } else { %>
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Previous</a>
                        </li>
                        <% } %>

                            <!-- Page Numbers -->
                            <% for (let i=1; i <=totalPages; i++) { %>
                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>&limit=5">
                                        <%= i %>
                                    </a>
                                </li>
                                <% } %>

                                    <!-- Next Button -->
                                    <% if (currentPage < totalPages) { %>
                                        <li class="page-item">
                                            <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
                                        </li>
                                        <% } else { %>
                                            <li class="page-item disabled">
                                                <a class="page-link" href="#">Next</a>
                                            </li>
                                            <% } %>
            </ul>
        </nav>
        <%- include('../partials/footer.ejs') %>

            <!-- Add/Edit Offer Modal -->
            <div class="modal" id="offerModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 id="modalTitle">Add New Offer</h2>
                        <button class="close">&times;</button>
                    </div>

                    <div class="modal-body">
                        <form id="offerForm" method="POST" action="/admin/offers">
                            <!-- Offer Name -->
                            <div class="form-group">
                                <label for="offerName">Offer Name</label>
                                <input type="text" name="offerName" id="offerName" required>
                            </div>

                            <!-- Offer Description -->
                            <div class="form-group">
                                <label for="offerDesc">Description</label>
                                <textarea name="offerDesc" id="offerDesc"></textarea>
                            </div>


                            <!-- Discount Type -->
                            <div class="form-group">
                                <label for="discountType">Discount Type</label>
                                <select name="discountType" id="discountType" required>
                                    <option value="percentage">Percentage (%)</option>
                                    <option value="amount">Fixed Amount</option>
                                </select>
                            </div>

                            <!-- Discount Value -->
                            <div class="form-group">
                                <label for="discountValue">Discount Value</label>
                                <input type="number" name="discountValue" id="discountValue" min="0" required>
                            </div>

                            <!-- Start Date -->
                            <div class="form-group">
                                <label for="startDate">Start Date</label>
                                <input type="date" name="startDate" id="startDate" required>
                            </div>

                            <!-- End Date -->
                            <div class="form-group">
                                <label for="endDate">End Date</label>
                                <input type="date" name="endDate" id="endDate" required>
                            </div>

                            <!-- Status -->
                            <div class="form-group">
                                <label for="status">Status</label>
                                <select name="status" id="status" required>
                                    <option value="active">Active</option>
                                    <option id="expiredstatus" hidden value="expired">Expired</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>

                            <!-- Offer On (Product or Category) -->
                            <div class="form-group">
                                <label for="offerOn">Offer On</label>
                                <select name="offerOn" id="offerOn" required>
                                    <option value="">-- Select --</option>
                                    <option value="product">Product</option>
                                    <option value="category">Category</option>
                                </select>
                            </div>

                            <!-- Select Product -->
                            <div class="form-group" id="productSelect" style="display: none;">
                                <label for="productId">Select Product</label>
                                <select name="productId" id="productId">
                                    <option value="">-- Select Product --</option>
                                    <% products.forEach(function(product) { %>
                                        <option value="<%= product._id %>">
                                            <%= product.productName %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <!-- Select Category -->
                            <div class="form-group" id="categorySelect" style="display: none;">
                                <label for="categoryId">Select Category</label>
                                <select name="categoryId" id="categoryId">
                                    <option value="">-- Select Category --</option>
                                    <% categories.forEach(function(category) { %>
                                        <option value="<%= category._id %>">
                                            <%= category.categoryName %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                        </form>
                    </div>
                    <input type="hidden" id="offerId" />
                    <div class="modal-footer">
                        <button class="btn btn-danger" id="cancelBtn" type="button">Cancel</button>
                        <button class="btn btn-success" id="saveOfferBtn" type="submit" form="offerForm">Save
                            Offer</button>
                    </div>
                </div>
            </div>

            <!-- Delete Confirmation Modal -->
            <div class="modal" id="deleteModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2>Confirm Delete</h2>
                        <button class="close">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this offer? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-warning" id="cancelDeleteBtn">Cancel</button>
                        <button class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>

