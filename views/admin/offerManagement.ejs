            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

            <script>
                // DOM Elements
                const addOfferBtn = document.getElementById('addOfferBtn');
                const offerModal = document.getElementById('offerModal');
                const deleteModal = document.getElementById('deleteModal');
                const modalTitle = document.getElementById('modalTitle');
                const closeButtons = document.querySelectorAll('.close');
                const cancelBtn = document.getElementById('cancelBtn');
                const saveOfferBtn = document.getElementById('saveOfferBtn');
                const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
                const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
                const editBtns = document.querySelectorAll('.edit-btn');
                const deleteBtns = document.querySelectorAll('.delete-btn');
                const offerForm = document.getElementById('offerForm');

                // Open add offer modal
                addOfferBtn.addEventListener('click', () => {
                    modalTitle.textContent = 'Add New Offer';
                    offerForm.reset();
                    offerForm.removeAttribute('data-edit-id');
                    document.getElementById("offerId").value = '';
                    offerModal.classList.add('active');
                });

                // Close modals
                closeButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        offerModal.classList.remove('active');
                        deleteModal.classList.remove('active');
                    });
                });

                // Cancel button in offer modal
                cancelBtn.addEventListener('click', () => {
                    offerModal.classList.remove('active');
                });

                // Save offer (handled on form submission)
                offerForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const offerId = document.getElementById("offerId").value;

                    const offerName = document.getElementById('offerName').value.trim();
                    const offerDescription = document.getElementById('offerDesc').value.trim();
                    const discountType = document.getElementById('discountType').value;
                    const discountValue = document.getElementById('discountValue').value;
                    const startDate = document.getElementById('startDate').value;
                    const endDate = document.getElementById('endDate').value;
                    const status = document.getElementById('status').value;
                    const offerOn = document.getElementById('offerOn').value;
                    const productId = document.getElementById('productId').value;
                    const categoryId = document.getElementById('categoryId').value;

                    if (!offerName.trim() || !offerDescription || !discountType || !discountValue || !startDate || !endDate || !status || !offerOn || (!productId && !categoryId)) {
                        Swal.fire("All fields are required");
                        return;
                    }
                    if (/^\d/.test(offerName)) {
                        Swal.fire("Offer name cannot start with numbers");
                        return;
                    }
                    if (offerName.length < 3) {
                        Swal.fire("Offer name Should contin atleast 3 charectors");
                        return;
                    }
                    if (offerName.length > 15) {
                        Swal.fire("Offer name does not contain more than 15 charectors");
                        return;
                    }
                    if (parseInt(discountValue) < 0) {
                        return Swal.fire("Discount value should greater than zero")
                    }

                    if (new Date(startDate) > new Date(endDate)) {
                        Swal.fire("Enter Proper End Date");
                        return;
                    }
                    const currentDate = new Date()
                    if (currentDate > new Date(endDate)) {
                        Swal.fire("Enter Proper End Date");
                        return;
                    }
                    console.log('offerDescription', offerDescription);

                    const formObject = {
                        offerName,
                        description: offerDescription,
                        discountType,
                        discountValue,
                        startDate,
                        endDate,
                        status,
                        offerOn,
                        productId,
                        categoryId
                    };

                    const url = offerId ? `/admin/editOffer/${offerId}` : `/admin/addOffer`;
                    const method = offerId ? 'PUT' : 'POST';

                    fetch(url, {
                        method,
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(formObject)
                    }).then(res => res.json())
                        .then(data => {

                            if (data && data.success) {
                                Swal.fire({
                                    icon: "success",
                                    title: data.message,
                                    showConfirmButton: false,
                                    timer: 1000
                                }).then(() => {
                                    offerModal.classList.remove('active');
                                    location.reload()
                                });

                            } else {
                                Swal.fire(data.message)

                            }
                        }).catch(() => {
                            Swal.fire("Server error");
                        });
                });

                // Edit offer
                editBtns.forEach(button => {
                    button.addEventListener('click', () => {
                        offerModal.classList.add('active');
                        modalTitle.textContent = 'Edit Offer';
                        const offerId = button.dataset.id;
                        offerForm.setAttribute('data-edit-id', offerId);
                        document.getElementById("offerId").value = offerId;
                        console.log('edit button clicked');
                        console.log('offerId', offerId);



                        fetch(`/admin/getSingleOffer/${offerId}`, { method: "GET" })
                            .then(res => res.json())
                            .then(data => {
                                if (data && data.success) {
                                    const expiredstatus = document.getElementById('expiredstatus')

                                    const thisOffer = data.offer;
                                    if (thisOffer.status == 'expired') {
                                        expiredstatus.style.display = 'block'
                                    }
                                    document.getElementById('offerName').value = thisOffer.offerName;
                                    document.getElementById('offerDesc').value = thisOffer.description;

                                    document.getElementById('discountType').value = thisOffer.discountType;
                                    console.log(thisOffer);

                                    document.getElementById('discountValue').value = thisOffer.discountValue;
                                    document.getElementById('startDate').value = thisOffer.startDate?.split('T')[0];
                                    document.getElementById('endDate').value = thisOffer.endDate?.split('T')[0];
                                    document.getElementById('offerOn').value = thisOffer.applicableTo;
                                    document.getElementById('status').value = thisOffer.status;

                                    if (thisOffer.applicableTo === 'product') {
                                        document.getElementById('productSelect').style.display = 'block';
                                        document.getElementById('categorySelect').style.display = 'none';
                                        document.getElementById('productId').value = thisOffer.productId; // ✅ Set selected product
                                    } else if (thisOffer.applicableTo === 'category') {
                                        document.getElementById('categorySelect').style.display = 'block';
                                        document.getElementById('productSelect').style.display = 'none';
                                        document.getElementById('categoryId').value = thisOffer.categoryId; // ✅ Set selected category
                                    }
                                } else {
                                    Swal.fire(data.message);
                                }
                            }).catch(() => {
                                Swal.fire("Server error");
                            });
                    });
                });

                // Delete offer

                deleteBtns.forEach(button => {
                    button.addEventListener('click', () => {
                        let offerId = button.getAttribute('data-id');
                        Swal.fire({
                            title: "Do you want to remove this offer?",
                            text: "You won't be able to revert this!",
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#3085d6",
                            cancelButtonColor: "#d33",
                            confirmButtonText: "Yes, remove it!"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                fetch(`/admin/offer/delete/${offerId}`, { method: "DELETE" })
                                    .then(res => res.json())
                                    .then(data => {
                                        if (data && data.success) {
                                            Swal.fire({
                                                icon: "success",
                                                title: data.message,
                                                showConfirmButton: false,
                                                timer: 1000
                                            })
                                            button.disabled = true;
                                            const status = document.getElementById(`status-${offerId}`)
                                            status.style.background = 'rgba(243, 156, 18, 0.2)'
                                            status.style.color = '#d35400'
                                            const activeCountPara = document.getElementById('activeCount')
                                            let activeCount = parseInt(activeCountPara.innerHTML)
                                            console.log(activeCount, 'activeCount');
                                            activeCount = activeCount - 1
                                            activeCountPara.innerHTML = activeCount

                                        } else {
                                            Swal.fire(data.message)
                                        }
                                    }).catch(() => {
                                        Swal.fire("Server Error");
                                    });

                            }
                        });

                        // deleteModal.classList.add('active');
                        // deleteOfferId = button.getAttribute('data-id');
                        // const row = button.closest('tr');

                        // confirmDeleteBtn.onclick = () => {
                        //     fetch(`/admin/offer/delete/${deleteOfferId}`, { method: "DELETE" })
                        //         .then(res => res.json())
                        //         .then(data => {
                        //             Swal.fire(data.message);
                        //             if (data.success) {
                        //                 row.remove();
                        //                 deleteModal.classList.remove('active');
                        //             }
                        //         }).catch(() => {
                        //             Swal.fire("Server Error");
                        //         });
                        // };
                    });
                });

                // Cancel delete
                cancelDeleteBtn.addEventListener('click', () => {
                    deleteModal.classList.remove('active');
                });

                // Helper to format date for input
                function formatDateForInput(dateStr) {
                    const parts = dateStr.split('/');
                    return `${parts[2]}-${parts[1]}-${parts[0]}`;
                }

                // Show/hide product/category selects
                document.addEventListener('DOMContentLoaded', function () {
                    const offerOn = document.getElementById('offerOn');
                    const productSelect = document.getElementById('productSelect');
                    const categorySelect = document.getElementById('categorySelect');

                    productSelect.style.display = 'none';
                    categorySelect.style.display = 'none';

                    offerOn.addEventListener('change', function () {
                        if (this.value === 'product') {
                            productSelect.style.display = 'block';
                            categorySelect.style.display = 'none';
                        } else if (this.value === 'category') {
                            categorySelect.style.display = 'block';
                            productSelect.style.display = 'none';
                        } else {
                            productSelect.style.display = 'none';
                            categorySelect.style.display = 'none';
                        }
                    });
                });

                // const referralOfferbtn = document.getElementById('referralOfferbtn')
                // referralOfferbtn.addEventListener('click', function () {
                //     console.log('referralOfferbtn clicked');
                //     const addModal = new bootstrap.Modal(document.getElementById('referralModal'));
                //     addModal.show()
                // })

                // const refferalForm = document.getElementById('refferalForm')
                // refferalForm.addEventListener('submit', function (e) {
                //     e.preventDefault()
                //     console.log('refferalForm submited');
                //     const formData = new FormData(this)
                //     const formObject = Object.fromEntries(formData)
                //     console.log('formObject ', formObject);

                //     fetch('/admin/addrefferalOffer', {
                //         method: "POST",
                //         headers: { "Content-Type": "application/json" },
                //         body: JSON.stringify(formObject)
                //     }).then(res => res.json())
                //         .then(data => {
                //             if (data && data.success) {
                //                 Swal.fire(data.message)
                //                 addModal.hide();
                //             } else {
                //                 Swal.message
                //             }
                //         }).catch(error => {
                //             Swal.fire("Server Error")
                //         })
                // })

            </script>

</body>

</html>