<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Offer Management</title>
    <link rel="stylesheet" href="/css/offers.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <%- include('../partials/header.ejs') %>
        <div class="d-flex" id="wrapper">

            <div class="container">
                <!-- Sidebar -->
                <%- include('../partials/sidebar') %>

                    <!-- Main Content -->
                    <div class="main-content">
                        <!-- Header -->
                        <div class="page-title">
                            <h1>Offer Management Dashboard</h1>
                        </div>

                        <!-- Stats Section -->
                        <div class="stats">
                            <div class="stat-card">
                                <h3>Total Offers</h3>
                                <p>
                                    <%= stats.totalOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Active Offers</h3>
                                <p>
                                    <%= stats.activeOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Pending Approval</h3>
                                <p>
                                    <%= stats.pendingOffers %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <h3>Expired Offers</h3>
                                <p>
                                    <%= stats.expiredOffers %>
                                </p>
                            </div>
                        </div>

                        <!-- Offers Section -->
                        <div class="offers-section">
                            <div class="section-header">
                                <h2 class="section-title"></h2>
                                <button class="btn btn-primary" id="addOfferBtn"><i class="fas fa-plus"></i> Add New
                                    Offer</button>
                            </div>
                            <div class="section-header">
                                <h2 class="section-title"><a href="">All Offers</a></h2>
                                <h2><a href="/admin/referalOffers">Referral</a></h2>
                                <button class="btn btn-primary" id="referralOfferbtn" data-bs-toggle="modal"
                                    data-bs-target="#referralModal"><i class="fas fa-plus"></i>Add Referral
                                    Offer</button>
                            </div>
                            <div class="table-wrapper">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>ID</th>
                                            <th>Offer Name</th>
                                            <th>Offer On</th>
                                            <th>Discount</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% offers.forEach(function(offer,index) { %>
                                            <tr>
                                                <td>
                                                    <%= index+1 %>
                                                </td>
                                                <td>OFF<%= offer.id.slice(-4) %>
                                                </td>
                                                <td>
                                                    <%= offer.offerName %>
                                                </td>
                                                <td>
                                                    <%= offer.applicableTo %>
                                                </td>
                                                <td>
                                                    <%= offer.discountValue %>
                                                        <%= offer.discountType=='percentage' ? '%' :'₹' %>
                                                </td>
                                                <td>
                                                    <%= offer.startDate.toISOString().substring(0, 10) %>
                                                </td>
                                                <td>
                                                    <%= offer.endDate.toISOString().substring(0, 10) %> %>
                                                </td>
                                                <td>
                                                    <span class="status status-<%= offer.status.toLowerCase() %>">
                                                        <%= offer.status %>
                                                    </span>
                                                </td>
                                                <td class="action-cell">
                                                    <button data-id="<%= offer._id %>"
                                                        class="btn btn-warning action-btn edit-btn"><i
                                                            class="fas fa-edit"></i></button>
                                                    <button data-id="<%= offer._id %>"
                                                        class="btn btn-danger action-btn delete-btn"
                                                        <%=offer.status==='inactive' ? 'disabled' : '' %>>
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            </div>


        </div>
        <!--Pagination-->
        <nav>
            <ul class="pagination justify-content-center">
                <!-- Previous Button -->
                <% if (currentPage> 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
                    </li>
                    <% } else { %>
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Previous</a>
                        </li>
                        <% } %>

                            <!-- Page Numbers -->
                            <% for (let i=1; i <=totalPages; i++) { %>
                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>&limit=5">
                                        <%= i %>
                                    </a>
                                </li>
                                <% } %>

                                    <!-- Next Button -->
                                    <% if (currentPage < totalPages) { %>
                                        <li class="page-item">
                                            <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
                                        </li>
                                        <% } else { %>
                                            <li class="page-item disabled">
                                                <a class="page-link" href="#">Next</a>
                                            </li>
                                            <% } %>
            </ul>
        </nav>
        <%- include('../partials/footer.ejs') %>

            <!-- Add/Edit Offer Modal -->
            <div class="modal" id="offerModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 id="modalTitle">Add New Offer</h2>
                        <button class="close">&times;</button>
                    </div>

                    <div class="modal-body">
                        <form id="offerForm" method="POST" action="/admin/offers">
                            <!-- Offer Name -->
                            <div class="form-group">
                                <label for="offerName">Offer Name</label>
                                <input type="text" name="offerName" id="offerName" required>
                            </div>

                            <!-- Offer Description -->
                            <div class="form-group">
                                <label for="offerDesc">Description</label>
                                <textarea name="offerDesc" id="offerDesc"></textarea>
                            </div>


                            <!-- Discount Type -->
                            <div class="form-group">
                                <label for="discountType">Discount Type</label>
                                <select name="discountType" id="discountType" required>
                                    <option value="percentage">Percentage (%)</option>
                                    <option value="fixed">Fixed Amount</option>
                                </select>
                            </div>

                            <!-- Discount Value -->
                            <div class="form-group">
                                <label for="discountValue">Discount Value</label>
                                <input type="number" name="discountValue" id="discountValue" required>
                            </div>

                            <!-- Start Date -->
                            <div class="form-group">
                                <label for="startDate">Start Date</label>
                                <input type="date" name="startDate" id="startDate" required>
                            </div>

                            <!-- End Date -->
                            <div class="form-group">
                                <label for="endDate">End Date</label>
                                <input type="date" name="endDate" id="endDate" required>
                            </div>

                            <!-- Status -->
                            <div class="form-group">
                                <label for="status">Status</label>
                                <select name="status" id="status" required>
                                    <option value="active">Active</option>
                                    <option value="pending">Pending</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>

                            <!-- Offer On (Product or Category) -->
                            <div class="form-group">
                                <label for="offerOn">Offer On</label>
                                <select name="offerOn" id="offerOn" required>
                                    <option value="">-- Select --</option>
                                    <option value="product">Product</option>
                                    <option value="category">Category</option>
                                </select>
                            </div>

                            <!-- Select Product -->
                            <div class="form-group" id="productSelect" style="display: none;">
                                <label for="productId">Select Product</label>
                                <select name="productId" id="productId">
                                    <option value="">-- Select Product --</option>
                                    <% products.forEach(function(product) { %>
                                        <option value="<%= product._id %>">
                                            <%= product.productName %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <!-- Select Category -->
                            <div class="form-group" id="categorySelect" style="display: none;">
                                <label for="categoryId">Select Category</label>
                                <select name="categoryId" id="categoryId">
                                    <option value="">-- Select Category --</option>
                                    <% categories.forEach(function(category) { %>
                                        <option value="<%= category._id %>">
                                            <%= category.categoryName %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                        </form>
                    </div>
                    <input type="hidden" id="offerId" />
                    <div class="modal-footer">
                        <button class="btn btn-danger" id="cancelBtn" type="button">Cancel</button>
                        <button class="btn btn-success" id="saveOfferBtn" type="submit" form="offerForm">Save
                            Offer</button>
                    </div>
                </div>
            </div>

            <!-- Delete Confirmation Modal -->
            <div class="modal" id="deleteModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2>Confirm Delete</h2>
                        <button class="close">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this offer? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-warning" id="cancelDeleteBtn">Cancel</button>
                        <button class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>
            <!--add refferal offer modal-->
            <!-- Referral Offer Modal -->
            <div class="modal fade" id="referralModal" tabindex="-1" aria-labelledby="referralModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <form id="refferalForm" action="/admin/referral-offer" method="POST">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="referralModalLabel">Add Referral Offer</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="bonusAmount" class="form-label">Referral Bonus (₹)</label>
                                    <input type="number" class="form-control" name="bonusAmount" id="bonusAmount"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label for="minOrderAmount" class="form-label">Minimum Order Amount to Qualify
                                        (₹)</label>
                                    <input type="number" class="form-control" name="minOrderAmount" id="minOrderAmount"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label for="rewardType" class="form-label">Reward Type</label>
                                    <select class="form-select" name="rewardType" id="rewardType" required>
                                        <option value="wallet">Wallet Credit</option>
                                        <option value="discount">Discount Coupon</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="status" class="form-label">Referral Status</label>
                                    <select class="form-select" name="status" id="status" required>
                                        <option value="enabled">Enabled</option>
                                        <option value="disabled">Disabled</option>
                                    </select>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success">Save</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

            <script>
                // DOM Elements
                const addOfferBtn = document.getElementById('addOfferBtn');
                const offerModal = document.getElementById('offerModal');
                const deleteModal = document.getElementById('deleteModal');
                const modalTitle = document.getElementById('modalTitle');
                const closeButtons = document.querySelectorAll('.close');
                const cancelBtn = document.getElementById('cancelBtn');
                const saveOfferBtn = document.getElementById('saveOfferBtn');
                const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
                const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
                const editBtns = document.querySelectorAll('.edit-btn');
                const deleteBtns = document.querySelectorAll('.delete-btn');
                const offerForm = document.getElementById('offerForm');

                // Open add offer modal
                addOfferBtn.addEventListener('click', () => {
                    modalTitle.textContent = 'Add New Offer';
                    offerForm.reset();
                    offerForm.removeAttribute('data-edit-id');
                    document.getElementById("offerId").value = '';
                    offerModal.classList.add('active');
                });

                // Close modals
                closeButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        offerModal.classList.remove('active');
                        deleteModal.classList.remove('active');
                    });
                });

                // Cancel button in offer modal
                cancelBtn.addEventListener('click', () => {
                    offerModal.classList.remove('active');
                });

                // Save offer (handled on form submission)
                offerForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const offerId = document.getElementById("offerId").value;

                    const offerName = document.getElementById('offerName').value.trim();
                    const offerDescription = document.getElementById('offerDesc').value.trim();
                    const discountType = document.getElementById('discountType').value;
                    const discountValue = document.getElementById('discountValue').value;
                    const startDate = document.getElementById('startDate').value;
                    const endDate = document.getElementById('endDate').value;
                    const status = document.getElementById('status').value;
                    const offerOn = document.getElementById('offerOn').value;
                    const productId = document.getElementById('productId').value;
                    const categoryId = document.getElementById('categoryId').value;

                    if (!offerName || !offerDescription || !discountType || !discountValue || !startDate || !endDate || !status || !offerOn || (!productId && !categoryId)) {
                        Swal.fire("All fields are required");
                        return;
                    }

                    const formObject = {
                        offerName,
                        offerDiscription: offerDescription,
                        discountType,
                        discountValue,
                        startDate,
                        endDate,
                        status,
                        offerOn,
                        productId,
                        categoryId
                    };

                    const url = offerId ? `/admin/editOffer/${offerId}` : `/admin/addOffer`;
                    const method = offerId ? 'PUT' : 'POST';

                    fetch(url, {
                        method,
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(formObject)
                    }).then(res => res.json())
                        .then(data => {
                            Swal.fire(data.message);
                            if (data.success) {
                                offerModal.classList.remove('active');
                            }
                        }).catch(() => {
                            Swal.fire("Server error");
                        });
                });

                // Edit offer
                editBtns.forEach(button => {
                    button.addEventListener('click', () => {
                        offerModal.classList.add('active');
                        modalTitle.textContent = 'Edit Offer';
                        const offerId = button.dataset.id;
                        offerForm.setAttribute('data-edit-id', offerId);
                        document.getElementById("offerId").value = offerId;
                        console.log('edit button clicked');
                        console.log('offerId', offerId);



                        fetch(`/admin/getSingleOffer/${offerId}`, { method: "GET" })
                            .then(res => res.json())
                            .then(data => {
                                if (data && data.success) {
                                    const thisOffer = data.offer;
                                    document.getElementById('offerName').value = thisOffer.offerName;
                                    document.getElementById('offerDesc').value = thisOffer.description;
                                    document.getElementById('discountType').value = thisOffer.discountType;
                                    document.getElementById('discountValue').value = thisOffer.discountValue;
                                    document.getElementById('startDate').value = thisOffer.startDate?.split('T')[0];
                                    document.getElementById('endDate').value = thisOffer.endDate?.split('T')[0];
                                    document.getElementById('offerOn').value = thisOffer.applicableTo;
                                    document.getElementById('status').value = thisOffer.status;
                                } else {
                                    Swal.fire(data.message);
                                }
                            }).catch(() => {
                                Swal.fire("Server error");
                            });
                    });
                });

                // Delete offer
                let deleteOfferId;
                deleteBtns.forEach(button => {
                    button.addEventListener('click', () => {
                        deleteModal.classList.add('active');
                        deleteOfferId = button.getAttribute('data-id');
                        const row = button.closest('tr');

                        confirmDeleteBtn.onclick = () => {
                            fetch(`/admin/offer/delete/${deleteOfferId}`, { method: "DELETE" })
                                .then(res => res.json())
                                .then(data => {
                                    Swal.fire(data.message);
                                    if (data.success) {
                                        row.remove();
                                        deleteModal.classList.remove('active');
                                    }
                                }).catch(() => {
                                    Swal.fire("Server Error");
                                });
                        };
                    });
                });

                // Cancel delete
                cancelDeleteBtn.addEventListener('click', () => {
                    deleteModal.classList.remove('active');
                });

                // Helper to format date for input
                function formatDateForInput(dateStr) {
                    const parts = dateStr.split('/');
                    return `${parts[2]}-${parts[1]}-${parts[0]}`;
                }

                // Show/hide product/category selects
                document.addEventListener('DOMContentLoaded', function () {
                    const offerOn = document.getElementById('offerOn');
                    const productSelect = document.getElementById('productSelect');
                    const categorySelect = document.getElementById('categorySelect');

                    productSelect.style.display = 'none';
                    categorySelect.style.display = 'none';

                    offerOn.addEventListener('change', function () {
                        if (this.value === 'product') {
                            productSelect.style.display = 'block';
                            categorySelect.style.display = 'none';
                        } else if (this.value === 'category') {
                            categorySelect.style.display = 'block';
                            productSelect.style.display = 'none';
                        } else {
                            productSelect.style.display = 'none';
                            categorySelect.style.display = 'none';
                        }
                    });
                });

                const referralOfferbtn = document.getElementById('referralOfferbtn')
                referralOfferbtn.addEventListener('click', function () {
                    console.log('referralOfferbtn clicked');
                    const addModal = new bootstrap.Modal(document.getElementById('referralModal'));
                    addModal.show()
                })

                const refferalForm = document.getElementById('refferalForm')
                refferalForm.addEventListener('submit', function (e) {
                    e.preventDefault()
                    console.log('refferalForm submited');
                    const formData = new FormData(this)
                    const formObject = Object.fromEntries(formData)
                    console.log('formObject ', formObject);

                    fetch('/admin/addrefferalOffer', {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(formObject)
                    }).then(res => res.json())
                        .then(data => {
                            if (data && data.success) {
                                Swal.fire(data.message)
                                addModal.hide();
                            } else {
                                Swal.message
                            }
                        }).catch(error => {
                            Swal.fire("Server Error")
                        })
                })
            </script>

</body>

</html>