<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - User Management</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
  <body>
    <style>
      .container {
        margin-left: 0;
        margin-right: 0;
        margin-top: 0;
        padding: 0;
        max-width: 100%;
      }
      body {
        margin: 0;
        padding-top: 0;
      }
      .status-btn {
        border: none;
      }
    </style>
    <div class="container ">
      <%- include('../partials/header.ejs') %>

      <div class="d-flex" id="wrapper">
        <%- include('../partials/sidebar') %>

        <div class="container mt-4">
          <h2 class="text-center fw-bold mb-4">User Management</h2>

          <div class="card p-4 shadow">
            <h4>Registered Users</h4>
            <% if (successMessage.length > 0) { %>
            <div class="alert alert-success"><%= successMessage %></div>
            <% } %> <% if (errorMessage.length > 0) { %>
            <div class="alert alert-danger"><%= errorMessage %></div>
            <% } %>

            <table class="table table-striped mt-3">
              <thead class="table-dark">
                <tr>
                  <th>#</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach((user, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= user.userName %></td>
                  <td><%= user.email %></td>
                  <td><%= user.phone %></td>
                  <td><%= user.role %></td>
                  <td>
                    <% if (user.isActive) { %>
                    <span class="badge text-success bg-warning">Active</span>
                    <% } else { %>
                    <span class="badge text-danger bg-warning">Inactive</span>
                    <% } %>
                  </td>
                  <td>
                    <button
                      id="status-btn-<%= user._id %>"
                      onclick="toggleStatus('<%= user._id %>','<%= user.isActive ? true : false %>')"
                      class="btn btn-sm <%= user.isActive ? 'btn-danger' : 'btn-success' %>"
                    >
                      <%= user.isActive ? "Block" : "UnBlock" %>
                    </button>
                  
                   

                    
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
<!--Pagination-->

<nav>
  <ul class="pagination justify-content-center">
    <!-- Previous Button -->
    <% if (currentPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=5">Previous</a>
      </li>
    <% } else { %>
      <li class="page-item disabled">
        <a class="page-link" href="#" tabindex="-1">Previous</a>
      </li>
    <% } %>

    <!-- Page Numbers -->
    <% for (let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="?page=<%= i %>&limit=5"><%= i %></a>
      </li>
    <% } %>

    <!-- Next Button -->
    <% if (currentPage < totalPages) { %>
      <li class="page-item">
        <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=5">Next</a>
      </li>
    <% } else { %>
      <li class="page-item disabled">
        <a class="page-link" href="#">Next</a>
      </li>
    <% } %>
  </ul>
</nav>
      <%- include('../partials/footer.ejs') %>
    </div>
    <!-- edit modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
      <div class="modal-dialog">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                  <form id="editUserForm">
                      <input type="hidden" id="editUserId">
                      <div class="mb-3">
                          <label for="editUserName" class="form-label">Name</label>
                          <input type="text" name="userName" class="form-control" id="editUserName" required>
                      </div>
                      <div class="mb-3">
                          <label for="editUserEmail" class="form-label">Email</label>
                          <input name="email" type="email" class="form-control" id="editUserEmail" required>
                      </div>
                      <div class="mb-3">
                        <label for="editPhoneNumber" class="form-label">Phone</label>
                        <input type="text" name="phone" class="form-control" id="editPhoneNumber" required>
                    </div>
                      <button type="submit" class="btn btn-success">Save Changes</button>
                  </form>
              </div>
          </div>
      </div>
  </div> 

    <script>
      
      async function toggleStatus(userId, isActive) {
        console.log("Function triggered for user:", userId);

        try {
          // Convert isActive from string to boolean
          isActive = isActive === "true";
          console.log("Current Status:", isActive);
          const action = isActive ? "Block" : "Unblock";
          const newStatus = !isActive; // Toggle the value
          console.log("New Status:", newStatus);

          // Show confirmation alert before proceeding
          const result = await Swal.fire({
            title: `Are you sure?`,
            text: `Do you want to ${action} this user?`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: `Yes, ${action} it!`,
          });

          if (!result.isConfirmed) return; // If user cancels, stop execution

          // Make API call
          const response = await fetch(`/admin/block-user/${userId}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" ,
             
            },
            body: JSON.stringify({ isActive: newStatus }),
          });

          if (response.ok) {
            console.log("Status updated successfully!");

            // Update UI without reloading (Best Approach)
            const button = document.getElementById(`status-btn-${userId}`);
            if (button) {
              button.textContent = newStatus ? "Block" : "UnBlock";
              button.className = `btn btn-sm ${
                newStatus ? "btn-danger" : "btn-success"
              }`;
              button.setAttribute(
                "onclick",
                `toggleStatus('${userId}', '${newStatus}')`
              );
            }

            // Update status badge dynamically
            const statusBadge = button?.closest("tr")?.querySelector(".badge");
            if (statusBadge) {
              statusBadge.textContent = newStatus ? "Active" : "Inactive";
              statusBadge.className = `badge ${
                newStatus ? "text-success bg-warning" : "text-danger bg-warning"
              }`;
            }

            //  Show success message
            Swal.fire({
              title: "Success!",
              text: `User has been ${
                newStatus ? "activated" : "blocked"
              } successfully.`,
              icon: "success",
              timer: 2000,
              showConfirmButton: false,
            });
          }
        } catch (error) {
          console.log(error);
        }
      }

      // edit handling
      function editUser(userId,userName,email,phone){
        document.getElementById("editUserId").value = userId;
        document.getElementById('editUserName').value=userName
        document.getElementById('editUserEmail').value=email
        document.getElementById('editPhoneNumber').value=phone

          //show modal
        var myModal = new bootstrap.Modal(document.getElementById("editUserModal"));
        myModal.show();
      }
      //handle form submission

      document.getElementById('editUserForm').addEventListener('submit',async function(e){
        const userId=document.getElementById('editUserId').value
      const userName=document.getElementById('editUserName').value
      const email=document.getElementById('editUserEmail').value
      const phone=document.getElementById('editPhoneNumber').value

      try {
        const responce=await fetch(`/admin/users/edit/${userId}`,
          {method:"PATCH",
          headers:{"Content-Type": "application/json",
           
          },
          body: JSON.stringify({ userName, email,phone }),
          }
        )
        if (response.ok) {
                Swal.fire("Success!", "User details updated successfully!", "success");
                setTimeout(() => location.reload(), 2000);
            } else {
                throw new Error("Failed to update user.");
            }


      } catch (error) {
        console.error("Error updating user:", error);
            Swal.fire("Error!", "Something went wrong while updating user.", "error");
      }
      })
      
      
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
